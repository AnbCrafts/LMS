@model IEnumerable<WebApplication1.Models.StudentSubmission>

@{
    ViewBag.Title = "Student Assignment Submissions & Grading";
    int pendingCount = Model != null ? Model.Count(s => s.IsPending) : 0;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Instructor")">Instructor Studio</a></li>
                    <li class="breadcrumb-item active">Student Submissions & Grading</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Student Submissions & Grading</h2>
            <p class="text-muted small mb-0">Review student practical assignments, verify correctness, and assign final marks.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Instructor")" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Studio
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI / Notice Banner -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-warning-subtle text-warning fs-4">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@pendingCount</div>
                        <div class="text-muted small">Pending Verification</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-success-subtle text-success fs-4">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@(Model != null ? Model.Count(s => s.IsApproved) : 0)</div>
                        <div class="text-muted small">Approved & Graded</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary fs-4">
                        <i class="bi bi-clipboard-data-fill"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@(Model != null ? Model.Count() : 0)</div>
                        <div class="text-muted small">Total Submissions</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submissions Table Card -->
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-inbox-fill text-primary me-2"></i> Submitted Student Work
        </h5>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Course & Module</th>
                            <th>Task Title</th>
                            <th>Submitted Date</th>
                            <th>Marks</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@sub.StudentName</div>
                                    <div class="text-muted small">@sub.StudentEmail</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@sub.CourseTitle</div>
                                    <div class="text-muted small">
                                        @(sub.ModuleNumber.HasValue ? $"Module {sub.ModuleNumber}: {sub.ModuleTitle}" : "Final Capstone")
                                    </div>
                                </td>
                                <td>
                                    <span class="text-dark">@sub.SubmissionTitle</span>
                                </td>
                                <td class="text-muted small">
                                    @sub.SubmittedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td>
                                    @if (sub.IsPending)
                                    {
                                        <span class="badge bg-warning-subtle text-warning fw-semibold px-2 py-1">
                                            <i class="bi bi-hourglass me-1"></i> Marks Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success fw-bold fs-6">
                                            @sub.MarksObtained / @sub.MaxMarks
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (sub.Status == "Approved")
                                    {
                                        <span class="badge bg-success px-2 py-1">Approved</span>
                                    }
                                    else if (sub.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger px-2 py-1">Needs Revision</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Pending Review</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn @(sub.IsPending ? "btn-primary" : "btn-outline-secondary") btn-sm rounded-pill px-3" 
                                            onclick="openGradeModal(@sub.SubmissionId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(sub.StudentName))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(sub.CourseTitle))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(sub.SubmissionTitle ?? "Task"))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(sub.SubmissionText ?? ""))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(sub.SubmissionFileUrl ?? ""))', @(sub.MarksObtained.HasValue ? sub.MarksObtained.Value.ToString() : "90"), '@Html.Raw(HttpUtility.JavaScriptStringEncode(sub.InstructorFeedback ?? ""))', '@sub.Status')">
                                        <i class="bi @(sub.IsPending ? "bi-pencil-fill" : "bi-eye") me-1"></i>
                                        @(sub.IsPending ? "Review & Grade" : "Edit Grade")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-check fs-1 text-muted"></i>
                <h5 class="fw-bold text-dark mt-3">No submissions waiting for review</h5>
                <p class="text-muted small">When students complete module assignments in your courses, their submissions will appear here for grading.</p>
            </div>
        }
    </div>
</div>

<!-- Modal: Review & Grade Submission -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            @using (Html.BeginForm("GradeSubmission", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="SubmissionId" id="modalSubId" />

                <div class="modal-header border-0 pt-4 px-4 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1">
                            <i class="bi bi-patch-check-fill text-primary me-2"></i> Review Student Submission
                        </h5>
                        <p class="text-muted small mb-0" id="modalStudentCourseInfo"></p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Student Work Content Card -->
                    <div class="p-3 rounded-3 bg-light border mb-4">
                        <div class="fw-bold text-dark small mb-1" id="modalSubTitle"></div>
                        <div class="text-muted small mb-2" id="modalSubText" style="white-space: pre-wrap;"></div>
                        <div id="modalSubFileContainer" class="d-none mt-2 p-2 bg-white rounded border">
                            <span class="small fw-bold text-dark me-2">Attached Asset:</span>
                            <a href="#" target="_blank" id="modalSubFileLink" class="small text-decoration-none fw-bold"></a>
                        </div>
                    </div>

                    <!-- Grading Form Controls -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Marks Awarded (out of 100)</label>
                            <input type="number" name="MarksObtained" id="modalMarks" class="form-control" min="0" max="100" step="1" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Approval Status</label>
                            <select name="Status" id="modalStatus" class="form-select">
                                <option value="Approved">Approved & Passed</option>
                                <option value="Rejected">Rejected (Requires Revision)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold small">Instructor Feedback & Comments</label>
                        <textarea name="InstructorFeedback" id="modalFeedback" class="form-control" rows="4" placeholder="Great architecture and clean code separation. Suggest adding error handling for network timeouts..." required></textarea>
                        <div class="form-text" style="font-size: 0.75rem;">This feedback and awarded marks will be released directly to the student dashboard.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="lms-cta-btn">
                        <i class="bi bi-check-lg me-1"></i> Approve & Release Grade
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function openGradeModal(id, student, course, title, text, fileUrl, marks, feedback, status) {
        document.getElementById('modalSubId').value = id;
        document.getElementById('modalStudentCourseInfo').innerText = student + ' - ' + course;
        document.getElementById('modalSubTitle').innerText = title;
        document.getElementById('modalSubText').innerText = text || '(No written text submitted)';
        
        var fileContainer = document.getElementById('modalSubFileContainer');
        var fileLink = document.getElementById('modalSubFileLink');
        if (fileUrl && fileUrl.trim() !== '') {
            fileLink.href = fileUrl;
            var isDoc = fileUrl.indexOf('/Uploads/') >= 0 || fileUrl.endsWith('.pdf') || fileUrl.endsWith('.zip') || fileUrl.endsWith('.docx') || fileUrl.endsWith('.rar');
            if (isDoc) {
                fileLink.innerHTML = '<i class="bi bi-file-earmark-arrow-down-fill text-danger fs-6 me-1"></i> Download Solution File (' + fileUrl.split('/').pop() + ')';
                fileLink.setAttribute('download', '');
                fileLink.className = 'small text-danger text-decoration-none fw-bold';
            } else {
                fileLink.innerHTML = '<i class="bi bi-box-arrow-up-right text-primary me-1"></i> Open Repository / Demo: ' + fileUrl;
                fileLink.removeAttribute('download');
                fileLink.className = 'small text-primary text-decoration-none fw-bold';
            }
            fileContainer.classList.remove('d-none');
        } else {
            fileContainer.classList.add('d-none');
        }

        document.getElementById('modalMarks').value = marks;
        document.getElementById('modalFeedback').value = feedback || 'Well done! Clean implementation.';
        document.getElementById('modalStatus').value = (status === 'Rejected') ? 'Rejected' : 'Approved';

        var modal = new bootstrap.Modal(document.getElementById('gradeModal'));
        modal.show();
    }
</script>
