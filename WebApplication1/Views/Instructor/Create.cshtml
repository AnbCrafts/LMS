@model WebApplication1.Models.Course

@{
    ViewBag.Title = "Create New Course";
}

<a href="@Url.Action("Index", "Instructor")" class="lms-back-btn">
    <i class="bi bi-arrow-left"></i> Back to Studio
</a>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 20px; border: 1px solid #e2e8f0 !important;">
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill font-monospace" style="font-size: 0.72rem;">
                        <i class="bi bi-pencil me-1"></i> Draft Lifecycle
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-1">Create New Course</h2>
                <p class="text-muted small mb-0">Define course basics, category, and pricing. New courses are created in <strong>Draft Mode</strong> so you can build curriculum modules before publishing to students.</p>
            </div>

            <!-- Quality & Publishing Gate Policy Banner -->
            <div class="alert alert-light border border-info-subtle rounded-3 p-3 mb-4 d-flex align-items-start gap-3" style="background: #f0f9ff;">
                <i class="bi bi-info-circle-fill text-primary fs-5 mt-0.5"></i>
                <div class="small text-secondary">
                    <strong class="text-dark d-block mb-1">EduPulse Quality Assurance &amp; Publishing Policy</strong>
                    Courses start in <strong>Draft Mode</strong> and will NOT appear in the student catalog until published. To publish, a course must have <strong>at least one module with content</strong> (lesson notes, study materials, or video links).
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small rounded-3 mb-4">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            @using (Html.BeginForm("Create", "Instructor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold text-dark small" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Master React & Next.js", required = "required" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Category, new { @class = "form-label fw-semibold text-dark small" })
                        @{
                            var existingCats = ViewBag.ExistingCategories as List<string> ?? new List<string> { "Frontend", "Backend", "Fullstack", "DevOps" };
                        }
                        <input type="text" name="Category" value="@Model.Category" class="form-control" list="existingCategoriesList" placeholder="Select or type new category..." required autocomplete="off" />
                        <datalist id="existingCategoriesList">
                            @foreach (var cat in existingCats)
                            {
                                <option value="@cat" />
                            }
                        </datalist>
                        <div class="form-text" style="font-size: 0.72rem;">Choose an existing category from DB or type any new custom category.</div>
                        @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Price, new { @class = "form-label fw-semibold text-dark small" })
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted">$</span>
                            @Html.TextBoxFor(m => m.Price, new { @class = "form-control border-start-0", type = "number", step = "0.01", min = "0", placeholder = "49.99" })
                        </div>
                        <span class="text-muted small" style="font-size: 0.72rem;">Enter 0 for free course</span>
                        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Level, new { @class = "form-label fw-semibold text-dark small" })
                        @Html.DropDownListFor(m => m.Level, new SelectList(new[] { "Beginner", "Intermediate", "Advanced" }), new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Level, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.DurationWeeks, new { @class = "form-label fw-semibold text-dark small" })
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.DurationWeeks, new { @class = "form-control", type = "number", min = "1", max = "52" })
                            <span class="input-group-text bg-white text-muted">Weeks</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.DurationWeeks, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold text-dark small" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "5", placeholder = "Describe what students will learn, prerequisites, and key objectives...", required = "required" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                </div>

                <div class="form-check form-switch mb-4 p-3 bg-light rounded-3 border">
                    <input class="form-check-input ms-0 me-2" type="checkbox" id="publishImmediately" name="publishImmediately" value="true" />
                    <label class="form-check-label fw-semibold text-dark small" for="publishImmediately">
                        Attempt to publish immediately after creation
                    </label>
                    <div class="text-muted small ps-4" style="font-size: 0.74rem;">
                        Note: The course will only publish if at least one module with content already exists; otherwise it remains safely in Draft mode.
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index", "Instructor")" class="btn btn-light px-4 py-2 border rounded-3 fw-semibold">
                        Cancel
                    </a>
                    <button type="submit" class="lms-cta-btn px-4 py-2">
                        <i class="bi bi-arrow-right-circle-fill me-1"></i> Save as Draft &amp; Add Curriculum
                    </button>
                </div>
            }
        </div>
    </div>
</div>
