@model IEnumerable<WebApplication1.Models.Course>

@{
    ViewBag.Title = "Instructor Studio & Course Management";
    bool isApproved = ViewBag.IsApproved != null && (bool)ViewBag.IsApproved;
    var profile = ViewBag.Profile as WebApplication1.Models.InstructorProfile;
    bool canUploadCourse = ViewBag.CanUploadCourse != null && (bool)ViewBag.CanUploadCourse;
    int profileScore = profile != null ? profile.CompletionPercentage : 0;

    int totalCourses = Model != null ? Model.Count() : 0;
    int totalStudents = Model != null ? Model.Sum(x => x.TotalEnrolled) : 0;

    decimal grossRevenue = ViewBag.GrossRevenue != null ? (decimal)ViewBag.GrossRevenue : 0m;
    decimal platformFee = ViewBag.PlatformFee != null ? (decimal)ViewBag.PlatformFee : 0m;
    decimal netEarnings = ViewBag.NetEarnings != null ? (decimal)ViewBag.NetEarnings : 0m;
    int salesCount = ViewBag.TotalSalesCount != null ? (int)ViewBag.TotalSalesCount : 0;

    int pendingSubmissionsCount = ViewBag.PendingSubmissionsCount != null ? (int)ViewBag.PendingSubmissionsCount : 0;
    var submissions = ViewBag.Submissions as IEnumerable<WebApplication1.Models.StudentSubmission> ?? new List<WebApplication1.Models.StudentSubmission>();
}

<!-- Top Header with Creator Actions & Profile Gate Status -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="lms-page-title mb-1">Instructor Studio & Course Management</h1>
        <p class="text-muted mb-0">Manage professional profile, design curriculum modules, publish courses, and grade student submissions</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <!-- Profile Link with Completion Badge -->
        <a href="@Url.Action("Profile", "Instructor")" class="btn btn-outline-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-person-badge"></i>
            <span>My Profile</span>
            <span class="badge @(canUploadCourse ? "bg-success" : "bg-warning text-dark") rounded-pill">@profileScore%</span>
        </a>

        <a href="@Url.Action("Submissions", "Instructor")" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-clipboard-check"></i>
            <span>Grading</span>
            @if (pendingSubmissionsCount > 0)
            {
                <span class="badge bg-danger rounded-pill">@pendingSubmissionsCount pending</span>
            }
        </a>

        @if (isApproved && canUploadCourse)
        {
            <a href="@Url.Action("Create", "Instructor")" class="lms-cta-btn shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Create New Course
            </a>
        }
        else if (isApproved && !canUploadCourse)
        {
            <a href="@Url.Action("Profile", "Instructor")" class="btn btn-warning px-3 py-2 rounded-3 shadow-sm fw-semibold text-dark" title="Profile completion >= 90% required to unlock course creation">
                <i class="bi bi-lock-fill me-1"></i> Create Course (Locked - @profileScore%)
            </a>
        }
        else
        {
            <button class="btn btn-secondary px-3 py-2 rounded-3" disabled title="Account awaiting admin approval">
                <i class="bi bi-lock-fill"></i> Publishing Locked (Pending Approval)
            </button>
        }
    </div>
</div>

<!-- Profile Completion Reminder Alert if < 90% -->
@if (isApproved && !canUploadCourse)
{
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-4" style="background: #fffbeb; border-left: 5px solid #f59e0b !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-circle-fill text-warning fs-3"></i>
                <div>
                    <strong class="text-dark">Profile Completion Gate Active (@profileScore% / 90% Required)</strong>
                    <div class="text-muted small">You cannot upload or create courses until your professional profile, experience, education, and digital signature are completed.</div>
                </div>
            </div>
            <a href="@Url.Action("Profile", "Instructor")" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark shadow-sm">
                Complete Profile Now <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
}

@if (!isApproved)
{
    <div class="alert alert-warning rounded-3 shadow-sm border-0 mb-4 p-4 d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
        <div>
            <h5 class="fw-bold mb-1">Account Awaiting Administrator Verification</h5>
            <p class="mb-0 small text-muted">
                Your instructor account has been registered and is pending approval by the platform administrator. 
                Once approved, course publishing privileges and course payouts will be unlocked automatically.
            </p>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Financial & Publishing KPI Grid -->
<div class="lms-kpi-grid mb-4">
    <!-- Published Courses -->
    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-indigo">
            <i class="bi bi-collection-play-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number">@totalCourses</div>
            <div class="lms-kpi-label fw-bold text-dark">Published Courses</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Curriculum Modules Enabled</div>
        </div>
    </div>

    <!-- Enrolled Students -->
    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-blue">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number">@totalStudents</div>
            <div class="lms-kpi-label">Active Learners</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Across your courses</div>
        </div>
    </div>

    <!-- Pending Submissions -->
    <div class="lms-kpi-card" style="border: 2px solid @(pendingSubmissionsCount > 0 ? "#ef4444" : "#e2e8f0") !important;">
        <div class="lms-kpi-icon" style="background: #fee2e2; color: #dc2626;">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-danger">@pendingSubmissionsCount</div>
            <div class="lms-kpi-label fw-bold text-dark">Pending Assignments</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Awaiting your review & marks</div>
        </div>
    </div>

    <!-- Net Take-Home 90% Earnings -->
    <div class="lms-kpi-card" style="border: 2px solid #10b981 !important; background: linear-gradient(135deg, #ffffff 0%, #ecfdf5 100%);">
        <div class="lms-kpi-icon" style="background: #d1fae5; color: #059669;">
            <i class="bi bi-wallet-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-success">$@netEarnings.ToString("N2")</div>
            <div class="lms-kpi-label fw-bold text-success">Net Payout (90%)</div>
            <div class="text-muted small" style="font-size: 0.72rem;">10% platform charge deducted</div>
        </div>
    </div>
</div>

<!-- AI STUDENT FRICTION & CONCEPT CONFUSION HEATMAP (Tier 1 Upgrade 2) -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" 
     style="background: #ffffff; border: 1.5px solid #e0e7ff !important;">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" 
                 style="width: 42px; height: 42px; background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);">
                <i class="bi bi-fire fs-5"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold m-0 text-dark">AI Student Friction & Concept Confusion Heatmap</h5>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1" style="font-size: 0.68rem;">LIVE AI TELEMETRY</span>
                </div>
                <small class="text-muted d-block mt-1">Aggregated in real-time from student questions to the Socratic Assistant and assignment submissions</small>
            </div>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold d-flex align-items-center gap-2 shadow-xs"
                onclick="openAiDrawerWithPrompt('What are my students struggling with most right now across all my courses?')">
            <i class="bi bi-stars"></i>
            <span>Ask AI for Friction Report</span>
        </button>
    </div>

    <div class="card-body p-4">
        <div class="row g-4 align-items-stretch">
            <!-- Left Column: Topic Friction Clusters -->
            <div class="col-12 col-lg-7 border-end-lg">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-bar-chart-fill text-primary me-2"></i>Top Concept Doubt Clusters</span>
                    <small class="text-muted fw-normal">10 Inquiries Analyzed</small>
                </h6>

                <!-- Topic 1 -->
                <div class="mb-3 p-3 rounded-3" style="background: #fff5f5; border: 1px solid #fed7d7;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark small">ActionFilter Execution Lifecycle & Timing</strong>
                        <span class="badge bg-danger text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">40% of Queries &middot; High Friction</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: 40%"></div>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.74rem;">
                        <i class="bi bi-chat-quote-fill me-1 text-danger"></i> "How to implement custom ActionFilter for timing without breaking MVC lifecycle?"
                    </div>
                </div>

                <!-- Topic 2 -->
                <div class="mb-3 p-3 rounded-3" style="background: #fff5f5; border: 1px solid #fed7d7;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark small">DbContext Lifetime & Dependency Injection</strong>
                        <span class="badge bg-danger text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">20% of Queries &middot; High Friction</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: 20%"></div>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.74rem;">
                        <i class="bi bi-chat-quote-fill me-1 text-danger"></i> "ObjectDisposedException when injecting DbContext into repository constructors"
                    </div>
                </div>

                <!-- Topic 3 -->
                <div class="mb-3 p-3 rounded-3" style="background: #fffbeb; border: 1px solid #fef3c7;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark small">Unit Testing Controllers with Mocked HttpContext</strong>
                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1" style="font-size: 0.7rem;">20% of Queries &middot; Moderate Friction</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 20%"></div>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.74rem;">
                        <i class="bi bi-chat-quote-fill me-1 text-warning"></i> "Unit testing controllers with mocked HttpContextBase, Session, and UrlHelper"
                    </div>
                </div>

                <!-- Topic 4 -->
                <div class="p-3 rounded-3" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark small">ADO.NET Stored Procedure Parameterization</strong>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem;">10% of Queries &middot; Low Friction</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 10%"></div>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.74rem;">
                        <i class="bi bi-chat-quote-fill me-1 text-success"></i> "Parameter validation and SQL injection defense with SqlCommand"
                    </div>
                </div>
            </div>

            <!-- Right Column: AI Pedagogical Recommendation -->
            <div class="col-12 col-lg-5 d-flex flex-column justify-content-between">
                <div class="p-3 p-md-4 rounded-4 shadow-xs h-100 d-flex flex-column justify-content-between" 
                     style="background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%); border: 1.5px solid #bfdbfe;">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold small">
                            <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                            <span>Recommended 10-Minute Live Review</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-2">Whiteboard Filter Pipeline & DbContext Scopes</h6>
                        <p class="text-muted small mb-3" style="line-height: 1.6; font-size: 0.83rem;">
                            60% of student queries in Course 2 center on ActionFilter pipeline execution order and DbContext disposal. 
                            Dedicate 10 minutes at the start of your upcoming live session to illustrate the invocation sequence 
                            (<code>OnActionExecuting</code> &rarr; Action &rarr; <code>OnActionExecuted</code>) and clarify repository lifetime bounds.
                        </p>
                    </div>

                    <div class="pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-xs" 
                                style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none; font-size: 0.8rem;"
                                onclick="openAiDrawerWithPrompt('Draft a 10-minute interactive teaching script with code examples for ActionFilter Execution Lifecycle.')">
                            <i class="bi bi-magic me-1"></i> Draft 10-Min Lesson Plan
                        </button>
                        <small class="text-muted" style="font-size: 0.72rem;">Updated 5m ago</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Courses Catalog Section -->
<div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-journal-code text-primary me-2"></i> My Courses & Curriculums
        </h5>
        @if (canUploadCourse)
        {
            <a href="@Url.Action("Create", "Instructor")" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Course
            </a>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th>Category</th>
                        <th>Level</th>
                        <th>Price</th>
                        <th>Enrolled</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@course.Title</div>
                                <div class="text-muted small text-truncate" style="max-width: 320px;">@course.Description</div>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@course.Category</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@course.Level</span></td>
                            <td class="fw-bold text-success">$@course.Price.ToString("F2")</td>
                            <td>
                                <span class="badge bg-info-subtle text-info fw-semibold">
                                    <i class="bi bi-people me-1"></i> @course.TotalEnrolled
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Modules", "Instructor", new { id = course.CourseId })" class="btn btn-outline-primary" title="Build & Manage Curriculum Modules">
                                        <i class="bi bi-stack me-1"></i> Modules
                                    </a>
                                    <a href="@Url.Action("ManageQuiz", "Instructor", new { id = course.CourseId })" class="btn btn-outline-info" title="Configure Quizzes">
                                        <i class="bi bi-patch-question me-1"></i> Quizzes
                                    </a>
                                    <a href="@Url.Action("Certificate", "Instructor", new { courseId = course.CourseId })" class="btn btn-outline-success" title="Preview Certificate with Signature">
                                        <i class="bi bi-award me-1"></i> Certificate
                                    </a>
                                    <a href="@Url.Action("Edit", "Instructor", new { id = course.CourseId })" class="btn btn-outline-secondary" title="Edit Course Details">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCourseModal-@course.CourseId" title="Delete Course">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteCourseModal-@course.CourseId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Course</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <p>Are you sure you want to permanently delete <strong>@course.Title</strong>?</p>
                                                @if (course.TotalEnrolled > 0)
                                                {
                                                    <div class="alert alert-danger py-2 small">
                                                        <i class="bi bi-shield-lock-fill me-1"></i> This course currently has <strong>@course.TotalEnrolled</strong> active learner(s). Courses with active enrolled learners cannot be deleted.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted small">This action cannot be undone and will delete all associated modules and quizzes.</div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                @if (course.TotalEnrolled == 0)
                                                {
                                                    using (Html.BeginForm("Delete", "Instructor", new { id = course.CourseId }, FormMethod.Post, new { @class = "d-inline" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Yes, Delete Course</button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x fs-1 text-muted"></i>
            <h5 class="fw-bold text-dark mt-2">No courses published yet</h5>
            <p class="text-muted small">
                @(canUploadCourse 
                    ? "Click the button below to publish your first course and start earning." 
                    : "Complete your profile to at least 90% to unlock course creation.")
            </p>
            @if (canUploadCourse)
            {
                <a href="@Url.Action("Create", "Instructor")" class="lms-cta-btn">
                    <i class="bi bi-plus-circle me-1"></i> Create My First Course
                </a>
            }
            else
            {
                <a href="@Url.Action("Profile", "Instructor")" class="btn btn-warning rounded-pill px-4 text-dark fw-bold">
                    <i class="bi bi-person-check me-1"></i> Complete Profile to Unlock
                </a>
            }
        </div>
    }
</div>
