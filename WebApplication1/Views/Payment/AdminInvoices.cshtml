@model IEnumerable<WebApplication1.Models.InvoiceViewModel>

@{
    ViewBag.Title = "Platform Transactions & Invoices";
    int count = Model != null ? Model.Count() : 0;
    decimal totalVolume = Model != null ? Model.Sum(i => i.Amount) : 0m;
    decimal adminCommission = Math.Round(totalVolume * 0.10m, 2);
    decimal instructorPayouts = totalVolume - adminCommission;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="lms-page-title">Platform Transactions & Financial Ledger</h1>
        <p class="text-muted mb-0">Central ledger of all course payments, 10% platform charges, and 90% instructor settlements</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-shield-check me-1"></i> Admin Panel
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="lms-kpi-grid mb-4">
    <div class="lms-kpi-card" style="border: 2px solid #8b5cf6 !important; background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%);">
        <div class="lms-kpi-icon" style="background: #ede9fe; color: #7c3aed;">
            <i class="bi bi-pie-chart-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number" style="color: #6d28d9;">$@adminCommission.ToString("0.00")</div>
            <div class="lms-kpi-label fw-bold text-dark">Platform Charges (10% Cut)</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Admin Platform Revenue</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-emerald">
            <i class="bi bi-wallet2"></i>
        </div>
        <div>
            <div class="lms-kpi-number">$@totalVolume.ToString("0.00")</div>
            <div class="lms-kpi-label">Gross Platform Volume</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Total Buyer Purchases</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-indigo">
            <i class="bi bi-cash-stack"></i>
        </div>
        <div>
            <div class="lms-kpi-number">$@instructorPayouts.ToString("0.00")</div>
            <div class="lms-kpi-label">Instructor Payouts (90%)</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Disbursed to Course Sellers</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-blue">
            <i class="bi bi-file-earmark-check-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number">@count</div>
            <div class="lms-kpi-label">Total Invoices Issued</div>
            <div class="text-muted small" style="font-size: 0.72rem;">100% Settled</div>
        </div>
    </div>
</div>

<div class="lms-table-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark m-0">All System Invoices & Revenue Breakdown</h4>
        <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">@count Records</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="lms-modern-table">
                <thead>
                    <tr>
                        <th style="width: 15%;">Invoice #</th>
                        <th style="width: 22%;">Course Title</th>
                        <th style="width: 15%;">Student (Buyer)</th>
                        <th style="width: 15%;">Instructor (Seller)</th>
                        <th style="width: 10%;">Gross ($)</th>
                        <th style="width: 11%; color: #7c3aed;">10% Admin Fee</th>
                        <th style="width: 11%; color: #059669;">90% Payout</th>
                        <th style="width: 10%; text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-primary">@inv.InvoiceNumber</span>
                                <div class="text-muted small">@inv.PaymentDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@inv.CourseTitle</div>
                            </td>
                            <td>
                                <span class="text-dark small">@inv.StudentName</span>
                            </td>
                            <td>
                                <span class="text-dark small fw-medium">@inv.InstructorName</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 fw-bold">
                                    $@inv.Amount.ToString("0.00")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-purple px-2 py-1 fw-bold" style="background: #ede9fe; color: #7c3aed; border: 1px solid #ddd6fe;">
                                    +$@inv.PlatformFee.ToString("0.00")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 fw-bold">
                                    $@inv.InstructorShare.ToString("0.00")
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <a href="@Url.Action("Invoice", "Payment", new { id = inv.InvoiceNumber })" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-printer me-1"></i> PDF
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-receipt-cutoff fs-1 d-block mb-2"></i>
            <span>No transaction records currently registered on the platform.</span>
        </div>
    }
</div>
