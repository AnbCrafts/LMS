@model WebApplication1.Models.InvoiceViewModel

@{
    ViewBag.Title = "Invoice " + Model.InvoiceNumber;
}

<div class="invoice-container py-4">
    <!-- Top Action Toolbar (Hidden during print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 no-print">
        <a href="@Url.Action("Invoices", "Payment")" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> All Invoices
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
            </button>
            <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId })" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-play-circle-fill me-1"></i> Start Learning Now
            </a>
        </div>
    </div>

    <!-- Printable Invoice Sheet -->
    <div class="invoice-sheet shadow-lg mx-auto bg-white p-5 rounded-4 border">
        <!-- Invoice Header Row -->
        <div class="row align-items-start justify-content-between pb-4 border-bottom mb-4">
            <div class="col-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="lms-brand-icon" style="width: 40px; height: 40px; font-size: 1.3rem;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span class="fs-3 fw-bold text-dark">EduPulse Academy</span>
                </div>
                <div class="text-muted small">
                    EduPulse Learning Technologies Ltd.<br />
                    100 Innovation Parkway, Suite 400<br />
                    Bengaluru, Karnataka 560100 &middot; support@edupulse.org
                </div>
            </div>
            <div class="col-5 text-end">
                <div class="text-uppercase fw-bold text-muted small" style="letter-spacing: 1px;">Official Tax Invoice</div>
                <h3 class="fw-bold text-dark mb-1">@Model.InvoiceNumber</h3>
                <span class="badge bg-success text-white px-3 py-1 rounded-pill fw-bold text-uppercase">
                    <i class="bi bi-check-circle-fill me-1"></i> @Model.Status
                </span>
            </div>
        </div>

        <!-- Metadata Row (Billed To, Course Instructor, Dates) -->
        <div class="row g-4 mb-4 pb-4 border-bottom">
            <div class="col-12 col-md-4">
                <div class="text-muted small text-uppercase fw-bold mb-1">Billed To (Learner):</div>
                <h5 class="fw-bold text-dark mb-1">@Model.StudentName</h5>
                <div class="text-muted small">@Model.StudentEmail</div>
                <div class="text-muted small">User ID: #@Model.StudentId</div>
            </div>

            <div class="col-12 col-md-4">
                <div class="text-muted small text-uppercase fw-bold mb-1">Course Provider:</div>
                <h5 class="fw-bold text-dark mb-1">@Model.InstructorName</h5>
                <div class="text-muted small">Verified Lead Instructor</div>
                <div class="text-muted small">EduPulse Certified Partner</div>
            </div>

            <div class="col-12 col-md-4 text-md-end">
                <div class="text-muted small text-uppercase fw-bold mb-1">Payment Details:</div>
                <div class="small"><span class="text-muted">Date:</span> <strong>@Model.PaymentDate.ToString("MMMM dd, yyyy")</strong></div>
                <div class="small"><span class="text-muted">Method:</span> <strong>@Model.PaymentMethod</strong></div>
                <div class="small"><span class="text-muted">Txn Ref:</span> <code class="text-dark">@Model.TransactionId</code></div>
            </div>
        </div>

        <!-- Line Items Table -->
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50%;">Course Item & Curriculum</th>
                        <th style="width: 20%;">Category & Level</th>
                        <th style="width: 15%; text-align: center;">Duration</th>
                        <th style="width: 15%; text-align: right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@Model.CourseTitle</div>
                            <div class="text-muted small">Full lifetime access & verified certificate of achievement</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border me-1">@Model.Category</span>
                            <span class="badge bg-light text-muted border">@Model.Level</span>
                        </td>
                        <td class="text-center text-muted small">
                            @Model.DurationWeeks Weeks
                        </td>
                        <td class="text-end fw-bold text-dark">
                            $@Model.Amount.ToString("0.00")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Totals Calculation -->
        <div class="row justify-content-between align-items-center mb-4">
            <div class="col-12 col-md-6 mb-3 mb-md-0">
                @if (Session["UserRole"] as string == "Admin" || Session["UserRole"] as string == "Instructor")
                {
                    <div class="p-3 rounded-3 border bg-light small">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-pie-chart-fill text-primary me-1"></i> Platform Settlement Breakdown:</div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">10% Platform Charges (Admin):</span>
                            <span class="fw-bold" style="color: #7c3aed;">$@Model.PlatformFee.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">90% Net Instructor Payout:</span>
                            <span class="fw-bold text-success">+$@Model.InstructorShare.ToString("0.00")</span>
                        </div>
                    </div>
                }
            </div>
            <div class="col-12 col-md-5">
                <div class="p-3 bg-light rounded-3">
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Course Subtotal</span>
                        <span class="fw-bold text-dark">$@Model.Amount.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Taxes & Fees (Simulated)</span>
                        <span class="text-success fw-bold">$0.00</span>
                    </div>
                    <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark fs-5">Total Paid</span>
                        <span class="fw-bold text-primary fs-4">$@Model.Amount.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Confirmation Footer -->
        <div class="p-3 rounded-3 bg-light border text-center text-muted small">
            <i class="bi bi-shield-check text-success me-1"></i>
            This is an electronically generated and certified payment receipt. For invoice queries, please contact billing@edupulse.org.
        </div>
    </div>
</div>

<style>
    .invoice-sheet {
        max-width: 860px;
        min-height: 700px;
    }

    @@media print {
        body {
            background: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .no-print, header, footer, .lms-navbar {
            display: none !important;
        }
        .invoice-container {
            padding: 0 !important;
            margin: 0 !important;
        }
        .invoice-sheet {
            max-width: 100% !important;
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            page-break-inside: avoid;
        }
    }
</style>
