@model IEnumerable<WebApplication1.Models.InstructorProfile>

@{
    ViewBag.Title = "Instructor & Seller Verification Portal";
    string currentStatus = ViewBag.CurrentStatus as string ?? "Pending";

    int pendingCount = Model != null ? Model.Count(i => i.IsPendingReview) : 0;
    int actionCount = Model != null ? Model.Count(i => i.IsActionRequired) : 0;
    int approvedCount = Model != null ? Model.Count(i => i.IsApprovedStatus) : 0;
    int totalCount = Model != null ? Model.Count() : 0;
}

<!-- Top Header Navigation -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <a href="@Url.Action("Index", "Admin")" class="lms-back-btn mb-2">
            <i class="bi bi-arrow-left"></i> Back to Admin Dashboard
        </a>
        <h1 class="lms-page-title mb-1">Seller & Instructor Verification Center</h1>
        <p class="text-muted mb-0">Rigorously review instructor credentials, verify qualifications, inspect digital signatures, and provide actionable feedback.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-danger px-3 py-2 rounded-pill fs-6 d-flex align-items-center">
            <i class="bi bi-shield-lock-fill me-1"></i> Admin Accreditation
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards Overview -->
<div class="lms-kpi-grid mb-4">
    <div class="lms-kpi-card" style="border: 2px solid @(pendingCount > 0 ? "#f59e0b" : "#e2e8f0") !important;">
        <div class="lms-kpi-icon" style="background: #fef3c7; color: #d97706;">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-warning">@pendingCount</div>
            <div class="lms-kpi-label">Awaiting Verification</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Pending review queue</div>
        </div>
    </div>

    <div class="lms-kpi-card" style="border: 2px solid @(actionCount > 0 ? "#3b82f6" : "#e2e8f0") !important;">
        <div class="lms-kpi-icon" style="background: #eff6ff; color: #2563eb;">
            <i class="bi bi-chat-dots-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-primary">@actionCount</div>
            <div class="lms-kpi-label">Action Required</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Feedback sent to creator</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-emerald">
            <i class="bi bi-patch-check-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-success">@approvedCount</div>
            <div class="lms-kpi-label">Approved Instructors</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Verified course sellers</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-indigo">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number">@totalCount</div>
            <div class="lms-kpi-label">Total Instructor Accounts</div>
            <div class="text-muted small" style="font-size: 0.72rem;">All registered applicants</div>
        </div>
    </div>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-pills mb-4 gap-2" role="tablist">
    <li class="nav-item">
        <a href="@Url.Action("VerifySellers", "Admin", new { status = "Pending" })" 
           class="nav-link rounded-pill px-4 py-2 fw-semibold @(currentStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-hourglass-split me-1"></i> Awaiting Review (@pendingCount)
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("VerifySellers", "Admin", new { status = "Action Required" })" 
           class="nav-link rounded-pill px-4 py-2 fw-semibold @(currentStatus.Equals("Action Required", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-chat-left-text me-1"></i> Action Required (@actionCount)
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("VerifySellers", "Admin", new { status = "Approved" })" 
           class="nav-link rounded-pill px-4 py-2 fw-semibold @(currentStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-patch-check me-1"></i> Approved Sellers (@approvedCount)
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("VerifySellers", "Admin", new { status = "All" })" 
           class="nav-link rounded-pill px-4 py-2 fw-semibold @(currentStatus.Equals("All", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            <i class="bi bi-collection me-1"></i> All Applicants (@totalCount)
        </a>
    </li>
</ul>

<!-- Instructors Table Card -->
<div class="card border-0 shadow-sm p-4 rounded-4" style="background: #ffffff;">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="fw-bold text-dark m-0">
            <i class="bi bi-table text-primary me-2"></i> Registered Instructor Applications
        </h5>
        <div class="text-muted small">
            Click <strong>"Inspect & Verify"</strong> to review full qualifications and provide structured feedback.
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 24%;">Instructor</th>
                        <th style="width: 20%;">Professional Identity</th>
                        <th style="width: 14%;">Profile Score</th>
                        <th style="width: 15%;">Status</th>
                        <th style="width: 15%;">Latest Feedback</th>
                        <th style="width: 12%; text-align: right;">Accreditation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold overflow-hidden" 
                                         style="width: 40px; height: 40px; background: #3b82f6; font-size: 0.9rem;">
                                        @if (!string.IsNullOrWhiteSpace(inst.ProfilePictureUrl))
                                        {
                                            <img src="@Url.Content(inst.ProfilePictureUrl)" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(inst.FullName) ? "I" : inst.FullName.Substring(0, 1))</span>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@inst.FullName</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">@inst.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small text-truncate" style="max-width: 220px;" title="@inst.Headline">
                                    @(string.IsNullOrWhiteSpace(inst.Headline) ? "Profile Incomplete" : inst.Headline)
                                </div>
                                <div class="text-muted" style="font-size: 0.72rem;">
                                    @(string.IsNullOrWhiteSpace(inst.CurrentJobTitle) ? "No Title" : inst.CurrentJobTitle)
                                    @(!string.IsNullOrWhiteSpace(inst.CurrentOrganization) ? $" at {inst.CurrentOrganization}" : "")
                                </div>
                            </td>
                            <td>
                                <div>
                                    <div class="d-flex justify-content-between small fw-bold mb-1" style="font-size: 0.72rem;">
                                        <span>@inst.CompletionPercentage%</span>
                                        <span class="@(inst.CanUploadCourse ? "text-success" : "text-warning")">
                                            @(inst.CanUploadCourse ? ">= 90% Gate OK" : "Gate Incomplete")
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @(inst.CompletionPercentage >= 90 ? "bg-success" : (inst.CompletionPercentage >= 50 ? "bg-warning" : "bg-danger"))" 
                                             style="width: @inst.CompletionPercentage%;"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (inst.IsApprovedStatus)
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i> Approved
                                    </span>
                                }
                                else if (inst.IsActionRequired)
                                {
                                    <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">
                                        <i class="bi bi-chat-dots-fill me-1"></i> Action Required
                                    </span>
                                }
                                else if (inst.IsRejectedStatus)
                                {
                                    <span class="badge bg-danger-subtle text-danger fw-bold px-3 py-1 rounded-pill">
                                        <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning fw-bold px-3 py-1 rounded-pill">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending Review
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(inst.AdminFeedback))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 180px;" title="@inst.AdminFeedback">
                                        <i class="bi bi-chat-quote me-1 text-primary"></i> @inst.AdminFeedback
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">None yet</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <a href="@Url.Action("VerifyInstructor", "Admin", new { id = inst.UserId })" 
                                   class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-semibold">
                                    <i class="bi bi-search me-1"></i> Inspect & Verify
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-check2-circle text-success fs-1 mb-2 d-block"></i>
            <h5 class="fw-bold text-dark">No instructor applications matching "@currentStatus"</h5>
            <p class="text-muted small">All registered course sellers under this category have been processed.</p>
            <a href="@Url.Action("VerifySellers", "Admin", new { status = "All" })" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                View All Instructors
            </a>
        </div>
    }
</div>
