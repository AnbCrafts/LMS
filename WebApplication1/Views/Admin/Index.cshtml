                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Platform Currency Code</label>
                                <input type="text" name="CurrencyCode" class="ad-input w-100" value="USD ($)" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <button type="reset" class="ad-btn ad-btn-outline">Reset to Defaults</button>
                    <button type="submit" class="ad-btn ad-btn-primary px-4">
                        <i class="bi bi-check2-circle"></i> Save Configuration
                    </button>
                </div>
            </form>
        </div>
    }
</div>
