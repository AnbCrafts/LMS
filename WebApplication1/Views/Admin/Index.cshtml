                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-cpu me-1"></i> AI Assistant Governance Controls</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Primary RAG Model</label>
                                <select name="PrimaryGeminiModel" class="ad-input w-100">
                                    <option value="gemini-1.5-flash" selected>Gemini 1.5 Flash (Fast, Cost-Effective)</option>
                                    <option value="gemini-1.5-pro">Gemini 1.5 Pro (Deep Reasoning)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Temperature (Strictness: 0.0 - 1.0)</label>
                                <input type="number" name="ModelTemperature" class="ad-input w-100" value="0.2" step="0.1" min="0.0" max="1.0" />
                                <div class="text-muted small mt-1">Lower values ensure grounded, non-hallucinatory academic assistance.</div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="StrictAcademicSafetyShield" value="true" checked id="strictShield" />
                                <label class="form-check-label small fw-semibold" for="strictShield">Enforce Strict Academic Safety Guardrails</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="PreventExamAnswersLeak" value="true" checked id="examShield" />
                                <label class="form-check-label small fw-semibold" for="examShield">Prevent AI from Leaking Quiz / Exam Answers</label>
                            </div>
                        </div>
                    </div>

                    <!-- Section C: Security & Authentication -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-lock me-1"></i> Security &amp; Session Policies</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Session Inactivity Timeout (Minutes)</label>
                                <input type="number" name="SessionTimeoutMinutes" class="ad-input w-100" value="60" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Max Failed Login Attempts</label>
                                <input type="number" name="MaxLoginAttemptsBeforeLock" class="ad-input w-100" value="5" />
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="RequireCsrfTokensOnAllMutations" value="true" checked id="csrfShield" />
                                <label class="form-check-label small fw-semibold" for="csrfShield">Enforce CSRF Anti-Forgery on All State Mutations</label>
                            </div>
                        </div>
                    </div>

                    <!-- Section D: Payment Gateway -->
                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-credit-card me-1"></i> Payment Gateway &amp; Currency</h6>
