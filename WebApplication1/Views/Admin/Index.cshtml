@model WebApplication1.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Operations Workspace";
    string activeTab = Model.ActiveTab ?? "dashboard";
}

<!-- Self-Contained High-Performance Enterprise SaaS Operations System -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* ==========================================================================
       EduPulse Platform Operations & Administration Design System
       Inspired by Linear, Datadog, Stripe Dashboard, Cloudflare & GitHub Admin
       ========================================================================== */

    :root {
        --ad-bg: #f8fafc;
        --ad-surface: #ffffff;
        --ad-border: #e2e8f0;
        --ad-border-dark: #1e293b;
        --ad-text: #0f172a;
        --ad-muted: #64748b;
        --ad-primary: #0f172a;
        --ad-blue: #2563eb;
        --ad-emerald: #10b981;
        --ad-amber: #f59e0b;
        --ad-rose: #ef4444;
        --ad-sky: #0284c7;
        --ad-violet: #7c3aed;
    }

    body {
        background-color: var(--ad-bg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        color: var(--ad-text);
        overflow-x: hidden;
    }

    .ad-page-wrapper {
        max-width: 1560px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
    }

    /* Sub-Header Operations Breadcrumb & Quick Switcher Bar */
    .ad-subbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
    }

    .ad-title-group h1 {
        font-size: 1.45rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .ad-title-group p {
        font-size: 0.825rem;
        color: var(--ad-muted);
        margin: 0.25rem 0 0 0;
    }

    /* Subbar Quick Actions */
    .ad-quick-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .ad-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 7px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .ad-btn-primary {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }

    .ad-btn-primary:hover {
        background: #1e293b;
        color: #ffffff;
    }

    .ad-btn-outline {
        background: #ffffff;
        color: #334155;
        border-color: #cbd5e1;
    }

    .ad-btn-outline:hover {
        background: #f1f5f9;
        color: #0f172a;
        border-color: #94a3b8;
    }

    .ad-btn-danger {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .ad-btn-danger:hover {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* Secondary Navigation Workspace Pill Tabs */
    .ad-pills-nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.35rem;
        margin-bottom: 1.75rem;
        overflow-x: auto;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        scrollbar-width: none;
    }

    .ad-pills-nav::-webkit-scrollbar {
        display: none;
    }

    .ad-pill-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        border-radius: 7px;
        text-decoration: none;
        transition: all 0.15s ease;
        white-space: nowrap;
    }

    .ad-pill-tab:hover {
        color: #0f172a;
        background: #f8fafc;
        text-decoration: none;
    }

    .ad-pill-tab.active {
        color: #0f172a;
        background: #f1f5f9;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }

    .ad-tab-counter {
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.1rem 0.4rem;
        border-radius: 999px;
        font-family: monospace;
    }

    /* 8 Metric KPI Overview Grid */
    .ad-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 0.85rem;
        margin-bottom: 1.75rem;
    }

    .ad-kpi-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.15rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .ad-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
    }

    .ad-kpi-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.45rem;
    }

    .ad-kpi-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
    }

    .ad-kpi-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }

    .ad-kpi-value {
        font-size: 1.45rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
        line-height: 1.15;
    }

    .ad-kpi-footer {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.7rem;
        color: #10b981;
        font-weight: 600;
        margin-top: 0.35rem;
    }

    /* Section Cards & Surfaces */
    .ad-surface {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        padding: 1.25rem;
        margin-bottom: 1.75rem;
    }

    .ad-surface-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.15rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid #f1f5f9;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .ad-surface-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }

    /* Priority Platform Activity Center */
    .ad-activity-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1rem;
    }

    .ad-activity-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.15s ease;
    }

    .ad-activity-card:hover {
        border-color: #cbd5e1;
    }

    .ad-activity-card.urgent {
        border-left: 4px solid #ef4444;
    }

    .ad-activity-card.warning {
        border-left: 4px solid #f59e0b;
    }

    .ad-activity-card.info {
        border-left: 4px solid #2563eb;
    }

    /* Operational Data Tables */
    .ad-table-wrapper {
        overflow-x: auto;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

    .ad-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.825rem;
    }

    .ad-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .ad-table td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        background: #ffffff;
    }

    .ad-table tr:last-child td {
        border-bottom: none;
    }

    .ad-table tr:hover td {
        background-color: #f8fafc;
    }

    /* Badges & Pills */
    .ad-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.55rem;
        font-size: 0.7rem;
        font-weight: 600;
        border-radius: 999px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
        white-space: nowrap;
    }

    .ad-badge-success {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .ad-badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .ad-badge-danger {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .ad-badge-info {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
    }

    /* Form Controls */
    .ad-input {
        height: 36px;
        padding: 0 0.75rem;
        font-size: 0.8rem;
        color: #0f172a;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .ad-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    /* Live Heatmap Mock Grid */
    .ad-heatmap {
        display: grid;
        grid-template-columns: repeat(24, 1fr);
        gap: 3px;
        margin-top: 0.5rem;
    }

    .ad-heatmap-cell {
        height: 22px;
        border-radius: 3px;
        background-color: #f1f5f9;
        transition: transform 0.1s ease;
    }

    .ad-heatmap-cell:hover {
        transform: scale(1.15);
    }

    .ad-cell-low { background-color: #bae6fd; }
    .ad-cell-med { background-color: #38bdf8; }
    .ad-cell-high { background-color: #0284c7; }
    .ad-cell-peak { background-color: #0369a1; }
</style>

<div class="ad-page-wrapper">
    <!-- Breadcrumb & Top Command Bar -->
    <div class="ad-subbar">
        <div class="ad-title-group">
            <h1>
                <i class="bi bi-shield-check text-primary"></i>
                <span>EduPulse Operations Command Center</span>
            </h1>
            <p>Unified platform governance, real-time activity oversight, AI safety guardrails, and financial settlements.</p>
        </div>

        <div class="ad-quick-actions">
            <button type="button" class="ad-btn ad-btn-outline" onclick="window.location.reload();">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Refresh Metrics</span>
            </button>
            <a href="@Url.Action("Index", "Admin", new { tab = "settings" })" class="ad-btn ad-btn-outline">
                <i class="bi bi-sliders"></i>
                <span>Settings</span>
            </a>
            <a href="@Url.Action("Index", "Admin", new { tab = "instructors" })" class="ad-btn ad-btn-primary">
                <i class="bi bi-person-check-fill"></i>
                <span>Pending Approvals (@Model.PendingInstructorApplications.Count)</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Secondary Navigation Workspace Pill Tabs -->
    <div class="ad-pills-nav" role="navigation" aria-label="Administrative Tabs">
        <a href="@Url.Action("Index", "Admin", new { tab = "dashboard" })" class="ad-pill-tab @(activeTab == "dashboard" ? "active" : "")">
            <i class="bi bi-grid-1x2"></i>
            <span>Dashboard</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "users" })" class="ad-pill-tab @(activeTab == "users" ? "active" : "")">
            <i class="bi bi-people"></i>
            <span>Users</span>
            <span class="ad-tab-counter bg-secondary bg-opacity-10 text-secondary">@Model.TotalUsers</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "instructors" })" class="ad-pill-tab @(activeTab == "instructors" ? "active" : "")">
            <i class="bi bi-person-workspace"></i>
            <span>Instructors</span>
            @if (Model.PendingInstructorApplications.Count > 0)
            {
                <span class="ad-tab-counter bg-warning text-dark">@Model.PendingInstructorApplications.Count</span>
            }
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "courses" })" class="ad-pill-tab @(activeTab == "courses" ? "active" : "")">
            <i class="bi bi-journal-bookmark"></i>
            <span>Courses</span>
            <span class="ad-tab-counter bg-secondary bg-opacity-10 text-secondary">@Model.PublishedCourses</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "assessments" })" class="ad-pill-tab @(activeTab == "assessments" ? "active" : "")">
            <i class="bi bi-check2-square"></i>
            <span>Assessments</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "analytics" })" class="ad-pill-tab @(activeTab == "analytics" ? "active" : "")">
            <i class="bi bi-graph-up-arrow"></i>
            <span>Analytics</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "ai-governance" })" class="ad-pill-tab @(activeTab == "ai-governance" ? "active" : "")">
            <i class="bi bi-cpu"></i>
            <span>AI Governance</span>
            <span class="ad-tab-counter bg-info bg-opacity-25 text-primary">Shield Active</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "finance" })" class="ad-pill-tab @(activeTab == "finance" ? "active" : "")">
            <i class="bi bi-cash-stack"></i>
            <span>Finance &amp; 10% Cut</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "reports" })" class="ad-pill-tab @(activeTab == "reports" ? "active" : "")">
            <i class="bi bi-flag"></i>
            <span>Reports &amp; Moderation</span>
            @if (Model.ActiveReports.Count > 0)
            {
                <span class="ad-tab-counter bg-danger text-light">@Model.ActiveReports.Count</span>
            }
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "support" })" class="ad-pill-tab @(activeTab == "support" ? "active" : "")">
            <i class="bi bi-headset"></i>
            <span>Support Helpdesk</span>
            @if (Model.UrgentSupportTickets.Count > 0)
            {
                <span class="ad-tab-counter bg-warning text-dark">@Model.UrgentSupportTickets.Count</span>
            }
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "certificates" })" class="ad-pill-tab @(activeTab == "certificates" ? "active" : "")">
            <i class="bi bi-award"></i>
            <span>Certificates</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "settings" })" class="ad-pill-tab @(activeTab == "settings" ? "active" : "")">
            <i class="bi bi-sliders"></i>
            <span>Platform Settings</span>
        </a>
    </div>

    <!-- ========================================================================
         TAB 1: ADMIN DASHBOARD COMMAND CENTER (Default)
         ======================================================================== -->
    @if (activeTab == "dashboard")
    {
        <!-- 1. Top Platform Overview 8 Metric Grid -->
        <div class="ad-kpi-grid">
            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Total Users</span>
                    <span class="ad-kpi-icon bg-blue bg-opacity-10 text-primary"><i class="bi bi-people-fill"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.TotalUsers.ToString("N0")</div>
                <div class="ad-kpi-footer"><i class="bi bi-arrow-up-right"></i> +14% this month</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Active Learners</span>
                    <span class="ad-kpi-icon bg-emerald bg-opacity-10 text-success"><i class="bi bi-mortarboard-fill"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.ActiveLearners.ToString("N0")</div>
                <div class="ad-kpi-footer text-success"><i class="bi bi-activity"></i> 74% weekly active</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Active Instructors</span>
                    <span class="ad-kpi-icon bg-violet bg-opacity-10 text-purple"><i class="bi bi-person-workspace"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.ActiveInstructors</div>
                <div class="ad-kpi-footer text-info"><i class="bi bi-shield-check"></i> 100% Pedigree Verified</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Published Courses</span>
                    <span class="ad-kpi-icon bg-sky bg-opacity-10 text-info"><i class="bi bi-collection-play-fill"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.PublishedCourses</div>
                <div class="ad-kpi-footer text-primary"><i class="bi bi-check-circle"></i> 4 Pending Moderation</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Daily Enrollments</span>
                    <span class="ad-kpi-icon bg-amber bg-opacity-10 text-warning"><i class="bi bi-lightning-charge-fill"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.DailyEnrollments</div>
                <div class="ad-kpi-footer"><i class="bi bi-arrow-up-right"></i> +8 today</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Certificates Issued</span>
                    <span class="ad-kpi-icon bg-emerald bg-opacity-10 text-success"><i class="bi bi-award-fill"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.CertificatesIssued</div>
                <div class="ad-kpi-footer text-muted font-monospace" style="font-size: 0.65rem;">SHA-256 Validated</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">AI Conversations</span>
                    <span class="ad-kpi-icon bg-info bg-opacity-10 text-primary"><i class="bi bi-chat-left-dots-fill"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.AiConversations.ToString("N0")</div>
                <div class="ad-kpi-footer text-primary"><i class="bi bi-shield-fill-check"></i> 99.4% Safety Rate</div>
            </div>

            <div class="ad-kpi-card">
                <div class="ad-kpi-header">
                    <span class="ad-kpi-label">Engagement Score</span>
                    <span class="ad-kpi-icon bg-success bg-opacity-10 text-success"><i class="bi bi-bullseye"></i></span>
                </div>
                <div class="ad-kpi-value">@Model.PlatformEngagementScore%</div>
                <div class="ad-kpi-footer text-success"><i class="bi bi-stars"></i> Top 5% SaaS Tier</div>
            </div>
        </div>

        <!-- 2. Priority Platform Activity Center (Primary Focus upon Login) -->
        <div class="ad-surface">
            <div class="ad-surface-header">
                <h2 class="ad-surface-title">
                    <i class="bi bi-exclamation-octagon-fill text-danger"></i>
                    <span>Platform Activity Center &bull; Operational Responsibilities</span>
                </h2>
                <span class="ad-badge ad-badge-danger">
                    @(Model.PendingInstructorApplications.Count + Model.CoursesPendingModeration.Count + Model.ActiveReports.Count + Model.UrgentSupportTickets.Count) Pending Critical Actions
                </span>
            </div>

            <div class="ad-activity-grid">
                <!-- Card A: Instructor Applications -->
                <div class="ad-activity-card warning">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ad-badge ad-badge-warning">Instructor Verification</span>
                            <span class="text-muted small font-monospace">@Model.PendingInstructorApplications.Count Pending</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Applications Awaiting Pedigree Audit</h6>
                        <p class="text-secondary small mb-3">
                            Candidates have submitted qualifications, portfolios, and proposed syllabi awaiting review.
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-muted small">Target SLA: Under 24h</span>
                        <a href="@Url.Action("Index", "Admin", new { tab = "instructors" })" class="btn btn-sm btn-dark px-3 rounded-2">
                            Review Dossiers &rarr;
                        </a>
                    </div>
                </div>

                <!-- Card B: Course Moderation -->
                <div class="ad-activity-card info">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ad-badge ad-badge-info">Content Moderation</span>
                            <span class="text-muted small font-monospace">@Model.CoursesPendingModeration.Count In Queue</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">New Curriculum Submissions</h6>
                        <p class="text-secondary small mb-3">
                            Courses submitted by instructors requiring module audit, video check, and syllabus approval.
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-muted small">Quality Benchmark: 90%+</span>
                        <a href="@Url.Action("Index", "Admin", new { tab = "courses" })" class="btn btn-sm btn-dark px-3 rounded-2">
                            Moderate Courses &rarr;
                        </a>
                    </div>
                </div>

                <!-- Card C: Reports & Incident Case -->
                <div class="ad-activity-card urgent">
                    <div>
