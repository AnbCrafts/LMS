@model WebApplication1.Models.LoginViewModel

@{
    ViewBag.Title = "Sign In | EduPulse";
}

<!-- Self-Contained Resilient Styling for EduPulse Authentication Experience -->
<style>
    .ep-auth-page {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        color: #0f172a;
        background-color: #f8fafc;
        min-height: calc(100vh - 64px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
    }

    .ep-auth-shell {
        max-width: 1160px;
        width: 100%;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.02);
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        overflow: hidden;
    }

    /* Left Brand & Trust Panel */
    .ep-auth-left {
        background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        padding: 3.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
    }

    .ep-auth-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none !important;
        margin-bottom: 2.5rem;
    }

    .ep-auth-symbol {
        width: 32px;
        height: 32px;
        background-color: #ffffff;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
    }

    .ep-auth-brand-name {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #ffffff;
    }

    .ep-auth-headline {
        font-size: 2.1rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.25;
        color: #ffffff;
        margin-bottom: 1.25rem;
    }

    .ep-auth-subtext {
        font-size: 1rem;
        color: #94a3b8;
        line-height: 1.6;
        margin-bottom: 2.5rem;
    }

    /* Platform Preview Card inside Left Panel */
    .ep-auth-preview-box {
        background-color: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.5rem;
        backdrop-filter: blur(8px);
    }

    .ep-auth-preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 1rem;
        font-family: monospace;
    }

    .ep-auth-preview-course {
        font-size: 0.95rem;
        font-weight: 650;
        color: #f8fafc;
        margin-bottom: 0.5rem;
    }

    .ep-auth-progress-track {
        height: 6px;
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.75rem;
    }

    .ep-auth-progress-bar {
        height: 100%;
        width: 68%;
        background-color: #38bdf8;
        border-radius: 3px;
    }

    .ep-auth-preview-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.78rem;
        color: #94a3b8;
    }

    .ep-auth-badge {
        background-color: rgba(16, 185, 129, 0.15);
        color: #34d399;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.72rem;
    }

    /* Right Form Panel */
    .ep-auth-right {
        padding: 3.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: #ffffff;
    }

    .ep-form-header {
        margin-bottom: 2rem;
    }

    .ep-form-title {
        font-size: 1.75rem;
        font-weight: 750;
        letter-spacing: -0.025em;
        color: #0f172a;
        margin-bottom: 0.5rem;
    }

    .ep-form-subtitle {
        font-size: 0.925rem;
        color: #475569;
        margin: 0;
    }

    /* Form Inputs & Labels */
    .ep-form-group {
        margin-bottom: 1.25rem;
    }

    .ep-form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.4rem;
    }

    .ep-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .ep-input-icon {
        position: absolute;
        left: 12px;
        color: #94a3b8;
        font-size: 1rem;
        pointer-events: none;
    }

    .ep-form-control {
        width: 100%;
        font-size: 0.925rem;
        color: #0f172a;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.65rem 1rem 0.65rem 2.4rem;
        transition: all 0.15s ease;
    }

    .ep-form-control:focus {
        outline: none;
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
    }

    .ep-pw-toggle {
        position: absolute;
        right: 12px;
        background: transparent;
        border: none;
        color: #64748b;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        font-size: 1rem;
    }

    .ep-pw-toggle:hover {
        color: #0f172a;
    }

    .ep-field-error {
        font-size: 0.8rem;
        color: #dc2626;
        margin-top: 0.35rem;
        display: block;
    }

    .ep-form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
    }

    .ep-checkbox-label {
        color: #475569;
        cursor: pointer;
        user-select: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .ep-forgot-link {
        color: #475569 !important;
        text-decoration: none !important;
        font-weight: 500;
        transition: color 0.15s ease;
    }

    .ep-forgot-link:hover {
        color: #0f172a !important;
        text-decoration: underline !important;
    }

    /* Primary Submit Button */
    .ep-auth-btn {
        width: 100%;
        background-color: #0f172a;
        color: #ffffff !important;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        border: 1px solid #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        transition: all 0.15s ease;
    }

    .ep-auth-btn:hover {
        background-color: #1e293b;
        border-color: #1e293b;
    }

    .ep-auth-btn:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    /* Social Divider */
    .ep-auth-divider {
        display: flex;
        align-items: center;
        margin: 1.75rem 0;
        color: #94a3b8;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .ep-auth-divider::before,
    .ep-auth-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background-color: #e2e8f0;
    }

    .ep-auth-divider span {
        padding: 0 12px;
    }

    /* Social Buttons */
    .ep-social-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 2rem;
    }

    .ep-social-btn {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.6rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #334155;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none !important;
    }

    .ep-social-btn:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
    }

    /* Footer Links */
    .ep-auth-footer {
        padding-top: 1.5rem;
        border-top: 1px solid #f1f5f9;
        text-align: center;
        font-size: 0.875rem;
        color: #64748b;
    }

    .ep-auth-footer a {
        color: #0f172a !important;
        font-weight: 600;
        text-decoration: none !important;
    }

    .ep-auth-footer a:hover {
        text-decoration: underline !important;
    }

    .ep-instructor-status-link {
        display: block;
        margin-top: 0.75rem;
        font-size: 0.8rem;
        color: #64748b !important;
        text-decoration: none !important;
    }

    .ep-instructor-status-link:hover {
        color: #0f172a !important;
        text-decoration: underline !important;
    }

    /* Alert Styling */
    .ep-auth-alert {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    /* Responsive */
    @@media (max-width: 991.98px) {
        .ep-auth-shell {
            grid-template-columns: 1fr;
            max-width: 520px;
        }

        .ep-auth-left {
            padding: 2.5rem 2rem;
        }

        .ep-auth-headline {
            font-size: 1.75rem;
        }

        .ep-auth-right {
            padding: 2.5rem 2rem;
        }
    }

    @@media (max-width: 575.98px) {
        .ep-auth-page {
            padding: 1rem;
        }

        .ep-auth-left {
            padding: 2rem 1.5rem;
        }

        .ep-auth-right {
            padding: 2rem 1.5rem;
        }

        .ep-social-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ep-auth-page">
    <div class="ep-auth-shell">
        
        <!-- Left Panel: Brand Anchor, Value Proposition & Platform Preview -->
        <div class="ep-auth-left">
            <div>
                <a class="ep-auth-brand" href="@Url.Action("Index", "Home")" aria-label="EduPulse Home">
                    <span class="ep-auth-symbol">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="#0f172a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5 10.5V16C5 17.5 8 19.5 12 19.5C16 19.5 19 17.5 19 16V10.5" stroke="#0f172a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <span class="ep-auth-brand-name">EduPulse</span>
                </a>

                <h1 class="ep-auth-headline">
                    Transforming Engineering Education with Technical Rigor.
                </h1>
                <p class="ep-auth-subtext">
                    Join accredited software engineers, distributed systems architects, and educators on a platform built for sequential mastery and verified career credentials.
                </p>
            </div>

            <!-- Authentic Platform Preview Mockup (No Stock Photos) -->
            <div class="ep-auth-preview-box">
                <div class="ep-auth-preview-header">
                    <span>ACTIVE LEARNING WORKBENCH</span>
                    <span class="ep-auth-badge">In Progress</span>
                </div>
                <div class="ep-auth-preview-course">
                    Distributed Systems & Cloud Event Architecture
                </div>
                <div class="ep-auth-progress-track">
                    <div class="ep-auth-progress-bar"></div>
                </div>
                <div class="ep-auth-preview-footer">
                    <span><i class="bi bi-file-check me-1"></i> Module 04: Message Sagas</span>
                    <span class="text-white fw-bold">68%</span>
                </div>
            </div>
        </div>

        <!-- Right Panel: Authentication Form -->
        <div class="ep-auth-right">
            <div class="ep-form-header">
                <h2 class="ep-form-title">Sign in to your account</h2>
                <p class="ep-form-subtitle">Enter your verified credentials to access your curriculums.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 border-0">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="ep-auth-alert">
                    <i class="bi bi-exclamation-triangle-fill fs-6 mt-0"></i>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="ep-auth-alert">
                    <i class="bi bi-exclamation-circle-fill fs-6 mt-0"></i>
                    <div>
                        @Html.ValidationSummary(true, "", new { @class = "m-0 list-unstyled" })
                    </div>
                </div>
            }

            @using (Html.BeginForm("Login", "Account", new { returnUrl = Model?.ReturnUrl }, FormMethod.Post, new { id = "loginForm", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()

                <!-- Email Input -->
                <div class="ep-form-group">
                    <label class="ep-form-label" for="loginEmail">Email Address</label>
                    <div class="ep-input-wrapper">
                        <i class="bi bi-envelope ep-input-icon"></i>
                        @Html.TextBoxFor(m => m.Email, new { 
                            @class = "ep-form-control", 
                            id = "loginEmail", 
                            placeholder = "name@company.com", 
                            type = "email", 
                            required = "required",
                            autocomplete = "email"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "ep-field-error" })
                </div>

                <!-- Password Input with Reveal Toggle -->
                <div class="ep-form-group">
                    <label class="ep-form-label" for="loginPassword">Password</label>
                    <div class="ep-input-wrapper">
                        <i class="bi bi-lock ep-input-icon"></i>
                        @Html.PasswordFor(m => m.Password, new { 
                            @class = "ep-form-control", 
                            id = "loginPassword", 
                            placeholder = "Enter your password", 
                            required = "required",
                            autocomplete = "current-password"
                        })
                        <button type="button" class="ep-pw-toggle" onclick="togglePasswordVisibility('loginPassword', this)" aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "ep-field-error" })
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="ep-form-options">
                    <label class="ep-checkbox-label">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input mt-0" })
                        <span>Remember me for 30 days</span>
                    </label>
                    <a href="@Url.Action("Contact", "Home")" class="ep-forgot-link">Forgot password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="btnSignIn" class="ep-auth-btn">
                    <span id="btnText">Sign In</span>
                    <i class="bi bi-arrow-right" id="btnIcon"></i>
                </button>
            }

            <!-- Social Authentication Options -->
            <div class="ep-auth-divider">
                <span>Or authenticate with</span>
            </div>

            <div class="ep-social-grid">
                <button type="button" class="ep-social-btn" onclick="alert('SSO Authentication is configured through enterprise organization domain.')">
                    <i class="bi bi-github fs-6"></i>
                    <span>GitHub</span>
                </button>
                <button type="button" class="ep-social-btn" onclick="alert('Google Workspace Authentication is active for accredited enterprise accounts.')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                    </svg>
                    <span>Google</span>
                </button>
            </div>

            <!-- Account Creation Prompt -->
            <div class="ep-auth-footer">
                <div>
                    Don't have an EduPulse account? 
                    <a href="@Url.Action("Register", "Account")">Create Account</a>
                </div>
                <a href="@Url.Action("ApplicationStatus", "Instructor")" class="ep-instructor-status-link">
                    <i class="bi bi-patch-question me-1"></i> Applied as Instructor? Check Application Status & Admin Feedback
                </a>
            </div>

        </div>

    </div>
</div>

<!-- Password Visibility & Loading State Script -->
<script>
    function togglePasswordVisibility(fieldId, btn) {
        var input = document.getElementById(fieldId);
        if (!input) return;
        var icon = btn.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.className = "bi bi-eye-slash";
        } else {
            input.type = "password";
            icon.className = "bi bi-eye";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("loginForm");
        var btn = document.getElementById("btnSignIn");
        var btnText = document.getElementById("btnText");
        var btnIcon = document.getElementById("btnIcon");

        if (form && btn) {
            form.addEventListener("submit", function () {
                if (form.checkValidity()) {
                    btn.disabled = true;
                    btnText.innerText = "Signing in...";
                    if (btnIcon) {
                        btnIcon.className = "spinner-border spinner-border-sm ms-1";
                    }
                }
            });
        }
    });
</script>
