                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= rev.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                            </div>
                            <p class="ep-testimonial-text">"@rev.Comment"</p>
                            <div class="ep-testimonial-author">
                                <div class="ep-author-avatar">@initials</div>
                                <div>
                                    <div class="ep-author-name">@rev.StudentName</div>
                                    <div class="ep-author-course">Enrolled in @rev.CourseTitle</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ====================================================================
         9. COURSE PREVIEW SHOWCASE (Actual Platform Experience Gallery)
         ==================================================================== -->
    <section class="ep-section">
        <div class="ep-container">
            <div class="ep-section-header">
                <div class="ep-eyebrow">Inside The Platform</div>
                <h2 class="ep-section-title">A Focused, Ergonomic Learning Environment</h2>
                <p class="ep-section-subtitle">
                    Inspect the functional tools designed to eliminate distraction and maximize engineering focus.
                </p>
            </div>

            <div class="ep-showcase-grid">
                <div class="ep-showcase-item">
                    <div class="ep-showcase-icon"><i class="bi bi-window-sidebar"></i></div>
                    <h3 class="ep-showcase-title">Dual-Pane Active Classroom</h3>
                    <p class="ep-showcase-desc">
                        Watch high-bitrate technical lectures with alongside interactive PDF course slides and code manifests without switching tabs.
                    </p>
                    <div class="ep-showcase-preview-box">
                        <i class="bi bi-check2 text-success me-2"></i> Synchronized progress saving &bull; Timestamped lecture notes &bull; Dark mode player
                    </div>
                </div>

                <div class="ep-showcase-item">
                    <div class="ep-showcase-icon"><i class="bi bi-ui-checks"></i></div>
                    <h3 class="ep-showcase-title">Interactive Assessment Engine</h3>
                    <p class="ep-showcase-desc">
                        Test conceptual comprehension with rigorous multiple-choice quizzes that provide immediate diagnostic feedback and retake control.
                    </p>
                    <div class="ep-showcase-preview-box">
                        <i class="bi bi-check2 text-success me-2"></i> Auto-scoring &bull; Criterion explanation &bull; Verified gradebook integration
                    </div>
                </div>

                <div class="ep-showcase-item">
                    <div class="ep-showcase-icon"><i class="bi bi-award-fill"></i></div>
                    <h3 class="ep-showcase-title">Cryptographically Verifiable Certificates</h3>
                    <p class="ep-showcase-desc">
                        Each completion certificate features an official cryptographic verification number, graduation timestamp, and instructor signature.
                    </p>
                    <div class="ep-showcase-preview-box">
                        <i class="bi bi-check2 text-success me-2"></i> High-resolution PDF export &bull; Permanent public URL verification &bull; Tamper-proof
                    </div>
                </div>

                <div class="ep-showcase-item">
                    <div class="ep-showcase-icon"><i class="bi bi-file-earmark-diff"></i></div>
                    <h3 class="ep-showcase-title">Instructor Evaluation Backlog</h3>
                    <p class="ep-showcase-desc">
                        Instructors evaluate assignment repositories and text submissions using structured rubric criteria and constructive line feedback.
                    </p>
                    <div class="ep-showcase-preview-box">
                        <i class="bi bi-check2 text-success me-2"></i> Split-screen submission inspector &bull; 0-100 numerical marking &bull; One-click approvals
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================================================================
         10. FINAL CALL TO ACTION (Conversion Section)
         ==================================================================== -->
    <section class="ep-cta-section">
        <div class="ep-container">
            <div class="ep-cta-card">
                <div class="ep-eyebrow">Start Today</div>
                <h2 class="ep-cta-title">Begin Your Educational Journey with EduPulse</h2>
                <p class="ep-cta-desc">
                    Join ambitious software engineers, technical architects, and accredited educators advancing their careers through structured, rigorous curriculums.
                </p>
                <div class="ep-cta-actions">
                    @if (isLoggedIn)
                    {
                        <a href="@Url.Action("Index", "Dashboard")" class="ep-btn-lg-primary">
                            Go to My Learning Dashboard <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Register", "Account")" class="ep-btn-lg-primary">
                            Create Free Account <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="@Url.Action("Index", "Courses")" class="ep-btn-lg-secondary">
                            Explore All Courses
                        </a>
                    }
                </div>
                <div class="ep-cta-guarantee">
                    <i class="bi bi-lock-fill me-1"></i> Immediate access &bull; Free preview lessons available &bull; No credit card required for registration
                </div>
            </div>
        </div>
    </section>

