        <a href="@Url.Action("Index", "Admin", new { tab = "assessments" })" class="ad-drawer-link @(isAssessments ? "active" : "")">
            <span>Assessments &amp; Rubrics</span>
        </a>

        <div class="px-2 mt-3 mb-2 text-secondary small fw-bold text-uppercase" style="font-size: 0.65rem;">Intelligence &amp; Finance</div>

        <a href="@Url.Action("Index", "Admin", new { tab = "analytics" })" class="ad-drawer-link @(isAnalytics ? "active" : "")">
            <span>Analytics &amp; BI</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "ai-governance" })" class="ad-drawer-link @(isAiGov ? "active" : "")">
            <span>AI Governance</span>
            <span class="badge bg-info text-dark font-monospace ms-auto">Active</span>
        </a>

        <a href="@Url.Action("Index", "Admin", new { tab = "finance" })" class="ad-drawer-link @(isFinance ? "active" : "")">
            <span>Finance &amp; 10% Cut</span>
        </a>

        <div class="px-2 mt-3 mb-2 text-secondary small fw-bold text-uppercase" style="font-size: 0.65rem;">Trust, Safety &amp; Care</div>

        <a href="@Url.Action("Index", "Admin", new { tab = "reports" })" class="ad-drawer-link @(isReports ? "active" : "")">
            <span>Reports &amp; Incidents</span>
            @if (vm.FlaggedReportsCount > 0)
            {
                <span class="badge bg-danger text-light font-monospace ms-auto">@vm.FlaggedReportsCount</span>
            }
