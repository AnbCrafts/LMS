        <form action="@Url.Action("Logout", "Account")" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="w-100 btn btn-sm btn-danger d-flex align-items-center justify-content-center gap-2 rounded-2">
                <span>Sign Out Root Admin</span>
            </button>
        </form>
    </div>
</div>

<!-- Admin Header Interactive Scripts -->
<script>
    (function () {
        // Nav Category Dropdowns
        document.querySelectorAll('.ad-nav-dropdown-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var menu = btn.nextElementSibling;
                var isOpen = menu ? menu.classList.contains('show') : false;

                // Close all other dropdowns
                document.querySelectorAll('.ad-nav-menu, .ad-alerts-panel, .ad-profile-dropdown, .ad-search-dropdown').forEach(function (m) {
                    if (m !== menu) m.classList.remove('show');
                });
                document.querySelectorAll('.ad-nav-dropdown-btn').forEach(function (b) {
                    if (b !== btn) b.setAttribute('aria-expanded', 'false');
                });

                if (menu) {
                    if (!isOpen) {
                        menu.classList.add('show');
                        btn.setAttribute('aria-expanded', 'true');
                    } else {
                        menu.classList.remove('show');
                        btn.setAttribute('aria-expanded', 'false');
                    }
                }
            });
        });

        function setupDropdown(btnId, panelId) {
            var btn = document.getElementById(btnId);
            var panel = document.getElementById(panelId);
            if (!btn || !panel) return;

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                document.querySelectorAll('.ad-nav-menu, .ad-alerts-panel, .ad-profile-dropdown, .ad-search-dropdown').forEach(function (d) {
                    if (d !== panel) d.classList.remove('show');
                });
                document.querySelectorAll('.ad-nav-dropdown-btn').forEach(function (b) {
                    b.setAttribute('aria-expanded', 'false');
                });
                panel.classList.toggle('show');
            });
        }

        setupDropdown('epAdminAlertsToggle', 'epAdminAlertsPanel');
        setupDropdown('epAdminProfileToggle', 'epAdminProfileDropdown');

        document.addEventListener('click', function (e) {
            document.querySelectorAll('.ad-nav-menu, .ad-alerts-panel, .ad-profile-dropdown, .ad-search-dropdown').forEach(function (d) {
                if (!d.contains(e.target)) d.classList.remove('show');
            });
            document.querySelectorAll('.ad-nav-dropdown-btn').forEach(function (btn) {
                btn.setAttribute('aria-expanded', 'false');
            });
        });

        // Search Autocomplete functionality
        var searchInput = document.getElementById('epAdminSearchInput');
        var searchDropdown = document.getElementById('epAdminSearchDropdown');

        if (searchInput && searchDropdown) {
            searchInput.addEventListener('focus', function () {
                searchDropdown.classList.add('show');
            });

            searchInput.addEventListener('input', function () {
                var query = (searchInput.value || '').trim().toLowerCase();
                searchDropdown.classList.add('show');

                var items = searchDropdown.querySelectorAll('.ad-search-item');
                items.forEach(function (item) {
                    var title = item.getAttribute('data-title') || '';
                    var cat = item.getAttribute('data-category') || '';
                    var sub = item.getAttribute('data-sub') || '';
                    if (!query || title.indexOf(query) !== -1 || cat.indexOf(query) !== -1 || sub.indexOf(query) !== -1) {
                        item.style.setProperty('display', 'flex', 'important');
                    } else {
                        item.style.setProperty('display', 'none', 'important');
                    }
                });
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                    searchDropdown.classList.add('show');
                }
                if (e.key === 'Escape') {
                    searchDropdown.classList.remove('show');
                    document.querySelectorAll('.ad-nav-menu, .ad-alerts-panel, .ad-profile-dropdown').forEach(function (d) {
                        d.classList.remove('show');
                    });
                    document.querySelectorAll('.ad-nav-dropdown-btn').forEach(function (btn) {
                        btn.setAttribute('aria-expanded', 'false');
                    });
                }
            });
        }

        // Drawer
        var drawerOpenBtn = document.getElementById('epAdminDrawerOpen');
        var drawerCloseBtn = document.getElementById('epAdminDrawerClose');
        var drawer = document.getElementById('epAdminDrawer');
        var backdrop = document.getElementById('epAdminDrawerBackdrop');

        function openDrawer() {
            if (drawer && backdrop) {
                drawer.classList.add('open');
                backdrop.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeDrawer() {
            if (drawer && backdrop) {
                drawer.classList.remove('open');
                backdrop.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        if (drawerOpenBtn) drawerOpenBtn.addEventListener('click', openDrawer);
        if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);
        if (backdrop) backdrop.addEventListener('click', closeDrawer);
    })();
</script>
