@using WebApplication1.Models
@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    var vm = AdminNavbarViewModel.LoadForUser(currentUser);

    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    string currentTab = Request.QueryString["tab"] ?? "";

    bool isDashboard = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase) && (string.IsNullOrEmpty(currentTab) || string.Equals(currentTab, "dashboard", StringComparison.OrdinalIgnoreCase));
    bool isUsers = string.Equals(currentTab, "users", StringComparison.OrdinalIgnoreCase);
    bool isInstructors = string.Equals(currentTab, "instructors", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAction, "VerifySellers", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAction, "VerifyInstructor", StringComparison.OrdinalIgnoreCase);
    bool isCourses = string.Equals(currentTab, "courses", StringComparison.OrdinalIgnoreCase);
    bool isAssessments = string.Equals(currentTab, "assessments", StringComparison.OrdinalIgnoreCase);
    bool isAnalytics = string.Equals(currentTab, "analytics", StringComparison.OrdinalIgnoreCase);
    bool isAiGov = string.Equals(currentTab, "ai-governance", StringComparison.OrdinalIgnoreCase);
    bool isFinance = string.Equals(currentTab, "finance", StringComparison.OrdinalIgnoreCase);
    bool isReports = string.Equals(currentTab, "reports", StringComparison.OrdinalIgnoreCase);
    bool isSupport = string.Equals(currentTab, "support", StringComparison.OrdinalIgnoreCase);
    bool isCertificates = string.Equals(currentTab, "certificates", StringComparison.OrdinalIgnoreCase);
    bool isSettings = string.Equals(currentTab, "settings", StringComparison.OrdinalIgnoreCase);

    bool isEntitiesActive = isUsers || isInstructors || isCertificates;
    bool isCurriculumActive = isCourses || isAssessments;
    bool isIntelligenceActive = isAnalytics || isAiGov || isFinance;
    bool isSupportActive = isReports || isSupport;
}

<!-- Self-Contained Resilient Design System for EduPulse Admin Operations Workspace Header -->
<style>
    /* ==========================================================================
       EduPulse Admin Operations Workspace Header
       Enterprise SaaS Architecture (Datadog, Cloudflare, Linear, Stripe Dashboard)
       ========================================================================== */

    .ad-header-wrapper {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        background-color: #0f172a;
        border-bottom: 1px solid #1e293b;
        z-index: 1050;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .ad-container {
        height: 60px;
        max-width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.25rem;
        gap: 0.65rem;
    }

    /* Left: Brand & Operations Badge */
    .ad-left {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-shrink: 0;
    }

    .ad-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        transition: opacity 0.15s ease;
    }

    .ad-brand:hover {
        opacity: 0.9;
        color: #ffffff;
        text-decoration: none;
    }

    .ad-brand-mark {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.35);
        color: #ffffff;
    }

    .ad-ops-badge {
        font-size: 0.625rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        margin-left: 0.1rem;
    }

    /* Primary Navigation Bar (Categorized Enterprise Architecture) */
    .ad-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        overflow: visible;
    }

    .ad-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.65rem;
        font-size: 0.8rem;
        font-weight: 500;
        color: #94a3b8;
        text-decoration: none;
        border-radius: 6px;
        transition: color 0.15s ease, background-color 0.15s ease;
        white-space: nowrap;
        position: relative;
    }

    .ad-nav-link:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.06);
        text-decoration: none;
    }

    .ad-nav-link.active {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.1);
        font-weight: 600;
    }

    .ad-nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -11px;
        left: 8px;
        right: 8px;
        height: 2px;
        background-color: #38bdf8;
        border-radius: 2px;
    }

    /* Categorized Dropdown System */
    .ad-nav-dropdown {
        position: relative;
    }

    .ad-nav-dropdown-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.65rem;
        font-size: 0.8rem;
        font-weight: 500;
        color: #94a3b8;
        background: transparent;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: color 0.15s ease, background-color 0.15s ease;
        white-space: nowrap;
        position: relative;
    }

    .ad-nav-dropdown-btn:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.06);
    }

    .ad-nav-dropdown-btn.active {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.1);
        font-weight: 600;
    }

    .ad-nav-dropdown-btn.active::after {
        content: '';
        position: absolute;
        bottom: -11px;
        left: 8px;
        right: 8px;
        height: 2px;
        background-color: #38bdf8;
        border-radius: 2px;
    }

    .ad-chevron {
        transition: transform 0.2s ease;
        opacity: 0.7;
    }

    .ad-nav-dropdown-btn[aria-expanded="true"] .ad-chevron {
        transform: rotate(180deg);
        opacity: 1;
    }

    .ad-nav-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        min-width: 285px;
        background-color: #0b1120;
        border: 1px solid #1e293b;
        border-radius: 10px;
        box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.06);
        padding: 0.45rem;
        display: none;
        z-index: 1060;
    }

    .ad-nav-menu.show {
        display: block;
        animation: adFadeIn 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes adFadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .ad-nav-menu-header {
        padding: 0.45rem 0.65rem 0.35rem;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #64748b;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        margin-bottom: 0.35rem;
    }

    .ad-nav-menu-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 0.65rem;
        border-radius: 6px;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        transition: background-color 0.12s ease, color 0.12s ease;
    }

    .ad-nav-menu-item:hover {
        background-color: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        text-decoration: none;
    }

    .ad-nav-menu-item.active {
        background-color: rgba(56, 189, 248, 0.12);
        color: #38bdf8;
        font-weight: 600;
    }

    .ad-menu-icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #94a3b8;
        transition: all 0.15s ease;
    }

    .ad-nav-menu-item:hover .ad-menu-icon,
    .ad-nav-menu-item.active .ad-menu-icon {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
    }

    .ad-menu-content {
        flex: 1 1 auto;
        min-width: 0;
    }

    .ad-menu-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: #f1f5f9;
        line-height: 1.2;
    }

    .ad-nav-menu-item.active .ad-menu-title {
        color: #38bdf8;
    }

    .ad-menu-desc {
        font-size: 0.68rem;
        color: #64748b;
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ad-nav-badge {
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.1rem 0.35rem;
        border-radius: 999px;
        line-height: 1;
        font-family: monospace;
    }

    /* Center: Global Search */
    .ad-center {
        display: flex;
        align-items: center;
        flex: 0 1 280px;
        max-width: 300px;
        min-width: 140px;
        position: relative;
    }

    .ad-search-box {
        position: relative;
        width: 100%;
    }

    .ad-search-input {
        width: 100%;
        height: 34px;
        padding: 0 3.2rem 0 2rem;
        font-size: 0.78rem;
        color: #ffffff;
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 7px;
        outline: none;
        transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .ad-search-input::placeholder {
        color: #64748b;
    }

    .ad-search-input:focus {
        background-color: #0f172a;
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
    }

    .ad-search-icon {
        position: absolute;
        left: 0.65rem;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        pointer-events: none;
        display: flex;
        align-items: center;
    }

    .ad-search-kbd {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        padding: 0.12rem 0.32rem;
        font-size: 0.65rem;
        font-family: inherit;
        font-weight: 600;
        color: #94a3b8;
        background-color: #0f172a;
        border: 1px solid #334155;
        border-radius: 4px;
        pointer-events: none;
    }

    .ad-search-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        width: 450px;
        max-width: min(450px, calc(100vw - 32px));
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
        padding: 0.65rem;
        display: none;
        z-index: 1060;
    }

    .ad-search-dropdown.show {
        display: block;
    }

    .ad-search-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0.65rem;
        border-radius: 6px;
        text-decoration: none;
        color: #e2e8f0;
        font-size: 0.8rem;
        transition: background 0.15s ease;
    }

    .ad-search-item:hover {
        background: #1e293b;
        color: #ffffff;
        text-decoration: none;
    }

    /* Right Section: SLA Health, Alerts, Profile, Logout */
    .ad-right {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-shrink: 0;
    }

    /* Live Health Indicator Pill */
    .ad-sla-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        height: 32px;
        padding: 0 0.65rem;
        font-size: 0.72rem;
        font-weight: 600;
        font-family: monospace;
        color: #4ade80;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.25);
        border-radius: 999px;
        white-space: nowrap;
    }

    .ad-pulsing-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #22c55e;
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
        animation: adPulse 2s infinite;
    }

    @@keyframes adPulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }

    /* Icon Buttons (Alerts, Help) */
    .ad-icon-btn {
        position: relative;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 7px;
        color: #94a3b8;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .ad-icon-btn:hover {
        background-color: #334155;
        color: #ffffff;
        border-color: #475569;
    }

    .ad-badge-counter {
        position: absolute;
        top: -3px;
        right: -3px;
        min-width: 16px;
        height: 16px;
        padding: 0 3px;
        font-size: 0.625rem;
        font-weight: 700;
        color: #ffffff;
        background-color: #ef4444;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #0f172a;
    }

    /* Alerts Panel */
    .ad-alerts-panel {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 360px;
        max-width: calc(100vw - 32px);
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        display: none;
        z-index: 1060;
        overflow: hidden;
    }

    .ad-alerts-panel.show {
        display: block;
    }

    .ad-alerts-header {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #1e293b;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #1e293b;
    }

    .ad-alert-item {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #1e293b;
        display: flex;
        gap: 0.65rem;
        text-decoration: none;
        color: #cbd5e1;
        transition: background 0.15s ease;
    }

    .ad-alert-item:hover {
        background: #1e293b;
        color: #ffffff;
        text-decoration: none;
    }

    /* Admin Profile Menu */
    .ad-profile-container {
        position: relative;
    }

    .ad-profile-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: #1e293b;
        border: 1px solid #334155;
        padding: 0.25rem 0.55rem;
        border-radius: 7px;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .ad-profile-btn:hover {
        background-color: #334155;
        border-color: #475569;
    }

    .ad-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .ad-profile-name {
        font-size: 0.78rem;
        font-weight: 600;
        color: #ffffff;
        white-space: nowrap;
    }

    .ad-profile-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 260px;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        padding: 0.5rem;
        display: none;
        z-index: 1060;
    }

    .ad-profile-dropdown.show {
        display: block;
    }

    .ad-profile-header {
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid #1e293b;
        margin-bottom: 0.35rem;
    }

    .ad-profile-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.5rem 0.85rem;
        border-radius: 6px;
        text-decoration: none;
        color: #cbd5e1;
        font-size: 0.8rem;
        font-weight: 500;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .ad-profile-item:hover {
        background: #1e293b;
        color: #ffffff;
        text-decoration: none;
    }

    .ad-divider {
        height: 1px;
        background: #1e293b;
        margin: 0.35rem 0;
    }

    /* Direct Navbar Logout Button */
    .ad-direct-logout-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        height: 34px;
        padding: 0 0.65rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: #f87171;
        background-color: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 7px;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        white-space: nowrap;
    }

    .ad-direct-logout-btn:hover {
        background-color: rgba(239, 68, 68, 0.22);
        border-color: #f87171;
        color: #ffffff;
    }

    /* Mobile Hamburger */
    .ad-hamburger {
        display: none;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 7px;
        color: #ffffff;
        cursor: pointer;
    }

    /* Mobile Drawer */
    .ad-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(4px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
        z-index: 1070;
    }

    .ad-drawer-backdrop.open {
        opacity: 1;
        visibility: visible;
    }

    .ad-drawer {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        width: 320px;
        max-width: 85vw;
        background: #0f172a;
        border-right: 1px solid #1e293b;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1080;
        display: flex;
        flex-direction: column;
    }

    .ad-drawer.open {
        transform: translateX(0);
    }

    .ad-drawer-header {
        padding: 1.15rem 1.25rem;
        border-bottom: 1px solid #1e293b;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ad-drawer-body {
        padding: 1rem;
        overflow-y: auto;
        flex: 1 1 auto;
    }

    .ad-drawer-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 0.85rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #94a3b8;
        border-radius: 7px;
        text-decoration: none;
        margin-bottom: 2px;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .ad-drawer-link:hover, .ad-drawer-link.active {
        background: #1e293b;
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
    }

    /* Responsive Breakpoints */
    @@media (max-width: 1366px) {
        .ad-center {
            flex: 0 1 200px;
            max-width: 220px;
        }
        .ad-sla-pill span.ad-sla-text {
            display: none;
        }
    }

    @@media (max-width: 1120px) {
        .ad-center {
            display: none;
        }
    }

    @@media (max-width: 960px) {
        .ad-nav {
            display: none;
        }
        .ad-hamburger {
            display: inline-flex;
        }
    }

    @@media (max-width: 680px) {
        .ad-sla-pill {
            display: none;
        }
        .ad-profile-name {
            display: none;
        }
    }

    @@media (max-width: 520px) {
        .ad-direct-logout-btn span {
            display: none;
        }
        .ad-direct-logout-btn {
            padding: 0 0.5rem;
            width: 35px;
            justify-content: center;
        }
    }
</style>

<!-- Top Sticky Admin Workspace Header -->
<header class="ad-header-wrapper" id="epAdminHeader">
    <div class="ad-container">
        <!-- Left: Logo & Operations Pill -->
        <div class="ad-left">
            <a href="@Url.Action("Index", "Admin")" class="ad-brand" aria-label="EduPulse Admin Console">
                <span class="ad-brand-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </span>
                <span>EduPulse</span>
                <span class="ad-ops-badge">Ops Console</span>
            </a>

            <!-- Categorized Operations Navigation -->
            <nav class="ad-nav" aria-label="Administrative Workspaces">
                <!-- 1. Dashboard -->
                <a href="@Url.Action("Index", "Admin", new { tab = "dashboard" })" class="ad-nav-link @(isDashboard ? "active" : "")">
                    <span>Dashboard</span>
                </a>

                <!-- 2. Entities Dropdown (Users, Instructors, Certificates) -->
                <div class="ad-nav-dropdown" id="epNavEntitiesDropdown">
                    <button type="button" class="ad-nav-dropdown-btn @(isEntitiesActive ? "active" : "")" id="epEntitiesToggle" aria-haspopup="true" aria-expanded="false">
                        <span>Entities</span>
                        @if (vm.PendingReviewsCount > 0)
                        {
                            <span class="ad-nav-badge bg-warning text-dark">@vm.PendingReviewsCount</span>
                        }
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="ad-chevron">
                            <polyline points="6 9 12 15 18 9"></polyline>
