                    @foreach (var cat in vm.QuickCategories)
                    {
                        <a href="@Url.Action("Index", "Courses", new { categories = cat })" class="sn-search-chip">
                            @cat
                        </a>
                    }
                </div>

                <div class="sn-divider"></div>
