@using WebApplication1.Models
@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    var vm = StudentNavbarViewModel.LoadForUser(currentUser);

    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    string currentTab = Request.QueryString["tab"] ?? "";

    bool isDashboard = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) && string.IsNullOrEmpty(currentTab);
    bool isCourses = string.Equals(currentController, "Courses", StringComparison.OrdinalIgnoreCase) && !string.Equals(currentTab, "paths", StringComparison.OrdinalIgnoreCase);
    bool isLearningPaths = string.Equals(currentTab, "paths", StringComparison.OrdinalIgnoreCase);
    bool isCertificates = string.Equals(currentTab, "certificates", StringComparison.OrdinalIgnoreCase);
    bool isMyLearning = string.Equals(currentTab, "my-courses", StringComparison.OrdinalIgnoreCase);
}

