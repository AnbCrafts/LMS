<!-- Embedded Robust Interactivity for Student Navigation Workspace -->
<script>
    (function () {
        var header = document.getElementById('epStudentHeader');
        if (header) {
            window.addEventListener('scroll', function () {
                if (window.scrollY > 10) {
                    header.classList.add('sn-scrolled');
                } else {
                    header.classList.remove('sn-scrolled');
                }
            }, { passive: true });
        }

        var searchInput = document.getElementById('epGlobalSearchInput');
        var searchDropdown = document.getElementById('epSearchDropdown');
        var searchHint = document.getElementById('epSearchHintText');

        if (searchInput && searchDropdown) {
            searchInput.addEventListener('focus', function () {
                searchDropdown.classList.add('show');
            });

            searchInput.addEventListener('input', function () {
                var query = (searchInput.value || '').trim().toLowerCase();
                if (query.length > 0) {
                    searchDropdown.classList.add('show');
                    if (searchHint) searchHint.textContent = "Press Enter to search for '" + query + "'";
                } else {
                    if (searchHint) searchHint.textContent = "Press Enter to search all";
                }

                // Instant client-side live filter for items inside the dropdown
                var items = searchDropdown.querySelectorAll('.sn-search-result-item');
                items.forEach(function (item) {
                    var title = item.getAttribute('data-title') || '';
                    var inst = item.getAttribute('data-instructor') || '';
                    var cat = item.getAttribute('data-cat') || '';
                    if (!query || title.indexOf(query) !== -1 || inst.indexOf(query) !== -1 || cat.indexOf(query) !== -1) {
                        item.style.setProperty('display', 'flex', 'important');
                    } else {
                        item.style.setProperty('display', 'none', 'important');
                    }
                });
            });

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                    searchDropdown.classList.remove('show');
                }
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                    searchDropdown.classList.add('show');
                }
                if (e.key === 'Escape') {
                    searchDropdown.classList.remove('show');
                    if (notifPanel) notifPanel.classList.remove('show');
                    if (profilePanel) profilePanel.classList.remove('show');
                }
            });
        }

        var notifBtn = document.getElementById('epNotifToggle');
        var notifPanel = document.getElementById('epNotifPanel');
        var notifDot = document.getElementById('epNotifDot');
        var notifBadge = document.getElementById('epNotifCountBadge');
        var markAllBtn = document.getElementById('epMarkAllReadBtn');

        if (notifBtn && notifPanel) {
            notifBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (profilePanel) profilePanel.classList.remove('show');
                notifPanel.classList.toggle('show');
            });

            if (markAllBtn) {
                markAllBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (notifDot) notifDot.style.display = 'none';
                    if (notifBadge) notifBadge.style.display = 'none';
                    markAllBtn.innerText = 'All read';
                    markAllBtn.style.color = '#94a3b8';
                });
            }

            var tabs = notifPanel.querySelectorAll('.sn-notif-tab');
            var items = notifPanel.querySelectorAll('.sn-notif-item');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function (e) {
                    e.stopPropagation();
                    tabs.forEach(function (t) { t.classList.remove('active'); });
                    tab.classList.add('active');
                    var filter = tab.getAttribute('data-filter');
                    items.forEach(function (item) {
                        var cat = item.getAttribute('data-category');
                        if (filter === 'all' || cat === filter) {
                            item.style.display = 'flex';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });
        }

        var profileBtn = document.getElementById('epProfileToggle');
        var profilePanel = document.getElementById('epProfilePanel');

        if (profileBtn && profilePanel) {
            profileBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (notifPanel) notifPanel.classList.remove('show');
                profilePanel.classList.toggle('show');
            });
        }

        document.addEventListener('click', function (e) {
            if (notifPanel && !notifPanel.contains(e.target) && notifBtn && !notifBtn.contains(e.target)) {
                notifPanel.classList.remove('show');
            }
            if (profilePanel && !profilePanel.contains(e.target) && profileBtn && !profileBtn.contains(e.target)) {
                profilePanel.classList.remove('show');
            }
        });

        var mobileSearchBtn = document.getElementById('epMobileSearchToggle');
        var mobileSearchBar = document.getElementById('epMobileSearchBar');
        if (mobileSearchBtn && mobileSearchBar) {
            mobileSearchBtn.addEventListener('click', function () {
                mobileSearchBar.classList.toggle('show');
            });
        }

        var drawerOpenBtn = document.getElementById('epStudentDrawerOpen');
        var drawerCloseBtn = document.getElementById('epStudentDrawerClose');
        var drawer = document.getElementById('epStudentDrawer');
        var backdrop = document.getElementById('epStudentDrawerBackdrop');

        function openDrawer() {
            if (drawer && backdrop) {
                drawer.classList.add('open');
                backdrop.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeDrawer() {
            if (drawer && backdrop) {
                drawer.classList.remove('open');
                backdrop.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        if (drawerOpenBtn) drawerOpenBtn.addEventListener('click', openDrawer);
        if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);
        if (backdrop) backdrop.addEventListener('click', closeDrawer);
    })();
</script>
