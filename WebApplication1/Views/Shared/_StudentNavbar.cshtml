                <a class="sn-nav-link @(isCourses ? "active" : "")" 
                   href="@Url.Action("Index", "Courses")">
                    Courses
                </a>
                <a class="sn-nav-link @(isLearningPaths ? "active" : "")" 
                   href="@Url.Action("Index", "Courses", new { tab = "paths" })">
                    Learning Paths
                </a>
                <a class="sn-nav-link @(isCertificates ? "active" : "")" 
                   href="@Url.Action("Index", "Dashboard", new { tab = "certificates" })">
                    Certificates
                </a>
                <a class="sn-nav-link @(isMyLearning ? "active" : "")" 
                   href="@Url.Action("Index", "Dashboard", new { tab = "my-courses" })">
