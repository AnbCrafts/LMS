                    <span class="sn-search-heading p-0 m-0">Curated Courses</span>
                    <span class="text-secondary small" style="font-size: 0.7rem;" id="epSearchHintText">Press Enter to search all</span>
                </div>
                <div id="epSearchLiveResults">
                    @foreach (var crs in vm.SearchableCourses)
                    {
                        <a href="@Url.Action("Details", "Courses", new { id = crs.CourseId })" 
                           class="sn-search-result-item" 
                           data-title="@crs.Title.ToLower()" 
                           data-instructor="@crs.Instructor.ToLower()" 
                           data-cat="@crs.Category.ToLower()">
                            <div>
                                <div class="sn-search-result-title">@crs.Title</div>
                                <div class="sn-search-result-meta">@crs.Category &bull; by @crs.Instructor</div>
                            </div>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                                <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Right Side: Continue Action, Streak, Notifications, Profile -->
