@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    bool isLoggedIn = currentUser != null;
    string userRole = currentUser != null ? currentUser.Role : "";
    string userName = currentUser != null ? currentUser.FullName : "";
    bool isApproved = currentUser != null && currentUser.IsApproved;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | EduPulse LMS" : "EduPulse LMS Portal")</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Modern Sticky Glassmorphism Header -->
    <header class="lms-navbar">
        <div class="container-fluid px-lg-5 px-3 d-flex justify-content-between align-items-center">
            <!-- Brand Left with Gradient Icon -->
            <a class="lms-brand" href="@Url.Action("Index", "Home")">
                <span class="lms-brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>EduPulse</span>
            </a>

            <!-- Navigation Links Center -->
            <nav class="d-none d-md-flex align-items-center gap-2">
                <a class="lms-nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")" 
                   href="@Url.Action("Index", "Home")">
                    <i class="bi bi-house-door"></i> Home
                </a>
                <a class="lms-nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Courses" ? "active" : "")" 
                   href="@Url.Action("Index", "Courses")">
                    <i class="bi bi-grid-3x3-gap"></i> Courses
                </a>

                @if (isLoggedIn && userRole == "Instructor")
                {
                    <a class="lms-nav-link text-primary fw-bold @(ViewContext.RouteData.Values["controller"].ToString() == "Instructor" ? "active" : "")" 
                       href="@Url.Action("Index", "Instructor")">
                        <i class="bi bi-person-workspace"></i> Instructor Studio & Dashboard
                    </a>
                }
                else if (isLoggedIn && userRole == "Admin")
                {
                    <a class="lms-nav-link text-danger fw-bold @(ViewContext.RouteData.Values["controller"].ToString() == "Admin" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")" 
                       href="@Url.Action("Index", "Admin")">
                        <i class="bi bi-shield-check"></i> Admin Portal
                    </a>
                    <a class="lms-nav-link text-primary fw-bold @(ViewContext.RouteData.Values["controller"].ToString() == "Admin" && ViewContext.RouteData.Values["action"].ToString() == "VerifySellers" ? "active" : "")" 
                       href="@Url.Action("VerifySellers", "Admin")">
                        <i class="bi bi-person-check-fill"></i> Verify Sellers
                    </a>
                }
                else
                {
                    <a class="lms-nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")" 
                       href="@Url.Action("Index", "Dashboard")">
                        <i class="bi bi-speedometer2"></i> My Dashboard
                    </a>
                }

                @if (isLoggedIn)
                {
                    <a class="lms-nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Payment" ? "active" : "")" 
                       href="@Url.Action("Invoices", "Payment")">
                        <i class="bi bi-receipt"></i> Invoices
                    </a>
                }
            </nav>

            <!-- User Auth Profile Section Right -->
            <div class="d-flex align-items-center gap-2">
                <!-- Demo Quick Persona Switcher Dropdown (Available Everywhere) -->
                <div class="dropdown d-inline-block">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Demo Persona">
                        <i class="bi bi-person-bounding-box text-primary me-1"></i> Switch Role
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-2" style="min-width: 260px;">
                        <li class="dropdown-header small text-uppercase fw-bold text-muted px-2 py-1">Quick Switch Testing Persona</li>
                        <li>
                            @using (Html.BeginForm("QuickLogin", "Account", FormMethod.Post, new { @class = "m-0" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="persona" value="Student" />
                                <button type="submit" class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-mortarboard"></i></span>
                                    <div>
                                        <div class="fw-bold small text-dark">Student (John Doe)</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Dashboard, Classroom & Quizzes</div>
                                    </div>
                                </button>
                            }
                        </li>
                        <li>
                            @using (Html.BeginForm("QuickLogin", "Account", FormMethod.Post, new { @class = "m-0" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="persona" value="Instructor" />
                                <button type="submit" class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-success rounded-circle p-1"><i class="bi bi-person-workspace"></i></span>
                                    <div>
                                        <div class="fw-bold small text-dark">Instructor (A. Sharma)</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Approved Seller &bull; 90% Net Studio</div>
                                    </div>
                                </button>
                            }
                        </li>
                        <li>
                            @using (Html.BeginForm("QuickLogin", "Account", FormMethod.Post, new { @class = "m-0" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="persona" value="Admin" />
                                <button type="submit" class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-danger rounded-circle p-1"><i class="bi bi-shield-check"></i></span>
                                    <div>
                                        <div class="fw-bold small text-dark">Admin (System Admin)</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">10% Platform Cut & Approvals</div>
                                    </div>
                                </button>
                            }
                        </li>
                        <li>
                            @using (Html.BeginForm("QuickLogin", "Account", FormMethod.Post, new { @class = "m-0" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="persona" value="PendingInstructor" />
                                <button type="submit" class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark rounded-circle p-1"><i class="bi bi-hourglass-split"></i></span>
                                    <div>
                                        <div class="fw-bold small text-dark">Pending Instructor (Pooja Mehta)</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Unapproved Seller Test</div>
                                    </div>
                                </button>
                            }
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2" href="@Url.Action("ApplicationStatus", "Instructor")">
                                <span class="badge bg-secondary rounded-circle p-1"><i class="bi bi-patch-question"></i></span>
                                <div>
                                    <div class="fw-bold small text-dark">Lookup Application Status</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Enter email & inspect feedback</div>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                @if (isLoggedIn)
                {
                    string initials = "U";
                    if (!string.IsNullOrWhiteSpace(userName))
                    {
                        var parts = userName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                        initials = parts.Length >= 2 
                            ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
                            : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                    }

                    <a href="@(userRole == "Instructor" ? Url.Action("Profile", "Instructor") : Url.Action("Profile", "Account"))" class="lms-user-pill text-decoration-none" title="View Account Profile">
                        <span class="lms-user-avatar">@initials</span>
                        <span>@userName</span>
                        @if (userRole == "Instructor" && !isApproved)
                        {
                            <span class="badge bg-warning text-dark small" title="Verification Pending">Pending</span>
                        }
                    </a>

                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline m-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    }
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold">
                        Sign In
                    </a>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold">
                        Get Started
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Global TempData Alerts -->
    @if (TempData["WarningMessage"] != null)
    {
        <div class="container-fluid px-lg-5 px-3 pt-3">
            <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main View Content -->
    <main class="lms-main-wrapper">
        @RenderBody()
    </main>

    <!-- Floating RAG AI Teaching Assistant Drawer (Only visible when logged in) -->
    @if (isLoggedIn)
    {
        @Html.Partial("_ChatWidget")
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
