@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    bool isLoggedIn = currentUser != null;
    string userRole = currentUser != null ? currentUser.Role : "";
    string userName = currentUser != null ? currentUser.FullName : "";
    bool isApproved = currentUser != null && currentUser.IsApproved;

    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    bool isLandingPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | EduPulse" : "EduPulse - Professional Learning Platform")</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/Site.css?v=@DateTime.UtcNow.Ticks" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @if (isLoggedIn && string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase))
    {
        @Html.Partial("_AdminNavbar")
    }
    else if (isLoggedIn && string.Equals(userRole, "Instructor", StringComparison.OrdinalIgnoreCase))
    {
        @Html.Partial("_InstructorNavbar")
    }
    else if (isLoggedIn && string.Equals(userRole, "Student", StringComparison.OrdinalIgnoreCase))
    {
        @Html.Partial("_StudentNavbar")
    }
    else if (isLandingPage)
    {
        @Html.Partial("_LandingNavbar")
    }
    else
    {
        <!-- Internal Portal Header (Clean, Professional, Free of Test Clutter) -->
        <header class="ep-navbar">
            <div class="container-fluid px-lg-5 px-3 d-flex justify-content-between align-items-center h-100">
                <!-- Brand Left -->
                <a class="ep-brand" href="@Url.Action("Index", "Home")" aria-label="EduPulse Home">
                    <span class="ep-brand-mark">
                        <svg width="26" height="26" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect width="28" height="28" rx="6" fill="#0F172A" />
                            <path d="M7 10C7 8.89543 7.89543 8 9 8H19C20.1046 8 21 8.89543 21 10V18.5C21 19.6046 20.1046 20.5 19 20.5H9C7.89543 20.5 7 19.6046 7 18.5V10Z" stroke="white" stroke-width="1.25" stroke-opacity="0.25" />
                            <path d="M14 8V20.5M7 16.5C9.2 15.2 11.4 15.2 14 16.5C16.6 15.2 18.8 15.2 21 16.5" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="ep-brand-text">EduPulse</span>
                </a>

                <!-- Portal Navigation Links -->
                <nav class="d-none d-md-flex align-items-center gap-1" aria-label="Portal Navigation">
                    <a class="ep-nav-link @(currentController == "Courses" ? "active" : "")" 
                       href="@Url.Action("Index", "Courses")">
                        Browse Courses
                    </a>

                    @if (isLoggedIn && userRole == "Instructor")
                    {
                        <a class="ep-nav-link @(currentController == "Instructor" ? "active" : "")" 
                           href="@Url.Action("Index", "Instructor")">
                            Instructor Studio
                        </a>
                    }
                    else if (isLoggedIn && userRole == "Admin")
                    {
                        <a class="ep-nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")" 
                           href="@Url.Action("Index", "Admin")">
                            Admin Portal
                        </a>
                        <a class="ep-nav-link @(currentController == "Admin" && currentAction == "VerifySellers" ? "active" : "")" 
                           href="@Url.Action("VerifySellers", "Admin")">
                            Verify Sellers
                        </a>
                    }
                    else if (isLoggedIn)
                    {
                        <a class="ep-nav-link @(currentController == "Dashboard" ? "active" : "")" 
                           href="@Url.Action("Index", "Dashboard")">
                            My Dashboard
                        </a>
                    }

                    @if (isLoggedIn)
                    {
                        <a class="ep-nav-link @(currentController == "Payment" ? "active" : "")" 
                           href="@Url.Action("Invoices", "Payment")">
                            Invoices
                        </a>
                    }

                    <a class="ep-nav-link text-warning fw-semibold d-inline-flex align-items-center gap-1" 
                       href="/hangfire" target="_blank" title="Hangfire Live Background Job Center">
                        <i class="bi bi-cpu-fill"></i>
                        <span>Jobs</span>
                    </a>
                </nav>

                <!-- Auth & Profile Section Right -->
                <div class="d-flex align-items-center gap-2">
                    @if (isLoggedIn)
                    {
                        string initials = "U";
                        if (!string.IsNullOrWhiteSpace(userName))
                        {
                            var parts = userName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                            initials = parts.Length >= 2 
                                ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
                                : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                        }

                        <a href="@(userRole == "Instructor" ? Url.Action("Profile", "Instructor") : Url.Action("Profile", "Account"))" class="lms-user-pill text-decoration-none" title="View Account Profile">
                            <span class="lms-user-avatar" style="background: #0f172a; color: #fff;">@initials</span>
                            <span>@userName</span>
                            @if (userRole == "Instructor" && !isApproved)
                            {
                                <span class="badge bg-warning text-dark small" title="Verification Pending">Pending</span>
                            }
                        </a>

                        using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline m-0" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-2 px-3" title="Sign Out">
                                Sign Out
                            </button>
                        }
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="ep-btn-subtle">
                            Sign In
                        </a>
                        <a href="@Url.Action("Register", "Account")" class="ep-btn-primary">
                            Create Account
                        </a>
                    }
                </div>
            </div>
        </header>
    }

    <!-- Global TempData Alerts -->
    @if (TempData["WarningMessage"] != null)
    {
        <div class="container-fluid px-lg-5 px-3 pt-3">
            <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main View Content -->
    <main class="lms-main-wrapper">
        @RenderBody()
    </main>

    <!-- Floating RAG AI Teaching Assistant Drawer (Only visible when logged in) -->
    @if (isLoggedIn)
    {
        @Html.Partial("_ChatWidget")
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
