@* 
    _LandingNavbar.cshtml
    EduPulse Academic & Professional Platform Header
    Bespoke, credible, and minimal design inspired by Stripe, Linear, and Maven.
    Strictly zero AI badges, zero persona switchers, zero promotional clutter.
*@

@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    bool isLoggedIn = currentUser != null;
    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
}

<!-- Self-Contained Resilient Design System for EduPulse Landing Header -->
<style>
    /* Sticky Top Header Container */
    .ep-header-wrapper {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        background-color: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid #eef0f3;
        z-index: 1040;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .ep-header-wrapper.ep-scrolled {
        box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.05), 0 1px 2px -1px rgba(15, 23, 42, 0.03);
        border-bottom-color: #e2e8f0;
    }

    .ep-header-inner {
        max-width: 1400px;
        height: 64px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Left Group: Brand Anchor + Navigation */
    .ep-brand-group {
        display: flex;
        align-items: center;
    }

    .ep-brand-anchor {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none !important;
        cursor: pointer;
    }

    .ep-brand-symbol {
        width: 32px;
        height: 32px;
        background-color: #0f172a;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        flex-shrink: 0;
    }

    .ep-brand-name {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #0f172a !important;
        margin: 0;
        line-height: 1;
    }

    .ep-desktop-nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        margin-left: 2.25rem;
        padding-left: 1.75rem;
        border-left: 1px solid #f1f5f9;
    }

    .ep-nav-item {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        color: #475569 !important;
        text-decoration: none !important;
        padding: 6px 10px;
        border-radius: 6px;
        transition: color 0.15s ease, background-color 0.15s ease;
        white-space: nowrap;
    }

    .ep-nav-item:hover {
        color: #0f172a !important;
        background-color: #f8fafc;
    }

    .ep-nav-item.active {
        color: #0f172a !important;
        font-weight: 600;
        background-color: #f1f5f9;
    }

    /* Center Spacer */
    .ep-center-spacer {
        flex: 1 1 auto;
    }

    /* Right Auth Actions */
    .ep-desktop-auth {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ep-btn-signin {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        color: #475569 !important;
        background: transparent;
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        text-decoration: none !important;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        cursor: pointer;
    }

    .ep-btn-signin:hover {
        color: #0f172a !important;
        background-color: #f1f5f9;
    }

    .ep-btn-create {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        color: #ffffff !important;
        background-color: #0f172a !important;
        border: 1px solid #0f172a;
        padding: 7px 16px;
        border-radius: 6px;
        text-decoration: none !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        cursor: pointer;
    }

    .ep-btn-create:hover {
        background-color: #1e293b !important;
        border-color: #1e293b;
        color: #ffffff !important;
    }

    /* Mobile Hamburger Trigger */
    .ep-mobile-trigger {
        display: none;
        background: transparent;
        border: 1px solid #e2e8f0;
        padding: 7px 9px;
        border-radius: 6px;
        cursor: pointer;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        transition: background-color 0.15s ease;
    }

    .ep-mobile-trigger:hover {
        background-color: #f1f5f9;
    }

    .ep-hamburger-bar {
        width: 18px;
        height: 1.5px;
        background-color: #0f172a;
        border-radius: 1px;
    }

    /* Mobile Drawer Styles */
    .ep-drawer-link {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        color: #334155 !important;
        text-decoration: none !important;
        padding: 10px 14px;
        border-radius: 8px;
        display: block;
        min-height: 44px;
        line-height: 24px;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .ep-drawer-link:hover,
    .ep-drawer-link.active {
        background-color: #f1f5f9;
        color: #0f172a !important;
        font-weight: 600;
    }

    /* Breakpoint Rules */
    @@media (max-width: 991.98px) {
        .ep-desktop-nav,
        .ep-desktop-auth {
            display: none !important;
        }

        .ep-mobile-trigger {
            display: inline-flex !important;
        }

        .ep-header-inner {
            padding: 0 1rem;
        }
    }
</style>

<!-- Sticky Top Navbar Container -->
<header id="epLandingNavbar" class="ep-header-wrapper">
    <div class="ep-header-inner">
        
        <!-- Left Section: Brand Anchor + Primary Discovery Links -->
        <div class="ep-brand-group">
            <!-- Brand Anchor: Logo + Wordmark -->
            <a class="ep-brand-anchor" href="@Url.Action("Index", "Home")" aria-label="EduPulse Home">
                <span class="ep-brand-symbol" aria-hidden="true">
                    <!-- Clean Architectural Insignia: Academic Podium & Open Knowledge Geometry -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M5 10.5V16C5 17.5 8 19.5 12 19.5C16 19.5 19 17.5 19 16V10.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 8V14" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="ep-brand-name">EduPulse</span>
            </a>

            <!-- Beside the Logo: Static Discovery & Trust Navigation Links (Desktop) -->
            <nav class="ep-desktop-nav" aria-label="Main Navigation">
                <a class="ep-nav-item @(currentController == "Courses" && currentAction == "Index" ? "active" : "")" 
                   href="@Url.Action("Index", "Courses")">
                    Browse Courses
                </a>
                <a class="ep-nav-item" 
                   href="@Url.Action("Register", "Account")">
                    Become an Instructor
                </a>
                <a class="ep-nav-item @(currentController == "Home" && currentAction == "About" ? "active" : "")" 
                   href="@Url.Action("About", "Home")">
                    About
                </a>
                <a class="ep-nav-item @(currentController == "Home" && currentAction == "Contact" ? "active" : "")" 
                   href="@Url.Action("Contact", "Home")">
                    Contact
                </a>
            </nav>
        </div>

        <!-- Center Area: Purposefully Open and Uncluttered for Premium Visual Breathing Room -->
        <div class="ep-center-spacer"></div>

        <!-- Right Section: Dynamic Authentication Actions (Desktop) -->
        <div class="ep-desktop-auth">
            @if (isLoggedIn)
            {
                <a href="@Url.Action("Index", "Dashboard")" class="ep-btn-signin">
                    Go to Dashboard
                </a>
                using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline m-0" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ep-btn-signin" title="Sign Out">
                        Sign Out
                    </button>
                }
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="ep-btn-signin">
                    Sign In
                </a>
                <a href="@Url.Action("Register", "Account")" class="ep-btn-create">
                    Create Account
                </a>
            }
        </div>

        <!-- Mobile / Tablet Hamburger Button Trigger (Replaces Desktop Navigation on < 992px) -->
        <button class="ep-mobile-trigger" 
                type="button" 
                data-bs-toggle="offcanvas" 
                data-bs-target="#landingMobileDrawer" 
                aria-controls="landingMobileDrawer" 
                aria-label="Toggle navigation drawer">
            <span class="ep-hamburger-bar"></span>
            <span class="ep-hamburger-bar"></span>
            <span class="ep-hamburger-bar"></span>
        </button>
    </div>
</header>

<!-- Mobile Slide-Over Drawer (80% Viewport Width with Overlay Backdrop) -->
<div class="offcanvas offcanvas-end" 
     tabindex="-1" 
     id="landingMobileDrawer" 
     aria-labelledby="landingMobileDrawerLabel"
     style="width: 82vw; max-width: 320px; border-left: 1px solid #e2e8f0; background-color: #ffffff;">
    
    <!-- Drawer Header -->
    <div class="offcanvas-header border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
        <a class="ep-brand-anchor" href="@Url.Action("Index", "Home")" id="landingMobileDrawerLabel" aria-label="EduPulse Home">
            <span class="ep-brand-symbol" style="width: 28px; height: 28px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M5 10.5V16C5 17.5 8 19.5 12 19.5C16 19.5 19 17.5 19 16V10.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            <span class="ep-brand-name" style="font-size: 1.05rem;">EduPulse</span>
        </a>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
    </div>

    <!-- Drawer Body: Vertically Spaced Navigation Links + Pinned Bottom Actions -->
    <div class="offcanvas-body d-flex flex-column p-4">
        
        <!-- Navigation Links Group -->
        <nav class="d-flex flex-column gap-1" aria-label="Mobile Navigation">
            <a class="ep-drawer-link @(currentController == "Courses" && currentAction == "Index" ? "active" : "")" 
               href="@Url.Action("Index", "Courses")">
                Browse Courses
            </a>
            <a class="ep-drawer-link" 
               href="@Url.Action("Register", "Account")">
                Become an Instructor
            </a>
            <a class="ep-drawer-link @(currentController == "Home" && currentAction == "About" ? "active" : "")" 
               href="@Url.Action("About", "Home")">
                About
            </a>
            <a class="ep-drawer-link @(currentController == "Home" && currentAction == "Contact" ? "active" : "")" 
               href="@Url.Action("Contact", "Home")">
                Contact
            </a>
        </nav>

        <!-- Dynamic Authentication Actions Pinned Near Bottom -->
        <div class="mt-auto pt-4 border-top">
            @if (isLoggedIn)
            {
                <a href="@Url.Action("Index", "Dashboard")" class="ep-btn-create w-100 py-2 text-center mb-2 d-block text-white">
                    Go to Dashboard
                </a>
                using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "m-0" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ep-btn-signin w-100 py-2 text-center d-block border" style="border-color: #e2e8f0 !important;">
                        Sign Out
                    </button>
                }
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="ep-btn-signin w-100 py-2 text-center mb-2 d-block border" style="border-color: #e2e8f0 !important;">
                    Sign In
                </a>
                <a href="@Url.Action("Register", "Account")" class="ep-btn-create w-100 py-2 text-center d-block text-white">
                    Create Account
                </a>
            }
        </div>
    </div>
</div>

<!-- Light Elevation on Scroll Script -->
<script>
    (function () {
        var header = document.getElementById('epLandingNavbar');
        if (!header) return;
        var onScroll = function () {
            if (window.scrollY > 8) {
                header.classList.add('ep-scrolled');
            } else {
                header.classList.remove('ep-scrolled');
            }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    })();
</script>
