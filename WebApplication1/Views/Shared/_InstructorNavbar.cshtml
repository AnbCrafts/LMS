</style>

<!-- Top Sticky Instructor Workspace Header -->
<header class="in-header-wrapper" id="epInstructorHeader">
    <div class="in-container">
        <!-- Left: Logo & Primary Management Navigation -->
        <div class="in-left">
            <a href="@Url.Action("Index", "Instructor")" class="in-brand" aria-label="EduPulse Instructor Studio">
                <span class="in-brand-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </span>
                <span>EduPulse</span>
                <span class="in-studio-badge">Studio</span>
            </a>

            <!-- Primary Workspace Navigation Links -->
            <nav class="in-nav" aria-label="Instructor Workspace Navigation">
                <a href="@Url.Action("Index", "Instructor")" class="in-nav-link @(isDashboard ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
