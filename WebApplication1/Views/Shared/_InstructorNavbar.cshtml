                <a href="@Url.Action("Index", "Instructor", new { tab = "courses" })" class="in-nav-link @(isMyCourses ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                    <span>My Courses</span>
                </a>

                <a href="@Url.Action("Index", "Instructor", new { tab = "students" })" class="in-nav-link @(isStudents ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span>Students</span>
                </a>

                <a href="@Url.Action("Index", "Instructor", new { tab = "analytics" })" class="in-nav-link @(isAnalytics ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span>Analytics</span>
                </a>

                <a href="@Url.Action("Submissions", "Instructor")" class="in-nav-link @(isAssessments ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 11 12 14 22 4"></polyline>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    <span>Assessments</span>
                    @if (vm.PendingSubmissionsCount > 0)
                    {
                        <span class="badge bg-warning text-dark font-monospace rounded-pill ms-1" style="font-size: 0.65rem; padding: 0.15rem 0.4rem;">
                            @vm.PendingSubmissionsCount
                        </span>
                    }
                </a>

                <a href="@Url.Action("Index", "Instructor", new { tab = "resources" })" class="in-nav-link @(isResources ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Resources</span>
                </a>
            </nav>
        </div>

        <!-- Center: Course Switcher & Global Workspace Search -->
        <div class="in-center">
            <!-- Active Course Switcher -->
            @if (vm.Courses.Any())
            {
                <div class="in-course-switcher">
                    <button class="in-switcher-btn" id="epCourseSwitcherToggle" aria-haspopup="true" aria-expanded="false" title="Switch course context">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                            <polyline points="2 17 12 22 22 17"></polyline>
                            <polyline points="2 12 12 17 22 12"></polyline>
                        </svg>
                        <span class="text-truncate">
                            @(vm.HasCurrentCourse ? vm.CurrentCourseTitle : $"All Courses ({vm.Courses.Count})")
                        </span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    <div class="in-switcher-dropdown" id="epCourseSwitcherDropdown">
                        <div class="in-switcher-heading">Your Active Curriculums</div>
                        @foreach (var c in vm.Courses)
                        {
                            bool isCurrent = vm.CurrentCourseId.HasValue && vm.CurrentCourseId.Value == c.CourseId;
                            <div class="in-switcher-item @(isCurrent ? "active" : "")">
                                <a href="@Url.Action("Modules", "Instructor", new { courseId = c.CourseId })" class="text-decoration-none text-dark d-flex align-items-center gap-2 text-truncate flex-grow-1">
                                    <div class="text-truncate">
                                        <div class="fw-semibold text-truncate" style="font-size: 0.8rem;">@c.Title</div>
                                        <div class="text-secondary" style="font-size: 0.7rem;">@c.Category &bull; @c.ModuleCount Modules &bull; @c.EnrolledCount Enrolled</div>
                                    </div>
                                </a>
                                <a href="@Url.Action("Submissions", "Instructor", new { courseId = c.CourseId })" class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-0 font-monospace ms-2" style="font-size: 0.65rem;" title="View Submissions">
                                    Dossiers
                                </a>
                            </div>
                        }

                        <div class="in-divider"></div>
                        <a href="@Url.Action("Create", "Instructor")" class="in-switcher-item text-primary fw-semibold justify-content-center">
                            + Create New Course
                        </a>
                    </div>
                </div>
            }

            <!-- Global Workspace Search -->
            <div class="in-search-box">
                <span class="in-search-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="text" id="epInstructorSearchInput" class="in-search-input" placeholder="Search courses, students, tasks..." autocomplete="off" />
                <span class="in-search-kbd">Ctrl K</span>

                <!-- Instant Autocomplete Categorized Dropdown -->
                <div class="in-search-dropdown" id="epInstructorSearchDropdown">
                    <div class="d-flex align-items-center justify-content-between px-2 pt-1 pb-1">
                        <span class="in-switcher-heading p-0 m-0">Workspace Catalog</span>
                        <span class="text-secondary small font-monospace" style="font-size: 0.68rem;" id="epSearchHint">Type to filter</span>
                    </div>

                    <div id="epSearchItemList" style="max-height: 340px; overflow-y: auto;">
                        @foreach (var item in vm.SearchItems)
                        {
                            <a href="@item.TargetUrl" class="in-search-item" data-title="@item.Title.ToLower()" data-category="@item.Category.ToLower()" data-sub="@item.Subtitle.ToLower()">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.65rem; width: 68px; text-align: center;">
                                        @item.Category
                                    </span>
                                    <div class="text-truncate">
                                        <div class="fw-semibold text-truncate">@item.Title</div>
                                        <div class="text-secondary" style="font-size: 0.7rem;">@Html.Raw(item.Subtitle)</div>
                                    </div>
                                </div>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" class="flex-shrink-0 ms-2">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Create Action, Notifications, Profile, Logout -->
        <div class="in-right">
            <!-- Prominent + Create Button -->
            <div class="in-create-container">
                <button class="in-create-btn" id="epCreateMenuToggle" aria-haspopup="true" aria-expanded="false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Create</span>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>

                <div class="in-create-dropdown" id="epCreateDropdown">
                    <div class="in-switcher-heading">Creation Workflows</div>
                    <a href="@Url.Action("Create", "Instructor")" class="in-create-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                        </svg>
                        <span>Create Course</span>
                    </a>

                    <a href="@Url.Action("Modules", "Instructor")" class="in-create-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                            <polyline points="2 17 12 22 22 17"></polyline>
                            <polyline points="2 12 12 17 22 12"></polyline>
                        </svg>
                        <span>Create Module &amp; Lecture</span>
                    </a>

                    <a href="@Url.Action("ManageQuiz", "Instructor")" class="in-create-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                        <span>Create Quiz Assessment</span>
                    </a>

                    <a href="@Url.Action("Submissions", "Instructor")" class="in-create-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2">
                            <polyline points="9 11 12 14 22 4"></polyline>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        <span>Grade Student Submissions</span>
                    </a>

                    <div class="in-divider"></div>

                    <a href="@Url.Action("ManageQuiz", "Instructor")" class="in-create-item text-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                        </svg>
                        <span>Generate Quiz (AI Assistant)</span>
                    </a>
                </div>
            </div>

            <!-- Notifications Center -->
            <div class="in-notif-container">
                <button class="in-icon-btn" id="epInstructorNotifToggle" aria-haspopup="true" aria-expanded="false" title="Notifications Center">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    @if (vm.UnreadNotificationsCount > 0)
                    {
                        <span class="in-badge-counter">@vm.UnreadNotificationsCount</span>
                    }
                </button>

                <div class="in-notif-panel" id="epInstructorNotifPanel">
                    <div class="in-notif-header">
                        <span class="in-notif-title">Instructional Notifications</span>
                        <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.68rem;">
                            @vm.Notifications.Count Total
                        </span>
                    </div>

                    <div style="max-height: 320px; overflow-y: auto;">
                        @if (vm.Notifications.Any())
                        {
                            foreach (var n in vm.Notifications)
                            {
                                <a href="@n.TargetUrl" class="in-notif-item">
                                    <div class="pt-1">
                                        @if (n.IsUrgent)
                                        {
                                            <span style="color: #f59e0b; font-size: 0.9rem;">&#9679;</span>
                                        }
                                        else
                                        {
                                            <span style="color: #10b981; font-size: 0.9rem;">&#10003;</span>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold text-dark small">@n.Title</div>
                                        <div class="text-secondary small" style="font-size: 0.75rem;">@n.Message</div>
                                        <div class="text-muted font-monospace mt-1" style="font-size: 0.68rem;">@n.TimestampFormatted</div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="p-3 text-center text-secondary small">
                                No new notifications at this time.
                            </div>
                        }
                    </div>

                    <div class="p-2 border-top bg-light text-center">
                        <a href="@Url.Action("Submissions", "Instructor")" class="text-dark small fw-semibold text-decoration-none">
                            View All Submissions &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Instructor Profile Menu (Far Right) -->
            <div class="in-profile-container">
                <button class="in-profile-btn" id="epInstructorProfileToggle" aria-haspopup="true" aria-expanded="false" title="Instructor Profile: @vm.FullName">
                    <span class="in-avatar">@vm.AvatarInitials</span>
                    <span class="in-profile-name">Profile</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>

                <div class="in-profile-dropdown" id="epInstructorProfileDropdown">
                    <div class="in-profile-header">
                        <div class="fw-bold text-dark small">@vm.FullName</div>
                        <div class="text-secondary" style="font-size: 0.725rem;">@vm.Email</div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill font-monospace mt-1" style="font-size: 0.65rem;">
                            Approved Instructor
                        </span>
                    </div>

                    <a href="@Url.Action("Profile", "Instructor")" class="in-profile-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>Instructor Profile &amp; Pedigree</span>
                    </a>

                    <a href="@Url.Action("Index", "Instructor")" class="in-profile-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span>Instructor Studio Dashboard</span>
                    </a>

                    <a href="@Url.Action("Index", "Courses")" class="in-profile-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polygon points="10 8 16 12 10 16 10 8"></polygon>
                        </svg>
                        <span>Course Catalog (Student View)</span>
                    </a>

                    <a href="@Url.Action("Index", "Instructor", new { tab = "earnings" })" class="in-profile-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                        <span>Earnings &amp; Net Revenue</span>
                    </a>

                    <a href="@Url.Action("Profile", "Account")" class="in-profile-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span>Account Credentials</span>
                    </a>

                    <div class="in-divider"></div>

                    <form action="@Url.Action("Logout", "Account")" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="in-signout-btn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Sign Out</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Direct Navbar Logout Button -->
            <form action="@Url.Action("Logout", "Account")" method="post" class="m-0 d-inline-flex align-items-center">
                @Html.AntiForgeryToken()
                <button type="submit" class="in-direct-logout-btn" title="Sign out of EduPulse">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </form>

            <!-- Mobile Hamburger Toggle -->
            <button class="in-hamburger" id="epInstructorDrawerOpen" aria-label="Open Workspace Menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Offcanvas Drawer -->
<div class="in-drawer-backdrop" id="epInstructorDrawerBackdrop"></div>
<div class="in-drawer" id="epInstructorDrawer" role="dialog" aria-modal="true" aria-label="Instructor Studio Menu">
    <div class="in-drawer-header">
        <div class="d-flex align-items-center gap-2">
            <span class="in-avatar">@vm.AvatarInitials</span>
            <div>
                <div class="fw-bold text-dark small">@vm.FullName</div>
                <div class="text-secondary" style="font-size: 0.7rem;">Instructor Workspace</div>
            </div>
        </div>
        <button class="btn-close" id="epInstructorDrawerClose" aria-label="Close"></button>
    </div>

    <div class="in-drawer-body">
        <a href="@Url.Action("Index", "Instructor")" class="in-drawer-link @(isDashboard ? "active" : "")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Dashboard</span>
        </a>

        <a href="@Url.Action("Index", "Instructor", new { tab = "courses" })" class="in-drawer-link @(isMyCourses ? "active" : "")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>My Courses</span>
        </a>

        <a href="@Url.Action("Index", "Instructor", new { tab = "students" })" class="in-drawer-link @(isStudents ? "active" : "")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Students</span>
        </a>

        <a href="@Url.Action("Index", "Instructor", new { tab = "analytics" })" class="in-drawer-link @(isAnalytics ? "active" : "")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Analytics</span>
        </a>

        <a href="@Url.Action("Submissions", "Instructor")" class="in-drawer-link @(isAssessments ? "active" : "")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            <span>Assessments</span>
            @if (vm.PendingSubmissionsCount > 0)
            {
                <span class="badge bg-warning text-dark font-monospace rounded-pill ms-auto" style="font-size: 0.65rem;">
                    @vm.PendingSubmissionsCount
                </span>
            }
        </a>

        <a href="@Url.Action("Index", "Instructor", new { tab = "resources" })" class="in-drawer-link @(isResources ? "active" : "")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            <span>Resources</span>
        </a>

        <div class="in-divider my-3"></div>

        <div class="px-2 mb-2 text-secondary small fw-bold text-uppercase" style="font-size: 0.68rem;">Quick Actions</div>
        <a href="@Url.Action("Create", "Instructor")" class="in-drawer-link text-primary fw-semibold">
            + Create New Course
        </a>
