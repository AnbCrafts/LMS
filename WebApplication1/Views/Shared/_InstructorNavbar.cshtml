<!-- Embedded Interactive Scripts for Instructor Workspace Header -->
<script>
    (function () {
        var header = document.getElementById('epInstructorHeader');
        if (header) {
            window.addEventListener('scroll', function () {
                if (window.scrollY > 10) header.classList.add('in-scrolled');
                else header.classList.remove('in-scrolled');
            }, { passive: true });
        }

        // Dropdown toggles helper
        function setupDropdown(btnId, panelId) {
            var btn = document.getElementById(btnId);
            var panel = document.getElementById(panelId);
            if (!btn || !panel) return;

            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                // Close other open panels
                document.querySelectorAll('.in-switcher-dropdown, .in-create-dropdown, .in-notif-panel, .in-profile-dropdown, .in-search-dropdown').forEach(function (d) {
                    if (d !== panel) d.classList.remove('show');
                });
                panel.classList.toggle('show');
            });
        }

        setupDropdown('epCourseSwitcherToggle', 'epCourseSwitcherDropdown');
        setupDropdown('epCreateMenuToggle', 'epCreateDropdown');
        setupDropdown('epInstructorNotifToggle', 'epInstructorNotifPanel');
        setupDropdown('epInstructorProfileToggle', 'epInstructorProfileDropdown');

        // Close on outside click
        document.addEventListener('click', function (e) {
            document.querySelectorAll('.in-switcher-dropdown, .in-create-dropdown, .in-notif-panel, .in-profile-dropdown, .in-search-dropdown').forEach(function (d) {
                if (!d.contains(e.target)) d.classList.remove('show');
            });
        });

        // Search Autocomplete functionality
        var searchInput = document.getElementById('epInstructorSearchInput');
        var searchDropdown = document.getElementById('epInstructorSearchDropdown');
        var searchHint = document.getElementById('epSearchHint');

        if (searchInput && searchDropdown) {
            searchInput.addEventListener('focus', function () {
                searchDropdown.classList.add('show');
            });

            searchInput.addEventListener('input', function () {
                var query = (searchInput.value || '').trim().toLowerCase();
                searchDropdown.classList.add('show');
                if (searchHint) {
                    searchHint.textContent = query ? "Results for '" + query + "'" : "Type to filter";
                }

                var items = searchDropdown.querySelectorAll('.in-search-item');
                items.forEach(function (item) {
                    var title = item.getAttribute('data-title') || '';
                    var cat = item.getAttribute('data-category') || '';
                    var sub = item.getAttribute('data-sub') || '';
                    if (!query || title.indexOf(query) !== -1 || cat.indexOf(query) !== -1 || sub.indexOf(query) !== -1) {
                        item.style.setProperty('display', 'flex', 'important');
                    } else {
                        item.style.setProperty('display', 'none', 'important');
                    }
                });
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                    searchInput.select();
                    searchDropdown.classList.add('show');
                }
                if (e.key === 'Escape') {
                    searchDropdown.classList.remove('show');
                    document.querySelectorAll('.in-switcher-dropdown, .in-create-dropdown, .in-notif-panel, .in-profile-dropdown').forEach(function (d) {
                        d.classList.remove('show');
                    });
                }
            });
        }

        // Mobile drawer handlers
        var drawerOpenBtn = document.getElementById('epInstructorDrawerOpen');
        var drawerCloseBtn = document.getElementById('epInstructorDrawerClose');
        var drawer = document.getElementById('epInstructorDrawer');
        var backdrop = document.getElementById('epInstructorDrawerBackdrop');

        function openDrawer() {
            if (drawer && backdrop) {
                drawer.classList.add('open');
                backdrop.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeDrawer() {
            if (drawer && backdrop) {
                drawer.classList.remove('open');
                backdrop.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        if (drawerOpenBtn) drawerOpenBtn.addEventListener('click', openDrawer);
        if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);
        if (backdrop) backdrop.addEventListener('click', closeDrawer);
    })();
</script>