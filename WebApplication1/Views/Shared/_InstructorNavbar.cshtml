@using WebApplication1.Models
@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    int? currentCourseId = null;
    if (ViewBag.CurrentCourseId != null)
    {
        currentCourseId = (int)ViewBag.CurrentCourseId;
    }
    else if (Request.QueryString["courseId"] != null && int.TryParse(Request.QueryString["courseId"], out int qCid))
    {
        currentCourseId = qCid;
    }
    else if (ViewContext.RouteData.Values["id"] != null && int.TryParse(ViewContext.RouteData.Values["id"].ToString(), out int rId))
    {
        currentCourseId = rId;
    }

    var vm = InstructorNavbarViewModel.LoadForUser(currentUser, currentCourseId);

    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    string currentTab = Request.QueryString["tab"] ?? "";

    bool isDashboard = string.Equals(currentController, "Instructor", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) && string.IsNullOrEmpty(currentTab);
    bool isMyCourses = (string.Equals(currentController, "Instructor", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAction, "Modules", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAction, "Create", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAction, "Edit", StringComparison.OrdinalIgnoreCase))) || string.Equals(currentTab, "courses", StringComparison.OrdinalIgnoreCase);
    bool isStudents = string.Equals(currentTab, "students", StringComparison.OrdinalIgnoreCase);
    bool isAnalytics = string.Equals(currentTab, "analytics", StringComparison.OrdinalIgnoreCase) || string.Equals(currentTab, "earnings", StringComparison.OrdinalIgnoreCase);
    bool isAssessments = string.Equals(currentController, "Instructor", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAction, "Submissions", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAction, "ManageQuiz", StringComparison.OrdinalIgnoreCase));
    bool isResources = string.Equals(currentTab, "resources", StringComparison.OrdinalIgnoreCase);
}

<!-- Self-Contained Resilient Design System for EduPulse Instructor Workspace Header -->
<style>
    /* ==========================================================================
       EduPulse Instructor Workspace Header (Studio Architecture)
       Inspired by YouTube Studio, Stripe Dashboard, and Linear.
       Focused strictly on content creation, student management, and analytics.
       ========================================================================== */

    .in-header-wrapper {
        position: sticky;
        overflow-x: clip;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        background-color: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        z-index: 1040;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        transition: box-shadow 0.2s ease;
    }

    .in-header-wrapper.in-scrolled {
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
    }

    .in-container {
        height: 60px;
        max-width: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.25rem;
        gap: 0.65rem;
    }

    /* Left Section: Brand & Primary Management Navigation */
    .in-left {
        display: flex;
        align-items: center;
        gap: 1.15rem;
        flex-shrink: 0;
    }

    .in-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: #0f172a;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        transition: opacity 0.15s ease;
    }

    .in-brand:hover {
        opacity: 0.88;
        color: #0f172a;
        text-decoration: none;
    }

    .in-brand-mark {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
        color: #ffffff;
    }

    .in-studio-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        margin-left: 0.1rem;
    }

    .in-nav {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

