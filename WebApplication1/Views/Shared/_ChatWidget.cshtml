@* 
    _ChatWidget.cshtml
    EduPulse AI Academic Workspace Copilot & Instructor Studio Assistant.
    Inspired by Linear, Notion AI, GitHub Copilot, and Coursera Business.
    Grounded in enrolled curriculums, lecture slides, and assignment rubrics.
*@

@{
    var currentUser = Session["CurrentUser"] as WebApplication1.Models.User;
    string userRole = currentUser != null ? currentUser.Role : (Session["UserRole"] as string ?? "Student");
    string userName = currentUser != null ? currentUser.FullName : (Session["UserName"] as string ?? "Learner");

    bool isInstructor = string.Equals(userRole, "Instructor", StringComparison.OrdinalIgnoreCase);
    bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isStudent = !isInstructor && !isAdmin;

    string launcherLabel = isInstructor ? "Instructor Copilot" : isAdmin ? "Admin Workspace AI" : "Ask Course AI";
    string modeBadgeText = isInstructor ? "Instructor Studio Mode" : isAdmin ? "Admin Workspace Mode" : "Socratic Tutor";
    string modeBadgeClass = isInstructor ? "ep-chat-badge-instructor" : isAdmin ? "ep-chat-badge-admin" : "ep-chat-badge-student";
}

<!-- Self-Contained Resilient Design System for EduPulse AI Academic Copilot -->
<style>
    /* ==========================================================================
       EduPulse AI Academic Workspace Copilot (Bespoke SaaS Design System)
       ========================================================================== */

    /* Floating Launcher Button */
    .ep-chat-launcher {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 1050;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.65rem 1.15rem 0.65rem 0.85rem;
        background-color: #0f172a;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 9999px;
        box-shadow: 0 4px 14px 0 rgba(15, 23, 42, 0.18), 0 1px 3px 0 rgba(15, 23, 42, 0.08);
        cursor: pointer;
        font-family: inherit;
        font-size: 0.825rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
        user-select: none;
    }

    .ep-chat-launcher:hover {
        background-color: #1e293b;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -2px rgba(15, 23, 42, 0.25);
        color: #ffffff;
        text-decoration: none;
    }

    .ep-chat-launcher:active {
        transform: translateY(0);
    }

    .ep-launcher-icon-box {
        position: relative;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ep-launcher-status-dot {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #10b981;
        border: 1.5px solid #0f172a;
    }

    .ep-launcher-kbd {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.15rem 0.35rem;
        background-color: rgba(255, 255, 255, 0.14);
        border-radius: 4px;
        color: #94a3b8;
        letter-spacing: 0;
        line-height: 1;
    }

    /* Backdrop Overlay for Mobile / Dismissal */
    .ep-chat-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.28);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        z-index: 1055;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
    }

    .ep-chat-backdrop.open {
        opacity: 1;
        pointer-events: auto;
    }

    /* Slide-Out Drawer Shell */
    .ep-chat-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 440px;
        max-width: 100vw;
        height: 100vh;
        background-color: #ffffff;
        border-left: 1px solid #e2e8f0;
        box-shadow: -10px 0 35px 0 rgba(15, 23, 42, 0.08);
        z-index: 1060;
        display: flex;
        flex-direction: column;
        transform: translateX(105%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
    }

    .ep-chat-drawer.open {
        transform: translateX(0);
    }

    /* Drawer Header */
    .ep-chat-header {
        padding: 1rem 1.25rem;
        background-color: #ffffff;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .ep-chat-header-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .ep-chat-emblem {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background-color: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ep-chat-title-group {
        display: flex;
        flex-direction: column;
    }

    .ep-chat-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .ep-chat-role-badge {
        display: inline-block;
        font-size: 0.675rem;
        font-weight: 600;
        padding: 0.1rem 0.45rem;
        border-radius: 4px;
        margin-top: 0.15rem;
        width: fit-content;
    }

    .ep-chat-badge-student {
        background-color: #f0f9ff;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .ep-chat-badge-instructor {
        background-color: #fefce8;
        color: #854d0e;
        border: 1px solid #fef08a;
    }

    .ep-chat-badge-admin {
        background-color: #faf5ff;
        color: #6b21a8;
        border: 1px solid #e9d5ff;
    }

    .ep-chat-header-actions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .ep-chat-icon-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        background: transparent;
        border: 1px solid transparent;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .ep-chat-icon-btn:hover {
        background-color: #f8fafc;
        border-color: #e2e8f0;
        color: #0f172a;
    }

    /* Context Scope Sub-Header */
    .ep-chat-context-bar {
        padding: 0.5rem 1.25rem;
        background-color: #f8fafc;
        border-bottom: 1px solid #eef0f3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.725rem;
        color: #475569;
        flex-shrink: 0;
    }

    .ep-context-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        max-width: 290px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 500;
    }

    .ep-context-indicator {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #0284c7;
        flex-shrink: 0;
    }

    /* Message Scroll Body */
    .ep-chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem;
        background-color: #fafbfc;
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
    }

    /* Message Bubbles */
    .ep-msg-row-user {
        display: flex;
        justify-content: flex-end;
    }

    .ep-msg-bubble-user {
        max-width: 84%;
        padding: 0.75rem 1rem;
        background-color: #0f172a;
        color: #ffffff;
        border-radius: 14px 14px 2px 14px;
        font-size: 0.825rem;
        line-height: 1.5;
        box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.08);
        word-break: break-word;
    }

    .ep-msg-row-assistant {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 92%;
    }

    .ep-msg-card-assistant {
        width: 100%;
        padding: 0.95rem 1.1rem;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px 14px 14px 2px;
        box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.04);
        font-size: 0.825rem;
        color: #1e293b;
        line-height: 1.6;
        word-break: break-word;
    }

    /* Trust Telemetry Micro-Pills */
    .ep-telemetry-tray {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 0.65rem;
    }

    .ep-telemetry-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.675rem;
        font-weight: 600;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        letter-spacing: -0.01em;
    }

    .ep-pill-cache {
        background-color: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .ep-pill-grounded {
        background-color: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .ep-pill-socratic {
        background-color: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    .ep-pill-eval {
        background-color: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .ep-pill-offline {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

    /* Interactive Citation Chips */
    .ep-citations-tray {
        margin-top: 0.75rem;
        padding-top: 0.65rem;
        border-top: 1px solid #f1f5f9;
    }

    .ep-citations-label {
        font-size: 0.675rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
        margin-bottom: 0.4rem;
    }

    .ep-citation-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .ep-citation-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.55rem;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        font-size: 0.725rem;
        font-weight: 500;
        color: #334155;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .ep-citation-chip:hover {
        background-color: #ffffff;
        border-color: #0f172a;
        color: #0f172a;
        transform: translateY(-1px);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
        text-decoration: none;
    }

    /* Specialized Structured Output Cards (Instructor Dossiers) */
    .ep-card-dossier {
        margin-top: 0.65rem;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.85rem;
    }

    .ep-dossier-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.65rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #eef0f3;
    }

    .ep-dossier-title {
        font-weight: 700;
        font-size: 0.8rem;
        color: #0f172a;
    }

    .ep-dossier-score {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.5rem;
        background-color: #0f172a;
        color: #ffffff;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.75rem;
    }

    .ep-dossier-section {
        margin-bottom: 0.5rem;
    }

    .ep-dossier-section-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 0.25rem;
    }

    .ep-dossier-btn {
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.45rem 0.75rem;
        background-color: #0f172a;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: background-color 0.15s ease;
    }

    .ep-dossier-btn:hover {
        background-color: #1e293b;
    }

    /* Purpose-Built Educational Guardrail & Error Banners */
    .ep-alert-card {
        width: 100%;
        padding: 0.85rem 1rem;
        border-radius: 10px;
        font-size: 0.8rem;
        line-height: 1.5;
        display: flex;
        gap: 0.65rem;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .ep-alert-socratic {
        background-color: #fefce8;
        border: 1px solid #fde68a;
        color: #854d0e;
    }

    .ep-alert-security {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .ep-alert-privacy {
        background-color: #f5f3ff;
        border: 1px solid #ddd6fe;
        color: #5b21b6;
    }

    .ep-alert-cooldown {
        background-color: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
    }

    /* Starter Suggestion Chips (Zero-State) */
    .ep-starter-container {
        padding: 0.5rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .ep-starter-heading {
        font-size: 0.725rem;
        font-weight: 600;
        color: #64748b;
        letter-spacing: -0.01em;
    }

    .ep-starter-chips {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .ep-starter-chip {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 0.75rem;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.775rem;
        font-weight: 500;
        color: #334155;
        text-align: left;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .ep-starter-chip:hover {
        background-color: #f8fafc;
        border-color: #0f172a;
        color: #0f172a;
        transform: translateY(-1px);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    /* Fixed Input Dock at Bottom */
    .ep-chat-input-dock {
        padding: 0.85rem 1.25rem 1rem;
        background-color: #ffffff;
        border-top: 1px solid #eef0f3;
        flex-shrink: 0;
    }

    .ep-chat-form {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        position: relative;
    }

    .ep-chat-textarea {
        flex: 1;
        min-height: 40px;
        max-height: 120px;
        padding: 0.6rem 0.85rem;
        font-size: 0.825rem;
        font-family: inherit;
        color: #0f172a;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        resize: none;
        line-height: 1.45;
        transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .ep-chat-textarea::placeholder {
        color: #94a3b8;
    }

    .ep-chat-textarea:focus {
        background-color: #ffffff;
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.06);
    }

    .ep-chat-send-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background-color: #0f172a;
        color: #ffffff;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 0.15s ease, opacity 0.15s ease;
    }

    .ep-chat-send-btn:hover:not(:disabled) {
        background-color: #1e293b;
    }

    .ep-chat-send-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .ep-chat-dock-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.45rem;
        font-size: 0.675rem;
        color: #94a3b8;
    }

    /* Live Cooldown Ticker Banner */
    .ep-cooldown-ticker {
        display: none;
        padding: 0.4rem 0.75rem;
        margin-bottom: 0.5rem;
        background-color: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 6px;
        font-size: 0.725rem;
        color: #9a3412;
        font-weight: 500;
        align-items: center;
        justify-content: space-between;
    }

    .ep-cooldown-ticker.show {
        display: flex;
    }

    /* Loading Shimmer Card */
    .ep-loading-shimmer {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px 14px 14px 2px;
        font-size: 0.775rem;
        color: #64748b;
    }

    .ep-loading-pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #0f172a;
        animation: epPulse 1.2s infinite ease-in-out;
    }

    @@keyframes epPulse {
        0%, 100% { opacity: 0.3; transform: scale(0.85); }
        50% { opacity: 1; transform: scale(1.15); }
    }

    /* Mobile Responsive Adaptation */
    @@media (max-width: 767px) {
        .ep-chat-drawer {
            width: 100vw;
            border-left: none;
        }

        .ep-chat-launcher {
            bottom: 1rem;
            right: 1rem;
            padding: 0.55rem 0.95rem;
            font-size: 0.775rem;
        }

        .ep-msg-bubble-user {
            max-width: 88%;
        }

        .ep-msg-card-assistant {
            max-width: 95%;
        }
    }
</style>

<!-- Floating AI Academic Workspace Launcher Button -->
<button id="epChatLauncher" class="ep-chat-launcher" onclick="toggleAiDrawer()" aria-label="Open Course AI Assistant">
    <span class="ep-launcher-icon-box">
        <!-- Architectural Emblem SVG (Spark-free, Clean Compass Mark) -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
            <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span class="ep-launcher-status-dot" title="EduPulse AI Service Online"></span>
    </span>
    <span>@launcherLabel</span>
    <span class="ep-launcher-kbd d-none d-sm-inline">Ctrl /</span>
</button>

<!-- Backdrop Overlay for Mobile Dismissal -->
<div id="epChatBackdrop" class="ep-chat-backdrop" onclick="toggleAiDrawer()"></div>

<!-- Slide-Out AI Academic Workspace Drawer -->
<aside id="epChatDrawer" class="ep-chat-drawer" role="dialog" aria-modal="true" aria-label="Course AI Assistant Workspace">
    
    <!-- Drawer Header -->
    <header class="ep-chat-header">
        <div class="ep-chat-header-brand">
            <div class="ep-chat-emblem">
                <svg width="18" height="18" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="28" height="28" rx="6" fill="#0F172A" />
                    <path d="M7 10C7 8.89543 7.89543 8 9 8H19C20.1046 8 21 8.89543 21 10V18.5C21 19.6046 20.1046 20.5 19 20.5H9C7.89543 20.5 7 19.6046 7 18.5V10Z" stroke="white" stroke-width="1.25" stroke-opacity="0.3" />
                    <path d="M14 8V20.5M7 16.5C9.2 15.2 11.4 15.2 14 16.5C16.6 15.2 18.8 15.2 21 16.5" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="ep-chat-title-group">
                <span class="ep-chat-title">EduPulse Assistant</span>
                <span class="ep-chat-role-badge @modeBadgeClass">@modeBadgeText</span>
            </div>
        </div>

        <div class="ep-chat-header-actions">
            <button type="button" class="ep-chat-icon-btn" onclick="clearAiChat()" title="Clear conversation history" aria-label="Clear Chat History">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
            </button>
            <button type="button" class="ep-chat-icon-btn" onclick="toggleAiDrawer()" title="Close Assistant" aria-label="Close Assistant">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </header>

    <!-- Context Scope Sub-Header -->
    <div class="ep-chat-context-bar">
        <span class="ep-context-pill" id="epChatContextPill">
            <span class="ep-context-indicator"></span>
            <span id="epActiveCourseTitle">Global Workspace &bull; All Enrolled Curriculums</span>
        </span>
        <span class="text-muted d-inline-flex align-items-center gap-1" style="font-size: 0.675rem;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Grounded
        </span>
    </div>

    <!-- Message Scroll Body -->
    <div id="epChatBody" class="ep-chat-body">
        <!-- Initial Welcome Message -->
        <div class="ep-msg-row-assistant">
            <div class="ep-msg-card-assistant">
                <div class="ep-telemetry-tray">
                    <span class="ep-telemetry-pill ep-pill-grounded">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Grounded in Syllabus Notes</span>
                    </span>
                    @if (isInstructor || isAdmin)
                    {
                        <span class="ep-telemetry-pill ep-pill-eval">
                            <span>Operations & Grading Active</span>
                        </span>
                    }
                    @if (isStudent)
                    {
                        <span class="ep-telemetry-pill ep-pill-socratic">
                            <span>Socratic Mode Active</span>
                        </span>
                    }
                </div>

                <div>
                    Hello <strong>@userName</strong>! I am your curriculum-grounded assistant.
                    @if (isInstructor || isAdmin)
                    {
                        <span>You can ask me to evaluate student assignments, review your grading backlog, generate multiple-choice quizzes, or display topic confusion analytics.</span>
                    }
                    @if (isStudent)
                    {
                        <span>I am connected to your enrolled course notes, lecture slides, and assignment rubrics. Ask me to clarify a concept, provide step-by-step guidance on a homework problem, or explain a technical principle.</span>
                    }
                </div>
            </div>
        </div>

        <!-- Role-Specific Starter Suggestion Chips (Empty State) -->
        <div id="epStarterChips" class="ep-starter-container">
            <span class="ep-starter-heading">Recommended Queries</span>
            <div class="ep-starter-chips">
                @if (isInstructor || isAdmin)
                {
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('How many students are enrolled and how many assignments do I have to evaluate?')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                        <span>How many assignments do I have to evaluate?</span>
                    </button>
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('Evaluate Rahul Verma\'s assignment submission')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span>Evaluate Rahul Verma's assignment submission</span>
                    </button>
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('Show student friction heatmap for Course 2')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                        <span>Show student learning friction heatmap for Course 2</span>
                    </button>
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('Draft a 3-question multiple choice quiz with answer key based on this course.')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <span>Generate a multiple-choice quiz from course slides</span>
                    </button>
                }
                @if (isStudent)
                {
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('What core concepts are covered in this course curriculum?')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                        </svg>
                        <span>What core concepts are covered in this curriculum?</span>
                    </button>
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('Can you explain the difference between GET and POST in HTTP idempotency?')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                        </svg>
                        <span>Explain GET vs POST HTTP idempotency</span>
                    </button>
                    <button type="button" class="ep-starter-chip" onclick="sendQuickQuestion('Give me a conceptual hint for the latest assignment without writing the full code.')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span>Give me a conceptual hint for the assignment</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Fixed Input Dock at Bottom -->
    <div class="ep-chat-input-dock">
        <!-- Rate-Limit Cooldown Banner -->
        <div id="epCooldownTicker" class="ep-cooldown-ticker">
            <span>Rate limit cooldown active. Please wait <strong id="epCooldownSecs">15</strong>s.</span>
            <span style="font-size: 0.65rem;">Max 5 queries / 30s</span>
        </div>

        <form id="epChatForm" onsubmit="submitAiQuestion(event)" class="ep-chat-form">
            <textarea id="epChatInput" 
                      class="ep-chat-textarea" 
                      rows="1" 
                      placeholder="@(isInstructor || isAdmin ? "Ask about backlog, 'Evaluate [Student]', or queries..." : "Ask a question about this curriculum or assignment...")" 
                      required 
                      aria-label="Ask Course AI"></textarea>
            <button type="submit" id="epChatSendBtn" class="ep-chat-send-btn" aria-label="Send Query">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="19" x2="12" y2="5"></line>
                    <polyline points="5 12 12 5 19 12"></polyline>
                </svg>
            </button>
        </form>

        <div class="ep-chat-dock-footer">
            <span>Socratic integrity active &bull; Press Enter to send</span>
            <span>Gemini 3.5 + ChromaDB</span>
        </div>
    </div>
</aside>

<!-- Embedded Robust Interactivity & Specialized Card Renderers -->
<script>
    (function () {
        let isDrawerOpen = false;
        let cooldownTimer = null;

        // Global drawer toggle handler
        window.toggleAiDrawer = function () {
            isDrawerOpen = !isDrawerOpen;
            const drawer = document.getElementById('epChatDrawer');
            const backdrop = document.getElementById('epChatBackdrop');
            if (drawer) drawer.classList.toggle('open', isDrawerOpen);
            if (backdrop) backdrop.classList.toggle('open', isDrawerOpen);

            if (isDrawerOpen) {
                updateCourseContextLabel();
                const input = document.getElementById('epChatInput');
                if (input) setTimeout(() => input.focus(), 250);
            }
        };

        // Course Scoping Updater
        function updateCourseContextLabel() {
            const titleSpan = document.getElementById('epActiveCourseTitle');
            if (!titleSpan) return;
            if (window.CURRENT_COURSE_TITLE) {
                titleSpan.textContent = 'Course Scoped: ' + window.CURRENT_COURSE_TITLE;
            } else {
                titleSpan.innerHTML = 'Global Workspace &bull; All Enrolled Curriculums';
            }
        }

        // Reset / Clear Chat Handler
        window.clearAiChat = function () {
            const body = document.getElementById('epChatBody');
            if (!body) return;
            body.innerHTML = `
                <div class="ep-msg-row-assistant">
                    <div class="ep-msg-card-assistant">
                        <div class="text-muted" style="font-size: 0.775rem;">
                            Conversation history cleared. How can I assist your learning today?
                        </div>
                    </div>
                </div>
            `;
        };

        // Quick Starter Query Handler
        window.sendQuickQuestion = function (queryText) {
            const input = document.getElementById('epChatInput');
            if (!input) return;
            input.value = queryText;
            window.submitAiQuestion(new Event('submit'));
        };

        // External Hook for Classroom Page / Buttons
        window.openAiDrawerWithPrompt = function (promptText) {
            const drawer = document.getElementById('epChatDrawer');
            if (drawer && !drawer.classList.contains('open')) {
                window.toggleAiDrawer();
            }
            if (promptText) {
                const input = document.getElementById('epChatInput');
                if (input) {
                    input.value = promptText;
                    window.submitAiQuestion(new Event('submit'));
                }
            }
        };

        // Auto-resizing textarea handler
        const textarea = document.getElementById('epChatInput');
        if (textarea) {
            textarea.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });

            // Enter sends, Shift+Enter new line
            textarea.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    window.submitAiQuestion(e);
                }
            });
        }

        // Global Keyboard Shortcut: Ctrl + / or Cmd + /
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === '/') {
                e.preventDefault();
                window.toggleAiDrawer();
            }
            if (e.key === 'Escape' && isDrawerOpen) {
                window.toggleAiDrawer();
            }
        });

        // Submit Question AJAX Routine
        window.submitAiQuestion = async function (e) {
            if (e) e.preventDefault();
            const input = document.getElementById('epChatInput');
            const query = input ? input.value.trim() : '';
            if (!query) return;

            const body = document.getElementById('epChatBody');
            const sendBtn = document.getElementById('epChatSendBtn');

            // Remove zero-state starter chips on first submission
            const starter = document.getElementById('epStarterChips');
            if (starter) starter.remove();

            // Append User Message Bubble
            body.innerHTML += `
                <div class="ep-msg-row-user">
                    <div class="ep-msg-bubble-user">
                        ${escapeHtml(query)}
                    </div>
                </div>
            `;

            input.value = '';
            input.style.height = 'auto';
            input.disabled = true;
            if (sendBtn) sendBtn.disabled = true;
            body.scrollTop = body.scrollHeight;

            // Append Animated Loading Shimmer
            const loadingId = 'loading_' + Date.now();
            body.innerHTML += `
                <div id="${loadingId}" class="ep-msg-row-assistant">
                    <div class="ep-loading-shimmer">
                        <span class="ep-loading-pulse-dot"></span>
                        <span>Grounding query with course notes & formulating response...</span>
                    </div>
                </div>
            `;
            body.scrollTop = body.scrollHeight;

            try {
                const activeCourseId = window.CURRENT_COURSE_ID || 0;

                const res = await fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Query: query, CourseId: activeCourseId })
                });

                const json = await res.json();
                const loadingElem = document.getElementById(loadingId);
                if (loadingElem) loadingElem.remove();

                if (json.success && json.data) {
                    renderAssistantResponse(body, json.data);
                } else {
                    renderCalloutAlert(body, json.message || 'Unable to formulate response at this time.');
                }
            } catch (err) {
                const loadingElem = document.getElementById(loadingId);
                if (loadingElem) loadingElem.remove();
                renderCalloutAlert(body, 'Could not reach the AI service. Ensure the Python RAG microservice is running on port 8000.');
            } finally {
                input.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
                input.focus();
                body.scrollTop = body.scrollHeight;
            }
        };

        // Render Assistant Response with Telemetry & Citations
        function renderAssistantResponse(body, data) {
            let telemetryHtml = '';
            if (data.cached) {
                telemetryHtml += `
                    <span class="ep-telemetry-pill ep-pill-cache">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                        <span>Instant Semantic Cache (<5ms)</span>
                    </span>`;
            } else if (data.model_used === 'offline-extractive-fallback') {
                telemetryHtml += `
                    <span class="ep-telemetry-pill ep-pill-offline">
                        <span>Tier-3 Extractive Fallback</span>
                    </span>`;
            } else if (data.role === 'instructor' || data.role === 'admin') {
                telemetryHtml += `
                    <span class="ep-telemetry-pill ep-pill-eval">
                        <span>Instructor Studio Action</span>
                    </span>`;
            } else {
                telemetryHtml += `
                    <span class="ep-telemetry-pill ep-pill-grounded">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Verified Curriculum Citation</span>
                    </span>`;
            }

            // Citations tray
            let citationsHtml = '';
            if (data.citations && data.citations.length > 0) {
                citationsHtml = `
                    <div class="ep-citations-tray">
                        <div class="ep-citations-label">Referenced Course Documents</div>
                        <div class="ep-citation-chips">
                            ${data.citations.map(c => `
                                <a href="javascript:void(0)" class="ep-citation-chip" title="Source: ${escapeHtml(c.source_file)}">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                    </svg>
                                    <span>${escapeHtml(c.source_file)} (p.${c.page_number || 1})</span>
                                </a>
                            `).join('')}
                        </div>
                    </div>
                `;
            }

            // Check if response contains an AI Assignment Evaluation Dossier
            let contentHtml = formatMarkdown(data.answer);
            const isEvaluation = data.answer && data.answer.includes('Assignment Evaluation') && data.answer.includes('Recommended Score:');

            if (isEvaluation) {
                contentHtml = parseEvaluationCard(data.answer);
            }

            body.innerHTML += `
                <div class="ep-msg-row-assistant">
                    <div class="ep-msg-card-assistant">
                        <div class="ep-telemetry-tray">${telemetryHtml}</div>
                        <div>${contentHtml}</div>
                        ${citationsHtml}
                    </div>
                </div>
            `;
        }

        // Render Purpose-Built Educational Alert Callouts
        function renderCalloutAlert(body, message) {
            let alertClass = 'ep-alert-socratic';
            let iconSvg = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            `;

            // Detect edge cases
            if (message.includes('Security Guardrail') || message.includes('override') || message.includes('jailbreak')) {
                alertClass = 'ep-alert-security';
            } else if (message.includes('Rate limit exceeded') || message.includes('429')) {
                alertClass = 'ep-alert-cooldown';
                triggerCooldownTimer(15);
            } else if (message.includes('Privacy') || message.includes('FERPA')) {
                alertClass = 'ep-alert-privacy';
            }

            body.innerHTML += `
                <div class="ep-msg-row-assistant">
                    <div class="ep-alert-card ${alertClass}">
                        <div class="flex-shrink-0 mt-0.5">${iconSvg}</div>
                        <div>${escapeHtml(message)}</div>
                    </div>
                </div>
            `;
        }

        // Live Cooldown Timer Handler (HTTP 429)
        function triggerCooldownTimer(seconds) {
            const ticker = document.getElementById('epCooldownTicker');
            const secSpan = document.getElementById('epCooldownSecs');
            const input = document.getElementById('epChatInput');
            const sendBtn = document.getElementById('epChatSendBtn');

            if (!ticker || !secSpan) return;
            ticker.classList.add('show');
            if (input) input.disabled = true;
            if (sendBtn) sendBtn.disabled = true;

            let remaining = seconds;
            secSpan.textContent = remaining;

            if (cooldownTimer) clearInterval(cooldownTimer);
            cooldownTimer = setInterval(function () {
                remaining--;
                secSpan.textContent = remaining;
                if (remaining <= 0) {
                    clearInterval(cooldownTimer);
                    ticker.classList.remove('show');
                    if (input) input.disabled = false;
                    if (sendBtn) sendBtn.disabled = false;
                    if (input) input.focus();
                }
            }, 1000);
        }

        // Specialized Parser: AI Assignment Evaluation Dossier Card
        function parseEvaluationCard(rawText) {
            const scoreMatch = rawText.match(/Recommended Score:\s*\*?\*?(\d+)\s*\/\s*100/i);
            const subIdMatch = rawText.match(/submission\s*#?(\d+)/i);
            const score = scoreMatch ? scoreMatch[1] : '90';
            const subId = subIdMatch ? subIdMatch[1] : '';

            let formatted = formatMarkdown(rawText);
            let actionBtnHtml = '';

            if (subId) {
                actionBtnHtml = `
                    <button type="button" class="ep-dossier-btn" onclick="sendQuickQuestion('Submit grade ${score} for submission ${subId}')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Commit ${score} Marks to SQL Gradebook</span>
                    </button>
                `;
            }

            return `
                <div>${formatted}</div>
                ${actionBtnHtml}
            `;
        }

        // Lightweight Markdown Formatter (Headings, Code Blocks, Bold, Bullets, Linebreaks)
        function formatMarkdown(text) {
            if (!text) return '';
            let escaped = escapeHtml(text);

            // Code blocks with syntax container: ```lang code ```
            escaped = escaped.replace(/```(?:[a-zA-Z0-9]+)?\s*([\s\S]*?)```/g, function (match, p1) {
                return '<div class="my-2 rounded" style="background:#0f172a; border: 1px solid #1e293b; overflow:hidden;">' +
                       '<div class="d-flex justify-content-between align-items-center px-3 py-1 bg-dark text-muted small" style="font-size:0.65rem;">' +
                       '<span>CODE</span>' +
                       '<button type="button" class="btn btn-link p-0 text-muted small text-decoration-none" onclick="navigator.clipboard.writeText(this.closest(\'div\').nextElementSibling.innerText)">Copy</button>' +
                       '</div>' +
                       '<pre class="p-3 m-0 text-white overflow-auto" style="font-size: 0.75rem; font-family: Consolas, monospace;"><code>' + p1 + '</code></pre>' +
                       '</div>';
            });

            // Inline code: `code`
            escaped = escaped.replace(/`([^`]+)`/g, '<code style="background:#f1f5f9; color:#0f172a; padding:0.15rem 0.35rem; border-radius:4px; font-size:0.775rem; border:1px solid #e2e8f0;">$1</code>');

            // Bold: **text**
            escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong style="color:#0f172a; font-weight:700;">$1</strong>');

            // Headings: ###
            escaped = escaped.replace(/###\s*([^\n]+)/g, '<div style="font-weight:700; font-size:0.875rem; color:#0f172a; margin-top:0.65rem; margin-bottom:0.25rem;">$1</div>');
            escaped = escaped.replace(/##\s*([^\n]+)/g, '<div style="font-weight:700; font-size:0.925rem; color:#0f172a; margin-top:0.75rem; margin-bottom:0.35rem;">$1</div>');

            // Bullet points: * or -
            escaped = escaped.replace(/(?:^|\n)[*-]\s+([^\n]+)/g, '<div style="margin-left: 0.75rem; display:flex; gap:0.4rem; margin-top:0.15rem;"><span>&bull;</span><span>$1</span></div>');

            // Paragraphs and breaks
            escaped = escaped.replace(/\n\n/g, '<br/><br/>');
            escaped = escaped.replace(/\n/g, '<br/>');

            return escaped;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    })();
</script>
