@model IEnumerable<WebApplication1.Models.StudentDashboardViewModel>

@{
    ViewBag.Title = "My Learning Dashboard & Gradebook";

    int totalCourses = Model != null ? Model.Count() : 0;
    int completedCourses = Model != null ? Model.Count(x => x.Progress >= 100) : 0;
    int avgProgress = totalCourses > 0 ? (int)Model.Average(x => x.Progress) : 0;
    string userName = Session["UserName"] as string ?? "Student";

    var allSubmissions = ViewBag.AllSubmissions as IEnumerable<WebApplication1.Models.StudentSubmission> ?? new List<WebApplication1.Models.StudentSubmission>();
    var allQuizzes = ViewBag.AllQuizAttempts as IEnumerable<WebApplication1.Models.StudentQuizAttempt> ?? new List<WebApplication1.Models.StudentQuizAttempt>();

    int pendingAssignments = allSubmissions.Count(s => s.IsPending);
    int approvedAssignments = allSubmissions.Count(s => s.IsApproved);
}

<!-- Welcome Banner -->
<div class="lms-dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1>Welcome back, @userName! <i class="bi bi-mortarboard-fill text-warning ms-1"></i></h1>
            <p>Track your active curriculums, assignment submissions, verification statuses, and verified certificate grades.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Courses")" class="btn btn-light fw-bold px-4 py-2" style="border-radius: 10px; color: #312e81;">
                <i class="bi bi-compass me-1"></i> Browse More Courses
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Stat Cards -->
<div class="lms-kpi-grid mb-4">
    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-blue">
            <i class="bi bi-book-half"></i>
        </div>
        <div>
            <div class="lms-kpi-number">@totalCourses</div>
            <div class="lms-kpi-label">Enrolled Courses</div>
            <div class="text-muted small" style="font-size: 0.72rem;">@avgProgress% Average Progress</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-emerald">
            <i class="bi bi-trophy-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-success">@completedCourses</div>
            <div class="lms-kpi-label">Completed Courses</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Certificates Unlocked</div>
        </div>
    </div>

    <div class="lms-kpi-card" style="border: 2px solid @(pendingAssignments > 0 ? "#f59e0b" : "#e2e8f0") !important;">
        <div class="lms-kpi-icon" style="background: #fef3c7; color: #d97706;">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-warning">@pendingAssignments</div>
            <div class="lms-kpi-label">Assignments Pending</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Under instructor review</div>
        </div>
    </div>

    <div class="lms-kpi-card">
        <div class="lms-kpi-icon icon-indigo">
            <i class="bi bi-patch-check-fill"></i>
        </div>
        <div>
            <div class="lms-kpi-number text-primary">@approvedAssignments</div>
            <div class="lms-kpi-label">Graded & Approved</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Marks released by mentor</div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-pills mb-4 gap-2" id="dashboardTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active rounded-pill px-4 py-2 fw-semibold" id="courses-tab" data-bs-toggle="pill" data-bs-target="#tab-courses" type="button">
            <i class="bi bi-journal-code me-1"></i> My Courses (@totalCourses)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link rounded-pill px-4 py-2 fw-semibold position-relative" id="assignments-tab" data-bs-toggle="pill" data-bs-target="#tab-assignments" type="button">
            <i class="bi bi-pencil-square me-1"></i> Assignments & Gradebook
            @if (pendingAssignments > 0)
            {
                <span class="badge bg-warning text-dark rounded-pill ms-1">@pendingAssignments pending</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link rounded-pill px-4 py-2 fw-semibold" id="quizzes-tab" data-bs-toggle="pill" data-bs-target="#tab-quizzes" type="button">
            <i class="bi bi-patch-question me-1"></i> Quiz History (@allQuizzes.Count())
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- TAB 1: ENROLLED COURSES -->
    <div class="tab-pane fade show active" id="tab-courses">
        <div class="lms-table-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark m-0">In-Progress Curriculums</h4>
                <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">@totalCourses Enrolled</span>
            </div>

            <div class="table-responsive">
                <table class="lms-modern-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 28%;">Course</th>
                            <th style="width: 14%;">Instructor</th>
                            <th style="width: 15%;">Calculated Grade</th>
                            <th style="width: 20%;">Progress</th>
                            <th style="width: 23%; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var grade = item.GradeSummary;
                                bool isComplete = item.Progress >= 100;

                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Course</div>
                                        <div class="text-muted small">
                                            <span class="badge bg-secondary-subtle text-secondary me-1">@item.Level</span>
                                            @item.DurationWeeks Weeks &bull; Enrolled @item.EnrolledAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark small"><i class="bi bi-person me-1 text-primary"></i>@item.InstructorName</div>
                                    </td>
                                    <td>
                                        @if (grade != null && (grade.QuizzesTaken > 0 || grade.AssignmentsSubmitted > 0))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @(grade.IsPassing ? "bg-success" : "bg-warning text-dark") px-2 py-1 fs-6">
                                                    Grade @grade.LetterGrade
                                                </span>
                                                <span class="fw-bold text-dark small">@grade.FinalScore.ToString("0.0")%</span>
                                            </div>
                                            if (grade.HasPendingAssignments)
                                            {
                                                <div class="text-warning" style="font-size: 0.7rem;"><i class="bi bi-hourglass-split"></i> @grade.AssignmentsPending assignment(s) in review</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border small">No scores yet</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-between small text-muted mb-1">
                                            <span>Milestone</span>
                                            <span class="fw-bold text-dark">@item.Progress%</span>
                                        </div>
                                        <div class="lms-bar-track">
                                            <div class="lms-bar-fill @(isComplete ? "bg-success" : "")" style="width: @item.Progress%;"></div>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Learn", "Courses", new { id = item.CourseId })" class="btn btn-primary rounded-pill px-3">
                                                <i class="bi bi-play-circle me-1"></i> Classroom
                                            </a>
                                            @if (isComplete)
                                            {
                                                <a href="@Url.Action("Certificate", "Courses", new { id = item.CourseId })" class="btn btn-warning rounded-pill px-3 fw-bold text-dark ms-1 shadow-sm">
                                                    <i class="bi bi-award-fill me-1"></i> Certificate
                                                </a>
                                            }
                                            <button type="button" class="btn btn-outline-danger rounded-pill px-2 ms-1" data-bs-toggle="modal" data-bs-target="#dropModal-@item.CourseId" title="Drop Course">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </div>

                                        <!-- Drop Modal -->
                                        <div class="modal fade" id="dropModal-@item.CourseId" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-danger">Drop Course</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        Are you sure you want to drop <strong>@item.Course</strong>? Your progress will be reset.
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                        @using (Html.BeginForm("Unenroll", "Dashboard", FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="courseId" value="@item.CourseId" />
                                                            <button type="submit" class="btn btn-danger btn-sm">Yes, Drop Course</button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-journal-x fs-1 text-muted"></i>
                                    <h5 class="fw-bold text-dark mt-2">You are not enrolled in any courses yet</h5>
                                    <p class="text-muted small">Explore our curriculum catalog to start learning modern tech skills.</p>
                                    <a href="@Url.Action("Index", "Courses")" class="lms-cta-btn">
                                        <i class="bi bi-compass me-1"></i> Explore Catalog
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: ASSIGNMENTS & GRADEBOOK (CATEGORISED BY COURSE) -->
    <div class="tab-pane fade" id="tab-assignments">
        <div class="card border-0 shadow-sm p-4 rounded-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold text-dark mb-1">
                        <i class="bi bi-clipboard-check-fill text-primary me-2"></i> Submitted Assignments & Mentor Verification
                    </h4>
                    <p class="text-muted small mb-0">Track verification status, awarded marks, and personalized instructor feedback categorized by course.</p>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                foreach (var courseItem in Model)
                {
                    var courseSubs = allSubmissions.Where(s => s.CourseId == courseItem.CourseId).ToList();
                    var grade = courseItem.GradeSummary;

                    <div class="card border mb-4 rounded-3 overflow-hidden shadow-sm">
                        <!-- Course Header Bar -->
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4 flex-wrap gap-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-book text-primary me-2"></i> @courseItem.Course
                                </h5>
                                <span class="text-muted small">Instructor: @courseItem.InstructorName</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (grade != null && (grade.QuizzesTaken > 0 || grade.AssignmentsSubmitted > 0))
                                {
                                    <span class="badge bg-primary px-3 py-2 rounded-pill fs-6">
                                        Overall Course Grade: @grade.LetterGrade (@grade.FinalScore.ToString("0.0")%)
                                    </span>
                                }
                                <a href="@Url.Action("Learn", "Courses", new { id = courseItem.CourseId })" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Open Classroom
                                </a>
                            </div>
                        </div>

                        <!-- Submissions Table for this Course -->
                        <div class="card-body p-0">
                            @if (courseSubs.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small">
                                            <tr>
                                                <th style="width: 25%;">Assignment Task</th>
                                                <th style="width: 15%;">Module</th>
                                                <th style="width: 15%;">Submitted On</th>
                                                <th style="width: 18%;">Status & Verification</th>
                                                <th style="width: 12%;">Marks</th>
                                                <th style="width: 15%;">Feedback</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var sub in courseSubs)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-dark">@sub.SubmissionTitle</div>
                                                        @if (!string.IsNullOrWhiteSpace(sub.SubmissionFileUrl))
                                                        {
                                                            <a href="@sub.SubmissionFileUrl" target="_blank" class="small text-primary text-decoration-none">
                                                                <i class="bi bi-link-45deg"></i> Project Repo / Demo
                                                            </a>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary-subtle text-secondary">
                                                            @(sub.ModuleNumber.HasValue ? $"Module {sub.ModuleNumber}" : "Capstone")
                                                        </span>
                                                    </td>
                                                    <td class="text-muted small">
                                                        @sub.SubmittedAt.ToString("MMM dd, yyyy")
                                                    </td>
                                                    <td>
                                                        @if (sub.IsPending)
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill fw-semibold">
                                                                <i class="bi bi-hourglass-split me-1"></i> Marks Pending
                                                            </span>
                                                            <div class="text-muted" style="font-size: 0.7rem;">Under instructor verification</div>
                                                        }
                                                        else if (sub.IsApproved)
                                                        {
                                                            <span class="badge bg-success px-3 py-1 rounded-pill">
                                                                <i class="bi bi-check2-circle me-1"></i> Approved & Verified
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger px-3 py-1 rounded-pill">
                                                                Needs Revision
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (sub.IsPending)
                                                        {
                                                            <span class="text-muted fst-italic small">Pending</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="fw-bold text-success fs-6">
                                                                @sub.MarksObtained / @sub.MaxMarks
                                                            </div>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(sub.InstructorFeedback))
                                                        {
                                                            <div class="small text-muted p-2 bg-light rounded-2 border" style="font-size: 0.78rem;">
                                                                <i class="bi bi-chat-left-quote text-primary me-1"></i> "@sub.InstructorFeedback"
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small fst-italic">No feedback note yet</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted small">
                                    <i class="bi bi-pencil-square fs-3 d-block mb-1 text-muted"></i>
                                    No assignments submitted for this course yet. Go to your <a href="@Url.Action("Learn", "Courses", new { id = courseItem.CourseId })">Classroom</a> to submit practical tasks!
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <p>No active courses found. Enroll in a course to start completing assignments!</p>
                </div>
            }
        </div>
    </div>

    <!-- TAB 3: QUIZ HISTORY -->
    <div class="tab-pane fade" id="tab-quizzes">
        <div class="card border-0 shadow-sm p-4 rounded-4">
            <h4 class="fw-bold text-dark mb-3">
                <i class="bi bi-patch-question-fill text-info me-2"></i> Module Knowledge Check Quizzes
            </h4>

            @if (allQuizzes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course</th>
                                <th>Module #</th>
                                <th>Score</th>
                                <th>Result</th>
                                <th>Attempted On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in allQuizzes)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@q.CourseTitle</td>
                                    <td><span class="badge bg-light text-dark border">Module @q.LessonNumber</span></td>
                                    <td class="fw-bold @(q.IsPassed ? "text-success" : "text-danger")">
                                        @q.ScoreFormatted
                                    </td>
                                    <td>
                                        @if (q.IsPassed)
                                        {
                                            <span class="badge bg-success px-3 py-1 rounded-pill"><i class="bi bi-check-lg me-1"></i> Passed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-1 rounded-pill">Failed (&lt; 60%)</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@q.AttemptedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted small">
                    <i class="bi bi-question-circle fs-1 text-muted d-block mb-2"></i>
                    No quiz attempts recorded yet. Lesson quizzes are available inside each course classroom.
                </div>
            }
        </div>
    </div>
</div>
