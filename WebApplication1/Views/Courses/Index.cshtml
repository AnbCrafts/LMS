<div class="ep-catalog-wrapper">
    <!-- Slim Page Header Surface -->
    <header class="ep-catalog-header">
        <div class="ep-catalog-container">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <span class="ep-catalog-eyebrow">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polygon points="12 8 8 12 12 16 16 12 12 8"></polygon>
                        </svg>
                        Academic Curriculum & Learning Pathways
                    </span>
                    <h1 class="ep-catalog-title">Explore Courses</h1>
                    <p class="ep-catalog-subtitle">
                        Discover professionally curated courses, certifications, and learning paths engineered by verified academic specialists and industry practitioners.
                    </p>
                </div>

                <!-- Mobile Filter Drawer Trigger -->
                <button type="button" class="ep-mobile-filter-trigger btn btn-outline-dark rounded-2 px-3 py-2 fw-semibold d-flex align-items-center gap-2"
                        data-bs-toggle="offcanvas" data-bs-target="#catalogFilterDrawer" aria-controls="catalogFilterDrawer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span>Filter Courses</span>
                    @if (Model.HasActiveFilters)
                    {
                        <span class="badge bg-primary text-white rounded-pill ms-1">Active</span>
                    }
                </button>
            </div>

            <!-- Global Search Box -->
            <div class="ep-search-container">
                <form action="@Url.Action("Index", "Courses")" method="get" id="catalogSearchForm" class="m-0">
                    <!-- Preserve existing filter query params -->
                    <input type="hidden" name="level" value="@Model.Level" />
                    <input type="hidden" name="price" value="@Model.PriceFilter" />
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                    <input type="hidden" name="instructor" value="@Model.SelectedInstructor" />
                    <input type="hidden" name="duration" value="@Model.DurationFilter" />
                    @foreach (var c in Model.SelectedCategories)
                    {
                        <input type="hidden" name="categories" value="@c" />
                    }

                    <div class="ep-search-box">
                        <span class="ep-search-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="text" id="catalogSearchInput" name="search" value="@Model.Search" 
                               class="ep-search-input" 
                               placeholder="Search by course title, instructor, skill, or keyword (e.g., 'React', 'Docker', 'MVC')..." 
                               autocomplete="off" />
                        <span class="ep-search-kbd">Ctrl K</span>
                        <button type="submit" class="ep-search-btn">Search</button>
                    </div>
                </form>
            </div>

            <!-- Popular Category Quick Pills Bar -->
            <div class="ep-quick-pills">
                <span class="ep-quick-pill-label">Popular Categories:</span>
                @{
                    bool isAllSelected = !Model.SelectedCategories.Any();
                }
                <a href="@Url.Action("Index", "Courses", new { search = Model.Search, level = Model.Level, price = Model.PriceFilter, sortBy = Model.SortBy })" 
                   class="ep-quick-pill @(isAllSelected ? "active" : "")">
                    All Courses
                    <span class="ep-quick-pill-count">@Model.TotalCatalogCount</span>
                </a>
                @foreach (var topCat in topCategories)
                {
                    bool isCatActive = Model.SelectedCategories.Contains(topCat.CategoryName, StringComparer.OrdinalIgnoreCase);
                    <a href="@Url.Action("Index", "Courses", new { category = topCat.CategoryName, search = Model.Search, level = Model.Level, price = Model.PriceFilter, sortBy = Model.SortBy })" 
                       class="ep-quick-pill @(isCatActive ? "active" : "")">
                        @topCat.CategoryName
                        <span class="ep-quick-pill-count">@topCat.CourseCount</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="ep-catalog-container">
        <!-- AI Course Matcher & Career Advisor Copilot Card -->
        <section class="ep-copilot-card" aria-label="AI Course Matcher">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span class="ep-copilot-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    AI Course Matcher  Semantic Discovery
                </span>
            </div>

            <h2 class="ep-copilot-title">Describe what you want to achieve or build</h2>
            <p class="ep-copilot-desc">
                Can't find an exact title? Tell our academic advisor your career goal, technical focus, or specific project requirements. Our curriculum vector engine analyzes all course syllabi to match the most direct learning pathways.
            </p>

            <!-- Copilot Query Input -->
            <form id="aiAdvisorForm" onsubmit="submitAiAdvisor(event)" class="m-0">
                <div class="ep-copilot-input-group">
                    <input type="text" id="aiAdvisorQuery" class="ep-copilot-input" 
                           placeholder="E.g., 'I want to build real-time trading dashboards with WebSockets' or 'I want to master container orchestration & CI/CD'..." 
                           required autocomplete="off" />
                    <button type="submit" id="aiAdvisorBtn" class="ep-copilot-btn">
                        <span>Find Matching Courses</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </div>
            </form>

            <!-- Suggestion Chips -->
            <div class="ep-prompt-chips">
                <span class="text-secondary small fw-semibold me-1" style="font-size: 0.76rem;">Try asking:</span>
                <button type="button" class="ep-prompt-chip" onclick="setAiPrompt('I want to build real-time trading dashboards with web sockets and live streaming data')">
                    Real-time Dashboards & WebSockets
                </button>
                <button type="button" class="ep-prompt-chip" onclick="setAiPrompt('I want to master container orchestration, Kubernetes clusters, and automated CI/CD pipelines')">
                    DevOps, Kubernetes & CI/CD
                </button>
                <button type="button" class="ep-prompt-chip" onclick="setAiPrompt('I want to learn enterprise SQL database architecture, stored procedures, and clean backend APIs')">
                    Enterprise SQL & Architecture
                </button>
                <button type="button" class="ep-prompt-chip" onclick="setAiPrompt('I am interested in multi-cloud infrastructure as code on AWS and GCP with Terraform')">
                    Multi-Cloud & Terraform
                </button>
                <button type="button" class="ep-prompt-chip" onclick="setAiPrompt('I want to learn full-stack web development with React and Node.js microservices')">
                    Full-Stack & Microservices
                </button>
            </div>

            <!-- Loading Shimmer State -->
            <div id="aiAdvisorLoading" class="mt-4 p-4 text-center rounded-3 d-none" style="background: #1e293b; border: 1px solid #334155;">
                <div class="spinner-border text-info mb-2" role="status" style="width: 24px; height: 24px;"></div>
                <div class="fw-semibold text-white small">Synthesizing curriculum vectors & analyzing syllabus alignments...</div>
                <div class="text-secondary" style="font-size: 0.8rem;">Querying the RAG microservice for relevant academic modules.</div>
            </div>

            <!-- Dynamic Results Container -->
            <div id="aiAdvisorResults" class="ep-copilot-results d-none">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <span id="aiMatchStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold" style="font-size: 0.76rem;">
                        Direct Domain Match Found
                    </span>
                    <button type="button" class="btn btn-sm text-secondary p-0 text-decoration-none" onclick="clearAiRecommendations()">
                         Close Recommendations & View All Courses
                    </button>
                </div>

                <div class="ep-copilot-rationale-box">
                    <div class="fw-bold text-white small mb-1">Academic Pathway Recommendation:</div>
                    <div id="aiPathwayTip" class="text-light" style="font-size: 0.88rem; line-height: 1.55;"></div>
                </div>

                <div class="row g-3" id="aiRecommendationsGrid"></div>
            </div>
        </section>

        <!-- Main Catalog Layout: 2 Columns on Desktop (Sticky Filter Sidebar + Results Grid) -->
        <div class="row g-4">
            <!-- LEFT COLUMN: Sticky Filter Surface (Desktop) -->
            <div class="col-12 col-lg-3 ep-desktop-sidebar">
                <aside class="ep-filter-surface sticky-top" style="top: 80px; z-index: 10;">
                    <div class="ep-filter-header">
                        <span class="ep-filter-title">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                            </svg>
                            Filters
                        </span>
                        @if (Model.HasActiveFilters)
                        {
                            <a href="@Url.Action("Index", "Courses")" class="ep-filter-reset">Reset Filters</a>
                        }
                    </div>

                    <form action="@Url.Action("Index", "Courses")" method="get" id="catalogSidebarFilterForm">
                        <input type="hidden" name="search" value="@Model.Search" />

                        <!-- Category Filter Group (Dynamic Multi-Select with Instant Category Quick-Filter) -->
                        <div class="ep-filter-group">
                            <span class="ep-filter-label">Categories (@Model.AvailableCategories.Count)</span>
                            <div class="mb-2">
                                <input type="text" id="catQuickSearchDesktop" class="form-control form-control-sm" 
                                       placeholder="Filter categories..." 
                                       onkeyup="filterCategoryList(this.value, 'desktop')" 
                                       style="font-size: 0.8rem; border-color: #e2e8f0;" />
                            </div>
                            <div class="ep-category-scroll" id="catScrollDesktop">
                                @for (int i = 0; i < Model.AvailableCategories.Count; i++)
                                {
                                    var cat = Model.AvailableCategories[i];
                                    bool isChecked = Model.SelectedCategories.Contains(cat.CategoryName, StringComparer.OrdinalIgnoreCase);
                                    <label class="ep-checkbox-row cat-item-desktop" data-name="@cat.CategoryName.ToLower()">
                                        <span class="ep-checkbox-label">
                                            <input type="checkbox" name="categories" value="@cat.CategoryName" 
                                                   class="form-check-input mt-0" @(isChecked ? "checked" : "") 
                                                   onchange="this.form.submit()" />
                                            @cat.CategoryName
                                        </span>
                                        <span class="ep-checkbox-count">@cat.CourseCount</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Difficulty Level Filter -->
                        <div class="ep-filter-group">
                            <span class="ep-filter-label">Difficulty Level</span>
                            <select name="level" class="form-select form-select-sm" onchange="this.form.submit()" style="font-size: 0.85rem; border-color: #cbd5e1;">
                                <option value="All" @(Model.Level == "All" ? "selected" : "")>All Levels</option>
                                <option value="Beginner" @(Model.Level == "Beginner" ? "selected" : "")>Beginner</option>
                                <option value="Intermediate" @(Model.Level == "Intermediate" ? "selected" : "")>Intermediate</option>
                                <option value="Advanced" @(Model.Level == "Advanced" ? "selected" : "")>Advanced</option>
                            </select>
                        </div>

                        <!-- Duration Range Filter -->
                        <div class="ep-filter-group">
                            <span class="ep-filter-label">Duration</span>
                            <select name="duration" class="form-select form-select-sm" onchange="this.form.submit()" style="font-size: 0.85rem; border-color: #cbd5e1;">
                                <option value="All" @(Model.DurationFilter == "All" ? "selected" : "")>All Durations</option>
                                <option value="Short" @(Model.DurationFilter == "Short" ? "selected" : "")>Short (&le; 4 Weeks)</option>
                                <option value="Medium" @(Model.DurationFilter == "Medium" ? "selected" : "")>Medium (5  8 Weeks)</option>
                                <option value="Deep" @(Model.DurationFilter == "Deep" ? "selected" : "")>In-Depth (&gt; 8 Weeks)</option>
                            </select>
                        </div>

                        <!-- Instructor Filter -->
                        @if (Model.AvailableInstructors != null && Model.AvailableInstructors.Any())
                        {
                            <div class="ep-filter-group">
                                <span class="ep-filter-label">Instructor</span>
                                <select name="instructor" class="form-select form-select-sm" onchange="this.form.submit()" style="font-size: 0.85rem; border-color: #cbd5e1;">
                                    <option value="All" @(Model.SelectedInstructor == "All" ? "selected" : "")>All Instructors</option>
                                    @foreach (var inst in Model.AvailableInstructors)
                                    {
                                        <option value="@inst" @(string.Equals(Model.SelectedInstructor, inst, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@inst</option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Pricing Filter -->
                        <div class="ep-filter-group">
                            <span class="ep-filter-label">Tuition / Pricing</span>
                            <div class="d-flex flex-column gap-1">
                                <label class="ep-checkbox-row">
                                    <span class="ep-checkbox-label">
                                        <input type="radio" name="price" value="All" class="form-check-input mt-0" 
                                               @(Model.PriceFilter == "All" ? "checked" : "") onchange="this.form.submit()" />
                                        All Pricing
                                    </span>
                                </label>
                                <label class="ep-checkbox-row">
                                    <span class="ep-checkbox-label">
                                        <input type="radio" name="price" value="Free" class="form-check-input mt-0" 
                                               @(Model.PriceFilter == "Free" ? "checked" : "") onchange="this.form.submit()" />
                                        Free Courses ($0)
                                    </span>
                                </label>
                                <label class="ep-checkbox-row">
                                    <span class="ep-checkbox-label">
                                        <input type="radio" name="price" value="Under50" class="form-check-input mt-0" 
                                               @(Model.PriceFilter == "Under50" ? "checked" : "") onchange="this.form.submit()" />
                                        Under $50
                                    </span>
                                </label>
                                <label class="ep-checkbox-row">
                                    <span class="ep-checkbox-label">
                                        <input type="radio" name="price" value="Over50" class="form-check-input mt-0" 
                                               @(Model.PriceFilter == "Over50" ? "checked" : "") onchange="this.form.submit()" />
                                        $50 and Above
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Certification Option -->
                        <div class="ep-filter-group mb-0">
                            <label class="ep-checkbox-row">
                                <span class="ep-checkbox-label fw-semibold text-dark">
                                    <input type="checkbox" name="certificate" value="true" class="form-check-input mt-0" 
                                           @(Model.CertificateOnly ? "checked" : "") onchange="this.form.submit()" />
                                    Offers Official Certificate
                                </span>
                            </label>
                        </div>
                    </form>
                </aside>
            </div>

            <!-- RIGHT COLUMN: Results Toolbar, Learning Paths, Recommended & Course Grid -->
            <div class="col-12 col-lg-9">
                <!-- Active Filters Bar (If any active) -->
                @if (Model.HasActiveFilters)
                {
                    <div class="ep-active-chips-bar">
                        <span class="ep-active-chips-label">Active Filters:</span>

                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <span class="ep-chip">
                                Search: "@Model.Search"
                                <a href="@Url.Action("Index", "Courses", new { level = Model.Level, categories = Model.SelectedCategories.ToArray(), price = Model.PriceFilter, sortBy = Model.SortBy, instructor = Model.SelectedInstructor, duration = Model.DurationFilter })" class="ep-chip-remove" title="Remove">&times;</a>
                            </span>
                        }

                        @foreach (var selCat in Model.SelectedCategories)
                        {
                            var remCats = Model.SelectedCategories.Where(c => !c.Equals(selCat, StringComparison.OrdinalIgnoreCase)).ToArray();
                            <span class="ep-chip">
                                Category: @selCat
                                <a href="@Url.Action("Index", "Courses", new { search = Model.Search, level = Model.Level, categories = remCats, price = Model.PriceFilter, sortBy = Model.SortBy, instructor = Model.SelectedInstructor, duration = Model.DurationFilter })" class="ep-chip-remove" title="Remove">&times;</a>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Level) && Model.Level != "All")
                        {
                            <span class="ep-chip">
                                Level: @Model.Level
                                <a href="@Url.Action("Index", "Courses", new { search = Model.Search, categories = Model.SelectedCategories.ToArray(), price = Model.PriceFilter, sortBy = Model.SortBy, instructor = Model.SelectedInstructor, duration = Model.DurationFilter })" class="ep-chip-remove" title="Remove">&times;</a>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.DurationFilter) && Model.DurationFilter != "All")
                        {
                            <span class="ep-chip">
                                Duration: @Model.DurationFilter
                                <a href="@Url.Action("Index", "Courses", new { search = Model.Search, categories = Model.SelectedCategories.ToArray(), level = Model.Level, price = Model.PriceFilter, sortBy = Model.SortBy, instructor = Model.SelectedInstructor })" class="ep-chip-remove" title="Remove">&times;</a>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.SelectedInstructor) && Model.SelectedInstructor != "All")
                        {
                            <span class="ep-chip">
                                Instructor: @Model.SelectedInstructor
                                <a href="@Url.Action("Index", "Courses", new { search = Model.Search, categories = Model.SelectedCategories.ToArray(), level = Model.Level, price = Model.PriceFilter, sortBy = Model.SortBy, duration = Model.DurationFilter })" class="ep-chip-remove" title="Remove">&times;</a>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.PriceFilter) && Model.PriceFilter != "All")
                        {
                            <span class="ep-chip">
                                Price: @Model.PriceFilter
                                <a href="@Url.Action("Index", "Courses", new { search = Model.Search, categories = Model.SelectedCategories.ToArray(), level = Model.Level, sortBy = Model.SortBy, instructor = Model.SelectedInstructor, duration = Model.DurationFilter })" class="ep-chip-remove" title="Remove">&times;</a>
                            </span>
                        }

                        <a href="@Url.Action("Index", "Courses")" class="ep-filter-reset ms-auto">Reset All Filters</a>
                    </div>
                }

                <!-- Results Toolbar: Counter + Sort Dropdown -->
                <div class="ep-results-toolbar">
                    <div class="ep-results-count">
                        Showing <strong>@Model.FilteredCount</strong> of <strong>@Model.TotalCatalogCount</strong> courses
                        @if (Model.SelectedCategories.Any())
                        {
                            <span>in <strong>@string.Join(", ", Model.SelectedCategories)</strong></span>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label for="catalogSortBySelect" class="text-secondary small fw-semibold m-0">Sort By:</label>
                        <select id="catalogSortBySelect" class="ep-sort-select" onchange="applySorting(this.value)">
                            <option value="Popular" @(Model.SortBy == "Popular" ? "selected" : "")>Most Popular (Enrollments)</option>
                            <option value="Newest" @(Model.SortBy == "Newest" ? "selected" : "")>Newest Additions</option>
                            <option value="PriceAsc" @(Model.SortBy == "PriceAsc" ? "selected" : "")>Price: Low to High</option>
                            <option value="PriceDesc" @(Model.SortBy == "PriceDesc" ? "selected" : "")>Price: High to Low</option>
                            <option value="TitleAsc" @(Model.SortBy == "TitleAsc" ? "selected" : "")>Title: A to Z</option>
                        </select>
                    </div>
                </div>

                <!-- Curated Learning Paths (Structured Multi-Course Tracks) -->
                @if (!Model.HasActiveFilters)
                {
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h3 class="fw-bold text-dark m-0" style="font-size: 1.15rem;">Curated Learning Paths</h3>
                                <small class="text-secondary">Progress through multi-course sequences to build comprehensive domain mastery.</small>
                            </div>
                        </div>

                        <div class="ep-paths-grid">
                            <!-- Track 1: Full-Stack Architect -->
                            <div class="ep-path-card">
                                <div>
                                    <div class="ep-path-eyebrow">Professional Track</div>
                                    <h4 class="ep-path-title">Enterprise Full-Stack Software Architect</h4>
                                    <p class="ep-path-desc">
                                        End-to-end curriculum covering modern frontend engineering with React 18, backend microservices in ASP.NET Core, and high-performance SQL Server database architecture.
                                    </p>
                                </div>
                                <div class="ep-path-meta">
                                    <span><strong>3</strong> Courses</span>
                                    <span></span>
                                    <span><strong>30</strong> Weeks</span>
                                    <span></span>
                                    <span class="text-success fw-semibold">Certificate Track</span>
                                    <a href="@Url.Action("Index", "Courses", new { category = "Fullstack" })" class="ms-auto text-dark fw-bold text-decoration-none">
                                        Explore Track &rarr;
                                    </a>
                                </div>
                            </div>

                            <!-- Track 2: DevOps & Cloud Specialist -->
                            <div class="ep-path-card">
                                <div>
                                    <div class="ep-path-eyebrow">Specialist Track</div>
                                    <h4 class="ep-path-title">Cloud Infrastructure & DevOps Engineer</h4>
                                    <p class="ep-path-desc">
                                        Master Docker containerization, production Kubernetes orchestration, automated CI/CD pipelines, and multi-cloud infrastructure deployment across AWS and GCP.
                                    </p>
                                </div>
                                <div class="ep-path-meta">
                                    <span><strong>2</strong> Courses</span>
                                    <span></span>
                                    <span><strong>14</strong> Weeks</span>
                                    <span></span>
                                    <span class="text-success fw-semibold">Certificate Track</span>
                                    <a href="@Url.Action("Index", "Courses", new { category = "DevOps" })" class="ms-auto text-dark fw-bold text-decoration-none">
                                        Explore Track &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Recommended For You (Personalized if History Exists, else Curated Picks) -->
                @if (Model.RecommendedCourses != null && Model.RecommendedCourses.Any() && !Model.HasActiveFilters)
                {
                    <div class="ep-recommended-section">
                        <div class="ep-recommended-header">
                            <h3 class="ep-recommended-title">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                                Recommended For You
                            </h3>
                            <span class="text-secondary small">Based on platform curriculum standards and enrolled interests</span>
                        </div>

                        <div class="row g-3">
                            @foreach (var rec in Model.RecommendedCourses)
                            {
                                bool isEnrolledInRec = userEnrollments.ContainsKey(rec.CourseId);
                                <div class="col-12 col-md-4">
                                    <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="badge bg-white text-dark border small">@rec.Category</span>
                                                <span class="text-secondary" style="font-size: 0.75rem;">@rec.DurationWeeks Wks</span>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                                                <a href="@Url.Action("Details", "Courses", new { id = rec.CourseId })" class="text-dark text-decoration-none">
                                                    @rec.Title
                                                </a>
                                            </h5>
                                            <small class="text-secondary d-block mb-3">By @rec.InstructorName</small>
                                        </div>

                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                            <span class="fw-bold text-dark small">@(rec.Price > 0 ? "$" + rec.Price.ToString("0.00") : "Free")</span>
                                            <a href="@Url.Action("Details", "Courses", new { id = rec.CourseId })" class="btn btn-sm btn-dark rounded-2 px-2 py-1" style="font-size: 0.8rem;">
                                                @(isEnrolledInRec ? "Resume Course" : "View Syllabus")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Primary Course Catalog Grid -->
                @if (Model.Courses != null && Model.Courses.Any())
                {
                    <div class="ep-courses-grid" id="courseCardsGrid">
                        @foreach (var course in Model.Courses)
                        {
                            bool isEnrolled = userEnrollments.ContainsKey(course.CourseId);
                            var enrollmentInfo = isEnrolled ? userEnrollments[course.CourseId] : null;
                            bool isCompleted = enrollmentInfo != null && (enrollmentInfo.Progress == 100 || string.Equals(enrollmentInfo.Status, "Completed", StringComparison.OrdinalIgnoreCase));
                            int progressPct = enrollmentInfo != null ? enrollmentInfo.Progress : 0;
                            bool isInstructorOwner = currentUserId.HasValue && 
                                (course.InstructorId == currentUserId.Value || string.Equals(course.InstructorName, currentUserName, StringComparison.OrdinalIgnoreCase));

                            // Generate instructor initials
                            string initials = "IN";
                            if (!string.IsNullOrWhiteSpace(course.InstructorName))
                            {
                                var parts = course.InstructorName.Split(new[] { ' ', '.' }, StringSplitOptions.RemoveEmptyEntries);
                                initials = parts.Length >= 2 
                                    ? $"{parts[0][0]}{parts[1][0]}" 
                                    : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                            }

                            <!-- Single Course Card -->
                            <article class="ep-course-card" data-title="@course.Title.ToLower()" data-instructor="@course.InstructorName.ToLower()" data-category="@course.Category.ToLower()">
                                <!-- Card Thumbnail Header -->
                                <div class="ep-card-thumbnail">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="ep-card-category-pill">@course.Category</span>
                                        <span class="ep-card-level-chip">@course.Level</span>
                                    </div>
                                    <div class="text-white d-flex align-items-center justify-content-between">
                                        <span class="small" style="font-size: 0.75rem; color: #cbd5e1;">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                            @course.DurationWeeks Weeks
                                        </span>
                                        @if (course.Price == 0)
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">Free</span>
                                        }
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="ep-card-body">
                                    <h3 class="ep-card-title">
                                        <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })">
                                            @course.Title
                                        </a>
                                    </h3>
                                    <p class="ep-card-desc">@course.Description</p>

                                    <!-- Instructor Row -->
                                    <div class="ep-card-instructor">
                                        <div class="ep-card-avatar">@initials</div>
                                        <div class="ep-card-instructor-info">
                                            <span class="ep-card-instructor-name">@course.InstructorName</span>
                                            <span class="ep-card-instructor-title">Verified Instructor</span>
                                        </div>
                                    </div>

                                    <!-- Meta Row: Enrolled Count + Verified Rating -->
                                    <div class="ep-card-meta-row">
                                        <span class="ep-card-meta-item">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="9" cy="7" r="4"></circle>
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                            </svg>
                                            @course.TotalEnrolled Enrolled
                                        </span>
                                        <span class="ep-card-meta-item text-dark fw-semibold">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                            </svg>
                                            4.9 <span class="text-secondary fw-normal">(180+)</span>
                                        </span>
                                    </div>
                                </div>

                                <!-- Progress-Aware Card Footer -->
                                <div class="ep-card-footer">
                                    @if (isCompleted)
                                    {
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold small">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="me-1">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Completed (100%)
                                            </span>
                                            <a href="@Url.Action("Certificate", "Courses", new { id = course.CourseId })" class="ep-card-btn ep-btn-completed">
                                                View Certificate
                                            </a>
                                        </div>
                                    }
                                    else if (isEnrolled)
                                    {
                                        <div class="ep-progress-bar-wrap">
                                            <div class="ep-progress-bar-fill" style="width: @progressPct%;"></div>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="text-secondary small fw-semibold">@progressPct% Completed</span>
                                            <a href="@Url.Action("Learn", "Courses", new { id = course.CourseId })" class="ep-card-btn ep-btn-continue">
                                                <span>Continue Learning</span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                                </svg>
                                            </a>
                                        </div>
                                    }
                                    else if (isInstructorOwner)
                                    {
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="text-secondary small fw-semibold">Your Authored Course</span>
                                            <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" class="ep-card-btn ep-btn-manage">
                                                Manage Course
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ep-card-actions">
                                            <div class="ep-card-price">
                                                @(course.Price > 0 ? "$" + course.Price.ToString("0.00") : "Free")
                                            </div>
                                            <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" class="ep-card-btn ep-btn-enroll">
                                                <span>View Curriculum</span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    <polyline points="12 5 19 12 12 19"></polyline>
                                                </svg>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <!-- Friendly, Polished Zero-Result State -->
                    <div class="ep-empty-card">
                        <div class="ep-empty-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </div>
                        <h3 class="ep-empty-title">No courses match your filter criteria</h3>
                        <p class="ep-empty-text">
                            Try clearing category selections, resetting price brackets, or typing a different search keyword. Alternatively, explore our most popular foundational disciplines:
                        </p>
                        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap mb-4">
                            @foreach (var c in topCategories.Take(4))
                            {
                                <a href="@Url.Action("Index", "Courses", new { category = c.CategoryName })" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                    @c.CategoryName
                                </a>
                            }
                        </div>
                        <a href="@Url.Action("Index", "Courses")" class="btn btn-dark rounded-2 px-4 py-2 fw-semibold">
                            Reset All Filters
                        </a>
                    </div>
                }
            </div>
        </div>
    </main>
</div>

<!-- Mobile Offcanvas Filter Drawer (Screens < 992px) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="catalogFilterDrawer" aria-labelledby="catalogFilterDrawerLabel" style="width: 82vw; max-width: 340px;">
    <div class="offcanvas-header border-bottom px-4 py-3">
        <h5 class="offcanvas-title fw-bold text-dark m-0" id="catalogFilterDrawerLabel">Course Filters</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-4">
        <form action="@Url.Action("Index", "Courses")" method="get" id="catalogMobileFilterForm">
            <input type="hidden" name="search" value="@Model.Search" />

            <!-- Categories Mobile -->
            <div class="ep-filter-group">
                <span class="ep-filter-label">Categories (@Model.AvailableCategories.Count)</span>
                <div class="ep-category-scroll">
                    @for (int i = 0; i < Model.AvailableCategories.Count; i++)
                    {
                        var cat = Model.AvailableCategories[i];
                        bool isChecked = Model.SelectedCategories.Contains(cat.CategoryName, StringComparer.OrdinalIgnoreCase);
                        <label class="ep-checkbox-row">
                            <span class="ep-checkbox-label">
                                <input type="checkbox" name="categories" value="@cat.CategoryName" 
                                       class="form-check-input mt-0" @(isChecked ? "checked" : "") />
                                @cat.CategoryName
                            </span>
                            <span class="ep-checkbox-count">@cat.CourseCount</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Difficulty Level Mobile -->
            <div class="ep-filter-group">
                <span class="ep-filter-label">Difficulty Level</span>
                <select name="level" class="form-select form-select-sm">
                    <option value="All" @(Model.Level == "All" ? "selected" : "")>All Levels</option>
                    <option value="Beginner" @(Model.Level == "Beginner" ? "selected" : "")>Beginner</option>
                    <option value="Intermediate" @(Model.Level == "Intermediate" ? "selected" : "")>Intermediate</option>
                    <option value="Advanced" @(Model.Level == "Advanced" ? "selected" : "")>Advanced</option>
                </select>
            </div>

            <!-- Duration Mobile -->
            <div class="ep-filter-group">
                <span class="ep-filter-label">Duration</span>
                <select name="duration" class="form-select form-select-sm">
                    <option value="All" @(Model.DurationFilter == "All" ? "selected" : "")>All Durations</option>
                    <option value="Short" @(Model.DurationFilter == "Short" ? "selected" : "")>Short (&le; 4 Weeks)</option>
                    <option value="Medium" @(Model.DurationFilter == "Medium" ? "selected" : "")>Medium (5  8 Weeks)</option>
                    <option value="Deep" @(Model.DurationFilter == "Deep" ? "selected" : "")>In-Depth (&gt; 8 Weeks)</option>
                </select>
            </div>

            <!-- Pricing Mobile -->
            <div class="ep-filter-group">
                <span class="ep-filter-label">Pricing</span>
                <select name="price" class="form-select form-select-sm">
                    <option value="All" @(Model.PriceFilter == "All" ? "selected" : "")>All Pricing</option>
                    <option value="Free" @(Model.PriceFilter == "Free" ? "selected" : "")>Free Courses</option>
                    <option value="Under50" @(Model.PriceFilter == "Under50" ? "selected" : "")>Under $50</option>
                    <option value="Over50" @(Model.PriceFilter == "Over50" ? "selected" : "")>$50 and Above</option>
                </select>
            </div>

            <div class="d-grid gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-dark rounded-2 py-2 fw-semibold">
                    Apply Filters
                </button>
                <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary rounded-2 py-2 text-center text-decoration-none">
                    Reset All
                </a>
            </div>
        </form>
    </div>
</div>

@section scripts {
<script>
    // Keyboard Shortcut (Ctrl+K / Cmd+K) to focus Search
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            var searchInput = document.getElementById('catalogSearchInput');
            if (searchInput) {
                searchInput.focus();
                searchInput.select();
            }
        }
    });

    // Real-Time Instant Client-Side Category Filter (handles 100+ categories)
    function filterCategoryList(query, mode) {
        var term = (query || '').toLowerCase().trim();
        var rows = document.querySelectorAll('.cat-item-' + mode);
        rows.forEach(function (row) {
            var catName = row.getAttribute('data-name') || '';
            if (!term || catName.indexOf(term) !== -1) {
                row.style.setProperty('display', 'flex', 'important');
            } else {
                row.style.setProperty('display', 'none', 'important');
            }
        });
    }

    // Dynamic Sorting Change
    function applySorting(sortVal) {
        var url = new URL(window.location.href);
        url.searchParams.set('sortBy', sortVal);
        window.location.href = url.toString();
    }

    // AI Course Advisor Quick Prompt Setter
    function setAiPrompt(promptText) {
        var input = document.getElementById('aiAdvisorQuery');
        if (input) {
            input.value = promptText;
            submitAiAdvisor();
        }
    }

    // Submit AI Course Advisor Query to Python RAG Microservice Endpoint
    async function submitAiAdvisor(e) {
        if (e) e.preventDefault();
        var input = document.getElementById('aiAdvisorQuery');
        var query = (input.value || '').trim();
        if (!query) return;

        var btn = document.getElementById('aiAdvisorBtn');
        var loading = document.getElementById('aiAdvisorLoading');
        var results = document.getElementById('aiAdvisorResults');
        var grid = document.getElementById('aiRecommendationsGrid');
        var tip = document.getElementById('aiPathwayTip');
        var statusBadge = document.getElementById('aiMatchStatusBadge');

        btn.disabled = true;
        loading.classList.remove('d-none');
        results.classList.add('d-none');
        grid.innerHTML = '';

        try {
            var res = await fetch('/Courses/AiRecommend', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Interests: query, Level: 'All' })
            });

            var data = await res.json();
            loading.classList.add('d-none');
            btn.disabled = false;

            if (data.success && data.recommendations && data.recommendations.length > 0) {
                results.classList.remove('d-none');
                tip.innerText = data.pathway_tip || 'Follow these recommended courses to acquire relevant engineering skills.';

                if (data.has_exact_match) {
                    statusBadge.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold';
                    statusBadge.innerText = 'Direct Domain Match Found';
                } else {
                    statusBadge.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold';
                    statusBadge.innerText = 'Closest Related Learning Pathway';
                }

                var html = '';
                data.recommendations.forEach(function (r) {
                    var matchScore = r.match_score || 90;
                    var matchClass = matchScore >= 85 ? 'text-success' : 'text-primary';

                    html += `
                        <div class="col-12 col-md-4">
                            <div class="p-3 bg-white text-dark rounded-3 border h-100 d-flex flex-column justify-content-between shadow-sm">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-light text-dark border small">${escapeHtml(r.category || 'Engineering')}</span>
                                        <span class="fw-bold small ${matchClass}">${matchScore}% Match</span>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                                        <a href="/Courses/Details/${r.course_id}" class="text-dark text-decoration-none">
                                            ${escapeHtml(r.title)}
                                        </a>
                                    </h5>
                                    <small class="text-secondary d-block mb-2">By ${escapeHtml(r.instructor || 'Verified Faculty')}</small>
                                    <p class="text-secondary small m-0" style="font-size: 0.8rem; line-height: 1.45;">
                                        ${escapeHtml(r.rationale || '')}
                                    </p>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-3">
                                    <span class="fw-bold text-dark small">${r.price > 0 ? '$' + Number(r.price).toFixed(2) : 'Free'}</span>
                                    <a href="/Courses/Details/${r.course_id}" class="btn btn-sm btn-dark rounded-2 px-3 py-1">
                                        View Syllabus
                                    </a>
                                </div>
                            </div>
                        </div>
                    `;
                });

                grid.innerHTML = html;
                results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                alert(data.message || 'No specific course recommendations could be generated for that query. Try rephrasing your goal.');
            }
        } catch (err) {
            loading.classList.add('d-none');
            btn.disabled = false;
            alert('Could not connect to AI Course Advisor. Please ensure RAG Service is active.');
        }
    }

    function clearAiRecommendations() {
        var results = document.getElementById('aiAdvisorResults');
        if (results) results.classList.add('d-none');
        var input = document.getElementById('aiAdvisorQuery');
        if (input) input.value = '';
    }

    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}
