@model WebApplication1.Models.CourseFilterViewModel

@{
    ViewBag.Title = "Explore Courses & Learning Paths";
    int? currentUserId = Session["UserId"] != null && int.TryParse(Session["UserId"].ToString(), out int uid) ? uid : (int?)null;
    string currentUserRole = Session["UserRole"] as string ?? "";
    string currentUserName = Session["UserName"] as string ?? "";
    var userEnrollments = Model.UserEnrollments ?? new System.Collections.Generic.Dictionary<int, WebApplication1.Models.StudentDashboardViewModel>();
    var topCategories = Model.AvailableCategories.Take(6).ToList();
}

