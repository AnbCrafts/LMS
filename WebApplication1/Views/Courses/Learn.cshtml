@model WebApplication1.Models.CoursePlayerViewModel

@{
    ViewBag.Title = Model.Course.Title + " - Classroom Player";
    int activeNum = Model.ActiveLesson.LessonNumber;
    int nextProgress = Math.Min(100, activeNum * 20);
    var quizQuestions = ViewBag.QuizQuestions as IEnumerable<WebApplication1.Models.QuizQuestion> ?? new List<WebApplication1.Models.QuizQuestion>();
    bool hasQuiz = quizQuestions.Any();
    bool isOwner = ViewBag.IsOwner != null && (bool)ViewBag.IsOwner;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
    var activeSub = ViewBag.ActiveModuleSubmission as WebApplication1.Models.StudentSubmission;

    bool hasPassedQuiz = ViewBag.HasPassedQuiz != null && (bool)ViewBag.HasPassedQuiz;
    bool hasAssignment = ViewBag.HasAssignment != null && (bool)ViewBag.HasAssignment;
    bool hasSubmittedAssignment = ViewBag.HasSubmittedAssignment != null && (bool)ViewBag.HasSubmittedAssignment;
    bool canAdvanceModule = ViewBag.CanAdvanceModule != null && (bool)ViewBag.CanAdvanceModule;
}

<!-- Top Player Bar -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
        @if (isOwner)
        {
            <a href="@Url.Action("Index", "Instructor")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Instructor Studio
            </a>
        }
        else
        {
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        }
        <div>
            <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold text-dark m-0">@Model.Course.Title</h4>
                @if (isOwner)
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill small">
                        <i class="bi bi-person-workspace me-1"></i> Author Preview Mode
                    </span>
                }
            </div>
            <div class="text-muted small">
                Instructor: @Model.Course.InstructorName &middot; Lesson @activeNum of @Model.Lessons.Count &middot; <span class="badge bg-light text-dark border">@Model.Course.Category</span>
            </div>
        </div>
    </div>

    <!-- Overall Progress Badge & Certificate Trigger -->
    <div class="d-flex align-items-center gap-3" style="min-width: 240px;">
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Course Progress</span>
                <span class="fw-bold text-dark">@(Model.CurrentProgress)%</span>
            </div>
            <div class="lms-bar-track">
                <div class="lms-bar-fill" style="width: @(Model.CurrentProgress)%;"></div>
            </div>
        </div>
        @if (Model.CurrentProgress >= 100)
        {
            <a href="@Url.Action("Certificate", "Courses", new { id = Model.Course.CourseId })" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm">
                <i class="bi bi-award-fill"></i> View Certificate
            </a>
        }
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Main Content Player (Left) -->
    <div class="col-12 col-lg-8">
        <!-- Video Player (Embedded, Direct File, or Simulated) -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4" style="border-radius: 18px; background: #0f172a;">
            @if (!string.IsNullOrWhiteSpace(Model.ActiveLesson.VideoUrl))
            {
                var mediaUrl = Model.ActiveLesson.VideoUrl.Trim();
                bool isDirectVideo = mediaUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
                                     mediaUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
                                     mediaUrl.EndsWith(".mov", StringComparison.OrdinalIgnoreCase);
                bool isPdfDoc = mediaUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

                string embedUrl = mediaUrl;
                if (mediaUrl.Contains("youtube.com/watch?v="))
                {
                    var vId = mediaUrl.Substring(mediaUrl.IndexOf("v=") + 2).Split('&')[0];
                    embedUrl = "https://www.youtube.com/embed/" + vId;
                }
                else if (mediaUrl.Contains("youtu.be/"))
                {
                    var vId = mediaUrl.Substring(mediaUrl.IndexOf("youtu.be/") + 9).Split('?')[0];
                    embedUrl = "https://www.youtube.com/embed/" + vId;
                }

                if (isDirectVideo)
                {
                    <div class="p-0 bg-black text-center position-relative">
                        <video controls controlsList="nodownload nofullscreen noremoteplayback" disablePictureInPicture oncontextmenu="return false;" class="w-100 secure-media-element" style="max-height: 480px; object-fit: contain;">
                            <source src="@mediaUrl" type="video/mp4">
                            Your browser does not support HTML5 video streaming.
                        </video>
                    </div>
                }
                else if (isPdfDoc)
                {
                    <div class="ep-pdf-viewer-card" style="background: #ffffff; border-radius: 14px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                        <!-- Top PDF Toolbar -->
                        <div class="p-2 px-3 bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <!-- Left: Title & File info -->
                            <div class="d-flex align-items-center gap-2">
                                <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: #fee2e2; color: #dc2626; flex-shrink: 0;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                    </svg>
                                </span>
                                <div>
                                    <strong class="text-dark small d-block" style="line-height: 1.2;">Official Lesson Slides &amp; Lecture PDF</strong>
                                    <span class="text-secondary font-monospace" style="font-size: 0.72rem;">@mediaUrl.Split('/').Last()</span>
                                </div>
                            </div>

                            <!-- Center: Page Nav & Zoom Controls -->
                            <div class="d-flex align-items-center gap-1 bg-light rounded-2 p-1 border">
                                <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 text-dark" id="pdfPrevPage" title="Previous Page">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                </button>
                                <span class="small px-2 text-secondary font-monospace fw-semibold" style="font-size: 0.75rem;">
                                    Page <span id="pdfCurrentPage" class="text-dark fw-bold">1</span> of <span id="pdfTotalPages" class="text-dark fw-bold">-</span>
                                </span>
                                <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 text-dark" id="pdfNextPage" title="Next Page">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </button>
                                <div class="vr mx-1" style="height: 16px;"></div>
                                <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 text-dark" id="pdfZoomOut" title="Zoom Out">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                                <span id="pdfZoomVal" class="small px-1 text-secondary font-monospace" style="font-size: 0.75rem; min-width: 44px; text-align: center;">100%</span>
                                <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 text-dark" id="pdfZoomIn" title="Zoom In">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                                <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 text-dark" id="pdfFitWidth" title="Fit to Container Width" style="font-size: 0.72rem; font-weight: 600;">
                                    Fit
                                </button>
                            </div>

                            <!-- Right: Security Badge & Fullscreen Reader -->
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-secondary border px-2 py-1 font-monospace" style="font-size: 0.72rem;" title="Content protected against local downloading">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" class="me-1"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                    Protected &bull; No Download
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-1 font-monospace" id="pdfToggleFullscreen" style="font-size: 0.75rem;" title="Expand reader to fullscreen">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                                    Fullscreen
                                </button>
                            </div>
                        </div>

                        <!-- Canvas Stage Area -->
                        <div id="pdfViewportContainer" style="height: 620px; overflow: auto; background: #334155; position: relative; display: flex; flex-direction: column; align-items: center; padding: 1.5rem;">
                            <!-- Loading Spinner -->
                            <div id="pdfLoadingSpinner" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #ffffff; text-align: center; z-index: 10;">
                                <div class="spinner-border spinner-border-sm text-light mb-2" role="status"></div>
                                <div class="small text-light text-opacity-75 font-monospace">Rendering verified lesson slides...</div>
                            </div>

                            <!-- Fallback Alert Box (Initially hidden) -->
                            <div id="pdfErrorFallback" class="p-4 bg-white rounded-3 shadow-sm text-center m-auto" style="display: none; max-width: 440px;">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="mb-2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <h6 class="fw-bold text-dark mb-1">Inline Preview Unavailable</h6>
                                <p class="text-secondary small mb-3">You can open the original PDF in a new tab or download it directly to view.</p>
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button" class="btn btn-sm btn-dark rounded-2" onclick="location.reload();">Reload Classroom Reader</button>
                                </div>
                            </div>

                            <!-- PDF Canvas & Watermark Wrapper -->
                            <div class="secure-canvas-wrapper position-relative text-center w-100 d-flex justify-content-center">
                                <canvas id="pdfViewerCanvas" class="secure-canvas" style="display: none; max-width: 100%; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.3); border-radius: 4px; background: #ffffff;"></canvas>
                                <div class="secure-watermark-overlay" style="border-radius: 4px;">
                                    <span class="secure-watermark-text">EduPulse &bull; Protected Slide &bull; @(Session["UserName"] ?? "Student") &bull; @(Session["UserEmail"] ?? "")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ratio ratio-16x9">
                        <iframe src="@embedUrl" title="@Model.ActiveLesson.Title" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                    </div>
                }
            }
            else
            {
                <div class="position-relative d-flex align-items-center justify-content-center" style="min-height: 380px; background: #0f172a;">
                    <div class="text-center text-white p-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" 
                             style="width: 64px; height: 64px; background: #2563eb; cursor: pointer;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                        </div>
                        <h5 class="fw-bold mb-1">Lesson @activeNum: @Model.ActiveLesson.Title</h5>
                        <p class="text-secondary small mb-0">Instructional Lecture &middot; @Model.ActiveLesson.Duration</p>
                    </div>
                </div>
            }
        </div>

        <!-- IN-LINE AI SOCRATIC LESSON ASSISTANT BAR -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 p-3" 
             style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-2 text-white d-inline-flex align-items-center justify-content-center" 
                          style="width: 32px; height: 32px; background: #0f172a;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </span>
                    <div>
                        <strong class="text-dark small d-block">Academic Workspace Copilot &middot; Lesson @activeNum</strong>
                        <span class="text-secondary" style="font-size: 0.72rem;">Ask instant conceptual questions grounded in verified course materials</span>
                    </div>
                </div>
                <span class="badge bg-white text-secondary border rounded-pill px-3 py-1 font-monospace" style="font-size: 0.7rem;">
                    Course-Scoped RAG
                </span>
            </div>

            <!-- Quick Socratic Inquiry Chips -->
            <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                <span class="text-secondary small fw-semibold me-1" style="font-size: 0.75rem;">Quick Prompts:</span>
                
                <button type="button" class="btn btn-sm btn-white bg-white border rounded-2 px-3 py-1 text-dark shadow-xs" 
                        style="font-size: 0.75rem;"
                        onclick="openAiDrawerWithPrompt('Summarize the core technical concepts of Lesson @activeNum (@Model.ActiveLesson.Title) in 3 key takeaways with analogies.')">
                    <i class="bi bi-card-checklist text-primary me-1"></i> 3 Key Takeaways
                </button>

                <button type="button" class="btn btn-sm btn-white bg-white border rounded-2 px-3 py-1 text-dark shadow-xs" 
                        style="font-size: 0.75rem;"
                        onclick="openAiDrawerWithPrompt('What is the most challenging architectural concept in Lesson @activeNum (@Model.ActiveLesson.Title), and how does it work under the hood?')">
                    <i class="bi bi-lightbulb-fill text-warning me-1"></i> Core Architecture
                </button>

                <button type="button" class="btn btn-sm btn-white bg-white border rounded-2 px-3 py-1 text-dark shadow-xs" 
                        style="font-size: 0.75rem;"
                        onclick="openAiDrawerWithPrompt('Quiz me with 2 conceptual questions based on Lesson @activeNum (@Model.ActiveLesson.Title) without giving away the answers.')">
                    <i class="bi bi-patch-question-fill text-success me-1"></i> Socratic Check
                </button>

                <button type="button" class="btn btn-sm btn-white bg-white border rounded-2 px-3 py-1 text-dark shadow-xs" 
                        style="font-size: 0.75rem;"
                        onclick="openAiDrawerWithPrompt('What practical real-world production project can I build using what is taught in Lesson @activeNum (@Model.ActiveLesson.Title)?')">
                    <i class="bi bi-laptop-fill text-info me-1"></i> Production Application
                </button>
            </div>
        </div>

        <!-- Lesson Description & Study Material -->
        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 18px; border: 1px solid #e2e8f0 !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark m-0">@Model.ActiveLesson.Title</h3>
                @if (Model.ActiveLesson.IsCompleted)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold">
                        <i class="bi bi-check-circle-fill"></i> Completed
                    </span>
                }
            </div>

            <p class="text-muted fs-6 mb-4">
                @Model.ActiveLesson.ContentMarkdown
            </p>

            <div class="p-3 rounded-3 bg-light border mb-4">
                <div class="fw-bold text-dark mb-1">
                    <i class="bi bi-lightbulb-fill text-warning me-1"></i> Lesson Key Takeaway:
                </div>
                <div class="text-muted small">
                    @Model.ActiveLesson.Summary
                </div>
            </div>

            <!-- Course Study Materials & Official Lecture PDFs -->
            @if (ViewBag.StudyMaterials != null)
            {
                var studyMaterials = ViewBag.StudyMaterials as IEnumerable<WebApplication1.Models.StudyMaterialItem>;
                if (studyMaterials != null && studyMaterials.Any())
                {
                    <div class="card border-0 shadow-sm rounded-3 my-4" style="background: #ffffff; border: 1px solid #e2e8f0 !important;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-2 text-dark p-2" style="background: #f1f5f9; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                    </span>
                                    <div>
                                        <h5 class="fw-bold text-dark m-0" style="font-size: 0.95rem;">Official Course Study Guides &amp; Architecture Reference</h5>
                                        <div class="text-secondary small">Download verified PDFs, cheatsheets, and lecture materials designed by your instructor</div>
                                    </div>
                                </div>
                                <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 font-monospace" style="font-size: 0.725rem;">
                                    @studyMaterials.Count() Resource(s) Available
                                </span>
                            </div>

                            <div class="row g-3">
                                @foreach (var mat in studyMaterials)
                                {
                                    <div class="col-12 col-md-6">
                                        <div class="p-3 bg-white rounded-3 border d-flex align-items-center justify-content-between gap-3 shadow-xs h-100">
                                            <div class="d-flex align-items-center gap-2 text-truncate">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" class="flex-shrink-0">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                </svg>
                                                <div class="text-truncate">
                                                    <div class="fw-bold text-dark small text-truncate" title="@mat.DisplayName">@mat.DisplayName</div>
                                                    <div class="text-secondary" style="font-size: 0.725rem;">Verified Study PDF &bull; @mat.FileSizeKb KB</div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-2 px-3 flex-shrink-0" onclick="loadProtectedPdfInViewer('@mat.Url', '@mat.DisplayName')" style="font-size: 0.75rem;">
                                                <i class="bi bi-eye-fill me-1"></i> Read in Classroom
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- End-of-Lesson Mini Quiz Section -->
            @if (hasQuiz)
            {
                <div class="card border-0 shadow-sm p-4 rounded-4 my-4" style="background: #f8fafc; border: 1.5px solid #cbd5e1 !important;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle p-2" style="width: 32px; height: 32px;">
                                <i class="bi bi-mortarboard"></i>
                            </span>
                            <div>
                                <h5 class="fw-bold text-dark m-0">Lesson @activeNum Knowledge Check Quiz</h5>
                                <div class="text-muted small">Pass with 60% or higher to advance your progress</div>
                            </div>
                        </div>
                        <span class="badge bg-info text-dark fw-bold px-3 py-2 rounded-pill">
                            @quizQuestions.Count() Questions
                        </span>
                    </div>

                    @using (Html.BeginForm("SubmitQuiz", "Courses", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                        <input type="hidden" name="lessonNumber" value="@activeNum" />

                        int qIndex = 1;
                        foreach (var q in quizQuestions)
                        {
                            <div class="card border-0 bg-white p-3 rounded-3 mb-3 shadow-sm">
                                <div class="fw-bold text-dark mb-2">
                                    <span class="badge bg-light text-primary border me-1">Q@(qIndex++)</span>
                                    @q.QuestionText
                                </div>
                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <div class="form-check p-2 border rounded-3 bg-light">
                                            <input class="form-check-input ms-1 me-2" type="radio" name="question_@q.QuestionId" id="q_@(q.QuestionId)_A" value="A" required />
                                            <label class="form-check-label small text-dark" for="q_@(q.QuestionId)_A">
                                                <strong>A:</strong> @q.OptionA
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-check p-2 border rounded-3 bg-light">
                                            <input class="form-check-input ms-1 me-2" type="radio" name="question_@q.QuestionId" id="q_@(q.QuestionId)_B" value="B" required />
                                            <label class="form-check-label small text-dark" for="q_@(q.QuestionId)_B">
                                                <strong>B:</strong> @q.OptionB
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-check p-2 border rounded-3 bg-light">
                                            <input class="form-check-input ms-1 me-2" type="radio" name="question_@q.QuestionId" id="q_@(q.QuestionId)_C" value="C" required />
                                            <label class="form-check-label small text-dark" for="q_@(q.QuestionId)_C">
                                                <strong>C:</strong> @q.OptionC
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-check p-2 border rounded-3 bg-light">
                                            <input class="form-check-input ms-1 me-2" type="radio" name="question_@q.QuestionId" id="q_@(q.QuestionId)_D" value="D" required />
                                            <label class="form-check-label small text-dark" for="q_@(q.QuestionId)_D">
                                                <strong>D:</strong> @q.OptionD
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                            <i class="bi bi-send-check-fill me-1"></i> Submit Quiz Answers & Complete Lesson
                        </button>
                    }
                </div>
            }

            <!-- Hands-on Assignment & Practical Task Section -->
            @if (!string.IsNullOrWhiteSpace(Model.ActiveLesson.AssignmentPrompt))
            {
                <div class="card border-0 shadow-sm p-4 rounded-3 my-4" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-2 p-2 text-white" style="background: #0f172a; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                            </span>
                            <div>
                                <h5 class="fw-bold text-dark m-0" style="font-size: 0.95rem;">Lesson @activeNum Practical Assignment</h5>
                                <div class="text-secondary small">Assigned by Instructor: @Model.Course.InstructorName</div>
                            </div>
                        </div>
                        <div>
                            @if (activeSub != null)
                            {
                                if (activeSub.IsPending)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                                        <i class="bi bi-hourglass-split me-1"></i> Marks Pending (Submitted)
                                    </span>
                                }
                                else if (activeSub.IsApproved)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">
                                        <i class="bi bi-patch-check-fill me-1"></i> Score: @activeSub.MarksObtained / 100 (Approved)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">
                                        <i class="bi bi-x-circle me-1"></i> Needs Revision
                                    </span>
                                }
                            }
                        </div>
                    </div>

                    <!-- Prompt Text -->
                    <div class="p-3 bg-white rounded-3 border mb-3">
                        <strong class="text-dark d-block mb-1"><i class="bi bi-card-checklist text-primary me-1"></i> Assignment Prompt:</strong>
                        <div class="text-muted small">@Model.ActiveLesson.AssignmentPrompt</div>
                    </div>

                    @if (activeSub != null)
                    {
                        <!-- Current Submission Status & Locked Re-submission Notice -->
                        <div class="p-3 bg-white rounded-3 border mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    <i class="bi bi-lock-fill text-muted me-1"></i> Assignment Finalized &bull; Re-submission Disabled
                                </span>
                                <span class="text-muted small">Submitted on @activeSub.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div class="fw-bold text-dark small mb-1">Your Submitted Solution:</div>
                            <div class="text-muted small mb-2" style="white-space: pre-wrap;">@activeSub.SubmissionText</div>
                            @if (!string.IsNullOrWhiteSpace(activeSub.SubmissionFileUrl))
                            {
                                bool isUploadedDoc = activeSub.SubmissionFileUrl.StartsWith("/Uploads/", StringComparison.OrdinalIgnoreCase) ||
                                                     activeSub.SubmissionFileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ||
                                                     activeSub.SubmissionFileUrl.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ||
                                                     activeSub.SubmissionFileUrl.EndsWith(".docx", StringComparison.OrdinalIgnoreCase);
                                <div class="small mt-2 p-2 bg-light rounded-2 border d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div>
                                        @if (isUploadedDoc)
                                        {
                                            <i class="bi bi-file-earmark-pdf-fill text-danger fs-5 me-1"></i>
                                            <strong>Attached Solution Document:</strong>
                                        }
                                        else
                                        {
                                            <i class="bi bi-link-45deg text-primary fs-5 me-1"></i>
                                            <strong>Project / Repository Link:</strong>
                                        }
                                        <span class="text-truncate ms-1" style="max-width: 350px;">@activeSub.SubmissionFileUrl</span>
                                    </div>
                                    <a href="@activeSub.SubmissionFileUrl" target="_blank" download class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                        <i class="bi @(isUploadedDoc ? "bi-download" : "bi-box-arrow-up-right") me-1"></i>
                                        @(isUploadedDoc ? "Download File" : "Open Link")
                                    </a>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(activeSub.InstructorFeedback))
                            {
                                <div class="alert alert-info py-2 px-3 small mt-2 mb-0 rounded-3">
                                    <strong><i class="bi bi-chat-quote-fill me-1"></i> Mentor Feedback:</strong> @activeSub.InstructorFeedback
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Submission Form (Only accessible if student has not yet submitted) -->
                        using (Html.BeginForm("SubmitAssignment", "Courses", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                            <input type="hidden" name="moduleId" value="@Model.ActiveLesson.ModuleId" />
                            <input type="hidden" name="lessonNumber" value="@activeNum" />
                            <input type="hidden" name="submissionTitle" value="Lesson @activeNum: @Model.ActiveLesson.Title" />

                            <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3">
                                <i class="bi bi-shield-exclamation me-1"></i> <strong>One-time Submission Notice:</strong> Re-submissions are not permitted once submitted. Please review your work, attached file, and links carefully before submitting.
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-dark">Your Solution / Architecture Details <span class="text-danger">*</span></label>
                                <textarea name="submissionText" class="form-control" rows="3" placeholder="Explain your code implementation, component structure, or paste code snippets..." required></textarea>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small text-dark">
                                        <i class="bi bi-file-earmark-arrow-up text-primary me-1"></i> Attach Solution File (PDF, ZIP, DOCX, TXT)
                                    </label>
                                    <input type="file" name="submissionFile" class="form-control" accept=".pdf,.zip,.rar,.docx,.doc,.txt" />
                                    <div class="form-text small text-muted">Upload your complete project report or code archive (Max 25 MB).</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small text-dark">
                                        <i class="bi bi-link-45deg text-primary me-1"></i> GitHub Repo or Live Demo Link (Optional)
                                    </label>
                                    <input type="url" name="submissionFileUrl" class="form-control" placeholder="https://github.com/your-username/project or Vercel link" />
                                    <div class="form-text small text-muted">Or live deployment URL for practical verification.</div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-dark rounded-2 px-4 py-2 fw-semibold shadow-xs">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                Submit Assignment (Final)
                            </button>
                        }
                    }
                </div>
            }

            <!-- Lesson Navigation Action Bar -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-2">
                @if (activeNum > 1)
                {
                    <a href="@Url.Action("Learn", "Courses", new { id = Model.Course.CourseId, lesson = activeNum - 1 })" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left"></i> Previous Lesson
                    </a>
                }
                else
                {
                    <div></div>
                }

                <div class="d-flex gap-2">
                    @if (isOwner || isAdmin)
                    {
                        if (activeNum < Model.Lessons.Count)
                        {
                            <a href="@Url.Action("Learn", "Courses", new { id = Model.Course.CourseId, lesson = activeNum + 1 })" class="lms-cta-btn px-4 py-2">
                                Next Preview Lesson <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    }
                    else
                    {
                        if (canAdvanceModule)
                        {
                            using (Html.BeginForm("UpdateProgress", "Dashboard", FormMethod.Post, new { @class = "d-inline m-0" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                                <input type="hidden" name="progressPercentage" value="@nextProgress" />
                                
                                <button type="submit" class="lms-cta-btn px-4 py-2">
                                    <i class="bi bi-check2-circle"></i> Mark Module Complete (@nextProgress%)
                                </button>
                            }
                        }
                        else
                        {
                            if (hasQuiz && !hasPassedQuiz && hasAssignment && !hasSubmittedAssignment)
                            {
                                <button class="btn btn-secondary rounded-pill px-4 py-2" disabled title="Pass quiz and submit assignment to finish this module">
                                    <i class="bi bi-lock-fill me-1"></i> Quiz & Assignment Required
                                </button>
                            }
                            else if (hasQuiz && !hasPassedQuiz)
                            {
                                <button class="btn btn-secondary rounded-pill px-4 py-2" disabled title="Pass quiz with 60% or higher to advance">
                                    <i class="bi bi-lock-fill me-1"></i> Quiz Required (&ge; 60%)
                                </button>
                            }
                            else if (hasAssignment && !hasSubmittedAssignment)
                            {
                                <button class="btn btn-secondary rounded-pill px-4 py-2" disabled title="Submit the hands-on assignment below to advance">
                                    <i class="bi bi-lock-fill me-1"></i> Assignment Required
                                </button>
                            }
                        }

                        if (activeNum < Model.Lessons.Count && (Model.ActiveLesson.IsCompleted || canAdvanceModule))
                        {
                            <a href="@Url.Action("Learn", "Courses", new { id = Model.Course.CourseId, lesson = activeNum + 1 })" class="btn btn-primary rounded-pill px-4">
                                Next Lesson <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Curriculum Sidebar (Right) -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm p-4 sticky-top" style="border-radius: 18px; top: 90px; border: 1px solid #e2e8f0 !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark m-0">Curriculum Syllabus</h5>
                <span class="badge bg-light text-muted border">@Model.Lessons.Count Lessons</span>
            </div>

            <div class="list-group list-group-flush border-top">
                @foreach (var l in Model.Lessons)
                {
                    bool isActive = l.LessonNumber == activeNum;
                    string bgClass = isActive ? "bg-primary bg-opacity-10 text-primary border-start border-4 border-primary" : "text-dark";

                    <a href="@Url.Action("Learn", "Courses", new { id = Model.Course.CourseId, lesson = l.LessonNumber })" 
                       class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3 border-bottom @bgClass"
                       style="border-radius: 8px; margin-bottom: 4px;">
                        <div class="d-flex align-items-center gap-3">
                            @if (l.IsCompleted)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            }
                            else if (isActive)
                            {
                                <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle text-muted fs-5"></i>
                            }
                            <div>
                                <div class="fw-bold small">Lesson @l.LessonNumber</div>
                                <div class="text-truncate" style="max-width: 180px; font-size: 0.82rem;">@l.Title</div>
                            </div>
                        </div>
                        <span class="text-muted small" style="font-size: 0.75rem;">@l.Duration</span>
                    </a>
                }
            </div>

            <!-- Certificate Banner if 100% -->
            @if (Model.CurrentProgress >= 100)
            {
                <div class="mt-4 p-3 rounded-4 text-center" style="background: #ecfdf5; border: 1.5px solid #a7f3d0;">
                    <i class="bi bi-patch-check-fill text-success fs-1 mb-1 d-block"></i>
                    <h6 class="fw-bold text-success mb-1">Course 100% Completed!</h6>
                    <p class="text-muted small mb-3">Congratulations on mastering this subject. Your verified certificate is ready.</p>
                    <a href="@Url.Action("Certificate", "Courses", new { id = Model.Course.CourseId })" class="btn btn-success btn-sm rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-printer-fill me-1"></i> View / Print Certificate
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    window.CURRENT_COURSE_ID = @Model.Course.CourseId;
    window.CURRENT_COURSE_TITLE = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Course.Title))';
</script>

@if (!string.IsNullOrWhiteSpace(Model.ActiveLesson.VideoUrl) && Model.ActiveLesson.VideoUrl.Trim().EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
{
    var pdfDocUrl = Url.Content(Model.ActiveLesson.VideoUrl.Trim());
    <script src="@Url.Content("~/Scripts/pdfjs/pdf.min.js")"></script>
    <script>
        (function () {
            var pdfUrl = '@pdfDocUrl';
            if (!pdfUrl) return;

            var pdfDoc = null;
            var pageNum = 1;
            var pageRendering = false;
            var pageNumPending = null;
            var scale = 1.25;
            var canvas = document.getElementById('pdfViewerCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var spinner = document.getElementById('pdfLoadingSpinner');
            var errorBox = document.getElementById('pdfErrorFallback');
            var totalPagesEl = document.getElementById('pdfTotalPages');
            var currentPageEl = document.getElementById('pdfCurrentPage');
            var zoomValEl = document.getElementById('pdfZoomVal');
            var container = document.getElementById('pdfViewportContainer');

            if (window.pdfjsLib) {
                pdfjsLib.GlobalWorkerOptions.workerSrc = '@Url.Content("~/Scripts/pdfjs/pdf.worker.min.js")';

                function renderPage(num) {
                    pageRendering = true;
                    pdfDoc.getPage(num).then(function (page) {
                        var viewport = page.getViewport({ scale: scale });
                        var outputScale = window.devicePixelRatio || 1;

                        canvas.width = Math.floor(viewport.width * outputScale);
                        canvas.height = Math.floor(viewport.height * outputScale);
                        canvas.style.width = Math.floor(viewport.width) + "px";
                        canvas.style.height = Math.floor(viewport.height) + "px";

                        var transform = outputScale !== 1
                            ? [outputScale, 0, 0, outputScale, 0, 0]
                            : null;

                        var renderContext = {
                            canvasContext: ctx,
                            transform: transform,
                            viewport: viewport
                        };

                        var renderTask = page.render(renderContext);
                        renderTask.promise.then(function () {
                            pageRendering = false;
                            if (spinner) spinner.style.display = 'none';
                            canvas.style.display = 'block';

                            if (pageNumPending !== null) {
                                renderPage(pageNumPending);
                                pageNumPending = null;
                            }
                        }).catch(function (e) {
                            console.error('Page render error:', e);
                            pageRendering = false;
                        });
                    }).catch(function (err) {
                        console.error('PDF getPage error:', err);
                        if (spinner) spinner.style.display = 'none';
                        if (errorBox) errorBox.style.display = 'block';
                    });

                    if (currentPageEl) currentPageEl.textContent = num;
                    if (zoomValEl) zoomValEl.textContent = Math.round(scale * 100) + '%';
                }

                function queueRenderPage(num) {
                    if (pageRendering) {
                        pageNumPending = num;
                    } else {
                        renderPage(num);
                    }
                }

                var prevBtn = document.getElementById('pdfPrevPage');
                var nextBtn = document.getElementById('pdfNextPage');
                if (prevBtn) {
                    prevBtn.addEventListener('click', function () {
                        if (pageNum <= 1) return;
                        pageNum--;
                        queueRenderPage(pageNum);
                    });
                }
                if (nextBtn) {
                    nextBtn.addEventListener('click', function () {
                        if (!pdfDoc || pageNum >= pdfDoc.numPages) return;
                        pageNum++;
                        queueRenderPage(pageNum);
                    });
                }

                var zoomInBtn = document.getElementById('pdfZoomIn');
                var zoomOutBtn = document.getElementById('pdfZoomOut');
                var fitWidthBtn = document.getElementById('pdfFitWidth');

                if (zoomInBtn) {
                    zoomInBtn.addEventListener('click', function () {
                        scale = Math.min(3.0, scale + 0.25);
                        queueRenderPage(pageNum);
                    });
                }
                if (zoomOutBtn) {
                    zoomOutBtn.addEventListener('click', function () {
                        scale = Math.max(0.5, scale - 0.25);
                        queueRenderPage(pageNum);
                    });
                }
                if (fitWidthBtn) {
                    fitWidthBtn.addEventListener('click', function () {
                        if (!pdfDoc) return;
                        pdfDoc.getPage(pageNum).then(function (page) {
                            var cWidth = (container ? container.clientWidth : 800) - 60;
                            var defaultViewport = page.getViewport({ scale: 1.0 });
                            scale = Math.max(0.6, Math.min(2.5, cWidth / defaultViewport.width));
                            queueRenderPage(pageNum);
                        });
                    });
                }

                // Fullscreen reader handler
                var fsBtn = document.getElementById('pdfToggleFullscreen');
                if (fsBtn) {
                    fsBtn.addEventListener('click', function () {
                        var card = document.querySelector('.ep-pdf-viewer-card');
                        if (!card) return;
                        if (!document.fullscreenElement) {
                            card.requestFullscreen().catch(function () {});
                        } else {
                            document.exitFullscreen().catch(function () {});
                        }
                    });
                }

                // Global document switcher for study materials
                window.loadProtectedPdfInViewer = function (newUrl, newTitle) {
                    if (!newUrl || !window.pdfjsLib) return;
                    pdfUrl = newUrl;
                    pageNum = 1;
                    if (spinner) spinner.style.display = 'block';
                    if (canvas) canvas.style.display = 'none';
                    if (errorBox) errorBox.style.display = 'none';

                    pdfjsLib.getDocument(pdfUrl).promise.then(function (pdf) {
                        pdfDoc = pdf;
                        if (totalPagesEl) totalPagesEl.textContent = pdf.numPages;
                        renderPage(pageNum);
                        var containerEl = document.getElementById('pdfViewportContainer');
                        if (containerEl) {
                            containerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }).catch(function (error) {
                        console.error('PDF.js reload error:', error);
                        if (spinner) spinner.style.display = 'none';
                        if (errorBox) errorBox.style.display = 'block';
                    });
                };

                pdfjsLib.getDocument(pdfUrl).promise.then(function (pdf) {
                    pdfDoc = pdf;
                    if (totalPagesEl) totalPagesEl.textContent = pdf.numPages;
                    renderPage(pageNum);
                }).catch(function (error) {
                    console.error('PDF.js getDocument error:', error);
                    if (spinner) spinner.style.display = 'none';
                    if (errorBox) errorBox.style.display = 'block';
                });
            } else {
                if (spinner) spinner.style.display = 'none';
                if (errorBox) errorBox.style.display = 'block';
            }
        })();
    </script>
}
