<div class="ep-page-container">
    <!-- Top Breadcrumb & Pacing Meta Bar -->
    <div class="ep-top-bar">
        <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-2">
            <nav aria-label="Breadcrumb">
                <a href="@Url.Action("Index", "Dashboard")" class="ep-breadcrumb-link">Dashboard</a>
                <span class="ep-breadcrumb-sep">&gt;</span>
                <a href="@Url.Action("Index", "Courses")" class="ep-breadcrumb-link">Courses</a>
                <span class="ep-breadcrumb-sep">&gt;</span>
                <a href="@Url.Action("Index", "Courses", new { category = Model.Category })" class="ep-breadcrumb-link">@Model.Category</a>
                <span class="ep-breadcrumb-sep">&gt;</span>
                <span class="ep-breadcrumb-current">@Model.Title</span>
            </nav>

            <div class="d-flex align-items-center gap-2">
                @if (isEnrolled && !isOwner)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                        &#10003; Enrolled Learner Workspace
                    </span>
                    <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = activeLessonNumber })" 
                       class="btn btn-sm btn-dark rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;">
                        Resume Lesson @activeLessonNumber &rarr;
                    </a>
                }
                else if (isOwner)
                {
                    if (ViewBag.IsDraftPreview == true)
                    {
                        <span class="badge bg-warning text-dark border border-warning rounded-pill px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                            Draft (Unpublished)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                            Author Studio Mode
                        </span>
                    }
                    <a href="@Url.Action("Modules", "Instructor", new { id = Model.CourseId })" 
                       class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;">
                        Manage Curriculum
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["WarningMessage"] != null)
    {
        <div class="container-xl mt-3">
            <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container-xl mt-3">
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (ViewBag.IsDraftPreview == true)
    {
        <div class="container-xl mt-3">
            <div class="alert alert-warning border-warning-subtle d-flex align-items-center justify-content-between flex-wrap gap-2 rounded-3 shadow-sm py-2 px-3 mb-0" style="background: #fffbeb;">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark font-monospace">DRAFT PREVIEW</span>
                    <span class="small text-dark fw-semibold">This course is currently UNPUBLISHED and hidden from students. Add curriculum modules to publish it.</span>
                </div>
                <a href="@Url.Action("Modules", "Instructor", new { id = Model.CourseId })" class="btn btn-sm btn-dark font-monospace py-1 px-3">
                    Curriculum Builder &rarr;
                </a>
            </div>
        </div>
    }

    @if (isEnrolled && !isOwner)
    {
        <!-- =========================================================================
             ENROLLED COURSE WORKSPACE & COMMAND CENTER
             (Zero marketing copy, zero pricing, zero reviews form, 100% learning focus)
             ========================================================================= -->

        <!-- 1. Personalized Learning Hero Section -->
        <header class="ep-ws-hero">
            <div class="container-xl">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 font-monospace" style="font-size: 0.7rem;">
                                @Model.Category
                            </span>
                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 font-monospace" style="font-size: 0.7rem;">
                                Level: @Model.Level
                            </span>
                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 font-monospace" style="font-size: 0.7rem;">
                                Instructor: @Model.InstructorName
                            </span>
                        </div>
                        <h1 class="ep-ws-hero-title">@Model.Title</h1>
                        <p class="ep-ws-hero-subtitle">
                            Dedicated learning command center for mastering enterprise production patterns, automated assessments, and graduation milestones.
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (isCompleted)
                        {
                            <a href="@Url.Action("Certificate", "Courses", new { id = Model.CourseId })" class="ep-btn-accent shadow-sm" style="background: #059669; border-color: #059669;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="8" r="7"></circle>
                                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                                </svg>
                                View Official Certificate
                            </a>
                            <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = 1 })" class="ep-btn-secondary">
                                Review Lessons
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = activeLessonNumber })" class="ep-btn-accent shadow-sm">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M4 3.5v9l8-4.5-8-4.5z"/>
                                </svg>
                                Continue Learning (Lesson @activeLessonNumber)
                            </a>
                            <button type="button" class="ep-btn-secondary" onclick="if(window.openAiDrawerWithPrompt) openAiDrawerWithPrompt('What are the key technical objectives for Lesson @activeLessonNumber in @Model.Title?');">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                </svg>
                                Ask Copilot
                            </button>
                        }
                    </div>
                </div>

                <!-- Overall Progress Indicator -->
                <div class="mt-4 pt-2 border-top">
                    <div class="d-flex align-items-center justify-content-between small text-secondary">
                        <span class="fw-semibold text-dark">Course Completion Pace</span>
                        <span class="font-monospace fw-bold text-dark">@progressPct% Completed</span>
                    </div>
                    <div class="ep-progress-bar-track">
                        <div class="ep-progress-bar-fill" style="width: @progressPct%;"></div>
                    </div>
                </div>

                <!-- Hero Stats Grid -->
                <div class="ep-ws-hero-grid">
                    <div class="ep-ws-hero-stat">
                        <div class="ep-ws-hero-stat-label">Current Module</div>
                        <div class="ep-ws-hero-stat-value text-truncate">
                            @(activeModule != null ? $"Module {activeModule.ModuleNumber}: {activeModule.Title}" : "Curriculum Enrolled")
                        </div>
                        <div class="ep-ws-hero-stat-sub">@completedModuleCount of @totalModules modules finished</div>
                    </div>

                    <div class="ep-ws-hero-stat">
                        <div class="ep-ws-hero-stat-label">Upcoming Lesson</div>
                        <div class="ep-ws-hero-stat-value text-truncate">
                            Lesson @activeLessonNumber: @(activeModule != null ? activeModule.Title : "Next Topic")
                        </div>
                        <div class="ep-ws-hero-stat-sub">Estimated: @(activeModule != null ? activeModule.FormattedDuration : "30 mins")</div>
                    </div>

                    <div class="ep-ws-hero-stat">
                        <div class="ep-ws-hero-stat-label">Estimated Time Remaining</div>
                        <div class="ep-ws-hero-stat-value">@remainingFormatted</div>
                        <div class="ep-ws-hero-stat-sub">Based on remaining lecture &amp; lab durations</div>
                    </div>

                    <div class="ep-ws-hero-stat">
                        <div class="ep-ws-hero-stat-label">Recent Activity</div>
                        <div class="ep-ws-hero-stat-value text-truncate">
                            @(passedQuizzes.Any() ? $"Passed Quiz {passedQuizzes.Last().LessonNumber} ({passedQuizzes.Last().ScorePercentage:0.0}%)" : (submissions.Any() ? $"Submitted Module {submissions.Last().ModuleNumber} Solution" : "Enrolled & Ready to Study"))
                        </div>
                        <div class="ep-ws-hero-stat-sub">Telemetry verified</div>
                    </div>
                </div>
            </div>
        </header>

        <main class="container-xl pt-4">
            <!-- 2. Course Progress Dashboard (Compact Metrics Cards) -->
            <section class="ep-metrics-grid" aria-label="Course Progress Dashboard">
                <div class="ep-metric-card">
                    <div class="ep-metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                        </svg>
                    </div>
                    <div class="ep-metric-val">@completedModuleCount / @totalModules</div>
                    <div class="ep-metric-title">Lessons Completed</div>
                    <div class="ep-metric-sub">@(totalModules - completedModuleCount) lessons remaining</div>
                </div>

                <div class="ep-metric-card">
                    <div class="ep-metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <div class="ep-metric-val">@completedModuleCount / @totalModules</div>
                    <div class="ep-metric-title">Modules Mastered</div>
                    <div class="ep-metric-sub">Full syllabus roadmap</div>
                </div>

                <div class="ep-metric-card">
                    <div class="ep-metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                    </div>
                    <div class="ep-metric-val">@passedQuizzes.Count / @totalModules</div>
                    <div class="ep-metric-title">Quizzes Passed</div>
                    <div class="ep-metric-sub">@(gradeSummary != null && gradeSummary.QuizzesTaken > 0 ? $"{gradeSummary.QuizAverage:0.0}% average score" : "Pass threshold >= 60%")</div>
                </div>

                <div class="ep-metric-card">
                    <div class="ep-metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                        </svg>
                    </div>
                    <div class="ep-metric-val">@submittedAssignmentsCount Submitted</div>
                    <div class="ep-metric-title">Assignments</div>
                    <div class="ep-metric-sub">@approvedAssignmentsCount Approved &bull; @pendingAssignmentsCount Pending</div>
                </div>

                <div class="ep-metric-card">
                    <div class="ep-metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 14 14"></polyline>
                        </svg>
                    </div>
                    <div class="ep-metric-val">@(gradeSummary != null && gradeSummary.FinalScore > 0 ? $"{gradeSummary.FinalScore:0.0}%" : "Active")</div>
                    <div class="ep-metric-title">Academic Score</div>
                    <div class="ep-metric-sub">@(gradeSummary != null && !string.IsNullOrWhiteSpace(gradeSummary.LetterGrade) && gradeSummary.LetterGrade != "Incomplete" ? $"Grade {gradeSummary.LetterGrade}" : "Grading continuous")</div>
                </div>

                <div class="ep-metric-card">
                    <div class="ep-metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="8" r="7"></circle>
                            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                        </svg>
                    </div>
                    <div class="ep-metric-val">@(isCompleted ? "Unlocked" : $"{progressPct}% / 100%")</div>
                    <div class="ep-metric-title">Certificate Status</div>
                    <div class="ep-metric-sub">@(isCompleted ? "Verified Credential" : "Pass all modules")</div>
                </div>
            </section>

            <!-- 3. Main Two-Column Desktop Layout -->
            <div class="ep-workspace-layout">
                <!-- Left Section: Curriculum Navigator, Assessments, Resources -->
                <div class="ep-workspace-main">
                    <!-- Prominent Continue Learning Card -->
                    @if (!isCompleted && activeModule != null)
                    {
                        <div class="ep-continue-card">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                <span class="ep-continue-badge">
                                    Continue Learning &bull; Lesson @activeLessonNumber
                                </span>
                                <span class="font-monospace text-secondary small">
                                    Duration: @activeModule.FormattedDuration
                                </span>
                            </div>
                            <h2 class="ep-continue-title">@activeModule.Title</h2>
                            <p class="ep-continue-desc">
                                @(string.IsNullOrWhiteSpace(activeModule.Description) 
                                    ? "Resume your current lecture session, follow along with architectural slides, and complete module deliverables." 
                                    : activeModule.Description)
                            </p>
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-2 border-top">
                                <div class="ep-continue-meta">
                                    <span class="ep-continue-meta-item">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 14 14"></polyline>
                                        </svg>
                                        @activeModule.FormattedDuration
                                    </span>
                                    <span class="ep-continue-meta-item">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                        @(activeModule.VideoOrResourceUrl != null && activeModule.VideoOrResourceUrl.EndsWith(".pdf") ? "Lecture Slides & Reference" : "Interactive Lecture & Lab")
                                    </span>
                                </div>
                                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = activeLessonNumber })" class="ep-btn-accent shadow-xs">
                                    Resume Lesson @activeLessonNumber &rarr;
                                </a>
                            </div>
                        </div>
                    }
                    else if (isCompleted)
                    {
                        <div class="ep-continue-card" style="border-color: #10b981; background: #f0fdf4;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success text-white rounded-pill px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                    &#10003; 100% Course Completed
                                </span>
                            </div>
                            <h2 class="ep-continue-title text-success">Congratulations on Graduating!</h2>
                            <p class="ep-continue-desc text-secondary mb-3">
                                You have fulfilled all lecture modules, passed quizzes with verified academic scores, and submitted practical assignments. Your official credential has been registered in the EduPulse registry.
                            </p>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <a href="@Url.Action("Certificate", "Courses", new { id = Model.CourseId })" class="ep-btn-accent shadow-xs" style="background: #059669; border-color: #059669;">
                                    View Official Certificate
                                </a>
                                <a href="@Url.Action("Index", "Courses", new { category = Model.Category })" class="ep-btn-secondary">
                                    Explore Advanced Paths
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Curriculum Navigator (Primary Core Component) -->
                    <section class="ep-card" aria-label="Curriculum Syllabus Navigator">
                        <div class="ep-card-header">
                            <div>
                                <h3 class="ep-card-title">Curriculum Syllabus Navigator</h3>
                                <div class="ep-card-sub">
                                    @totalModules Modules &bull; @totalDurationMinutes Minutes Total Curriculum &bull; Click any module to expand contents
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;" id="epExpandAllBtn">
                                    Expand All
                                </button>
                            </div>
                        </div>

                        <div class="ep-curriculum-list">
                            @foreach (var m in modules)
                            {
                                bool isModCompleted = isCompleted || (m.ModuleNumber <= completedModuleCount);
                                bool isModActive = !isCompleted && (m.ModuleNumber == activeLessonNumber);
                                bool hasPassedModQuiz = passedQuizzes.Any(q => q.LessonNumber == m.ModuleNumber);
                                var modSubmission = submissions.FirstOrDefault(s => s.ModuleNumber == m.ModuleNumber || s.ModuleId == m.ModuleId);

                                string statusClass = isModCompleted ? "ep-status-completed" : (isModActive ? "ep-status-active" : "ep-status-upcoming");
                                string accordionClass = isModActive ? "active" : "";

                                <div class="ep-module-accordion @accordionClass" data-module="@m.ModuleNumber">
                                    <div class="ep-module-header" onclick="toggleModuleAccordion(this)">
                                        <div class="d-flex align-items-center">
                                            <div class="ep-module-status-icon @statusClass">
                                                @if (isModCompleted)
                                                {
                                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                    </svg>
                                                }
                                                else if (isModActive)
                                                {
                                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                                                        <path d="M4 3.5v9l8-4.5-8-4.5z"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <span style="font-size: 0.75rem; font-weight: 700;">@m.ModuleNumber</span>
                                                }
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                                    Module @m.ModuleNumber: @m.Title
                                                </div>
                                                <div class="text-secondary small">
                                                    @m.FormattedDuration &bull; 
                                                    @(m.VideoOrResourceUrl != null && m.VideoOrResourceUrl.EndsWith(".pdf") ? "Lecture Slides & PDF" : "Video Lecture & Lab")
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            @if (isModCompleted)
                                            {
                                                <span class="ep-badge-pill ep-pill-passed">Completed</span>
                                            }
                                            else if (isModActive)
                                            {
                                                <span class="ep-badge-pill ep-pill-pending">In Progress</span>
                                            }
                                            else
                                            {
                                                <span class="ep-badge-pill ep-pill-required">Upcoming</span>
                                            }

                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" class="ep-chevron-icon transition-transform">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </div>
                                    </div>

                                    <div class="ep-module-body @(isModActive || m.ModuleNumber == 1 ? "open" : "")">
                                        @if (!string.IsNullOrWhiteSpace(m.Description))
                                        {
                                            <p class="text-secondary small mb-3">@m.Description</p>
                                        }

                                        <!-- Lesson Content Row -->
                                        <div class="ep-lesson-row">
                                            <div class="d-flex align-items-center gap-2">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" class="flex-shrink-0">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <polygon points="10 8 16 12 10 16 10 8"></polygon>
                                                </svg>
                                                <div>
                                                    <strong class="text-dark small d-block">Lesson @m.ModuleNumber: Core Architecture &amp; Implementation</strong>
                                                    <span class="text-secondary" style="font-size: 0.72rem;">@m.FormattedDuration &bull; Verified Instructional Media</span>
                                                </div>
                                            </div>
                                            <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = m.ModuleNumber })" 
                                               class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;">
                                                @(isModCompleted ? "Review Lecture" : "Open Classroom") &rarr;
                                            </a>
                                        </div>

                                        <!-- Quiz Row -->
                                        <div class="ep-lesson-row">
                                            <div class="d-flex align-items-center gap-2">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" class="flex-shrink-0">
                                                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                                                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                                                </svg>
                                                <div>
                                                    <strong class="text-dark small d-block">Module @m.ModuleNumber Knowledge Check Quiz</strong>
                                                    <span class="text-secondary" style="font-size: 0.72rem;">Passing Grade: 60% &bull; Instant Automatic Verification</span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (hasPassedModQuiz)
                                                {
                                                    var qAttempt = passedQuizzes.First(q => q.LessonNumber == m.ModuleNumber);
                                                    <span class="ep-badge-pill ep-pill-passed font-monospace">Passed (@qAttempt.ScorePercentage.ToString("0.0")%)</span>
                                                }
                                                else
                                                {
                                                    <span class="ep-badge-pill ep-pill-required">Quiz Required</span>
                                                }
                                                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = m.ModuleNumber })" 
                                                   class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;">
                                                    @(hasPassedModQuiz ? "Review Quiz" : "Take Quiz")
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Practical Assignment Row -->
                                        @if (!string.IsNullOrWhiteSpace(m.AssignmentPrompt))
                                        {
                                            <div class="ep-lesson-row">
                                                <div class="d-flex align-items-center gap-2">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" class="flex-shrink-0">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                        <polyline points="14 2 14 8 20 8"></polyline>
                                                    </svg>
                                                    <div>
                                                        <strong class="text-dark small d-block">Module @m.ModuleNumber Practical Assignment</strong>
                                                        <span class="text-secondary" style="font-size: 0.72rem;">Instructor-Graded Hands-on Engineering Deliverable</span>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (modSubmission != null)
                                                    {
                                                        if (modSubmission.IsApproved)
                                                        {
                                                            <span class="ep-badge-pill ep-pill-passed font-monospace">Approved (@modSubmission.MarksObtained / 100)</span>
                                                        }
                                                        else if (modSubmission.IsPending)
                                                        {
                                                            <span class="ep-badge-pill ep-pill-pending font-monospace">Pending Review</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="ep-badge-pill ep-pill-required font-monospace">Needs Revision</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="ep-badge-pill ep-pill-required">Not Submitted</span>
                                                    }
                                                    <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = m.ModuleNumber })" 
                                                       class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;">
                                                        @(modSubmission != null ? "View Submission" : "Submit Work")
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <!-- Assessments & Practical Tasks Hub -->
                    <section class="ep-card" aria-label="Assessments and Assignments">
                        <div class="ep-card-header">
                            <div>
                                <h3 class="ep-card-title">Assessments &amp; Practical Submissions</h3>
                                <div class="ep-card-sub">
                                    Track required module quizzes, code deliverables, and instructor grading dossiers
                                </div>
                            </div>
                            <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                @passedQuizzes.Count of @totalModules Quizzes Passed &bull; @approvedAssignmentsCount of @totalModules Tasks Approved
                            </span>
                        </div>

                        <!-- Quizzes Table / Card List -->
                        <div class="mb-4">
                            <h4 class="fw-bold text-dark small text-uppercase letter-spacing-1 mb-2" style="font-size: 0.75rem;">
                                Module Knowledge Checks
                            </h4>
                            <div class="row g-2">
                                @foreach (var m in modules)
                                {
                                    var qAttempt = passedQuizzes.FirstOrDefault(q => q.LessonNumber == m.ModuleNumber);
                                    bool passed = qAttempt != null;

                                    <div class="col-12 col-md-6">
                                        <div class="ep-task-card h-100 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <strong class="text-dark small">Module @m.ModuleNumber Quiz</strong>
                                                    @if (passed)
                                                    {
                                                        <span class="ep-badge-pill ep-pill-passed font-monospace">&#10003; Passed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ep-badge-pill ep-pill-required font-monospace">Pending</span>
                                                    }
                                                </div>
                                                <div class="text-secondary" style="font-size: 0.75rem;">
                                                    Curriculum topic: @m.Title
                                                </div>
                                                <div class="text-secondary small mt-1">
                                                    Score: <strong class="text-dark">@(passed ? qAttempt.ScorePercentage.ToString("0.0") + "%" : "Not Passed Yet")</strong> (Req: &ge; 60%)
                                                </div>
                                            </div>
                                            <div class="pt-2 mt-2 border-top d-flex justify-content-end">
                                                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = m.ModuleNumber })" 
                                                   class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                                    @(passed ? "Review Quiz" : "Take Quiz") &rarr;
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Practical Assignments List -->
                        <div>
                            <h4 class="fw-bold text-dark small text-uppercase letter-spacing-1 mb-2" style="font-size: 0.75rem;">
                                Hands-on Engineering Deliverables
                            </h4>
                            <div class="row g-2">
                                @foreach (var m in modules.Where(m => !string.IsNullOrWhiteSpace(m.AssignmentPrompt)))
                                {
                                    var sub = submissions.FirstOrDefault(s => s.ModuleNumber == m.ModuleNumber || s.ModuleId == m.ModuleId);
                                    bool hasSub = sub != null;

                                    <div class="col-12">
                                        <div class="ep-task-card">
                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                                <div>
                                                    <strong class="text-dark small">Module @m.ModuleNumber: @m.Title</strong>
                                                    <span class="text-secondary ms-2" style="font-size: 0.72rem;">Instructor-Graded</span>
                                                </div>
                                                <div>
                                                    @if (hasSub)
                                                    {
                                                        if (sub.IsApproved)
                                                        {
                                                            <span class="ep-badge-pill ep-pill-passed font-monospace">&#10003; Approved (Marks: @sub.MarksObtained / 100)</span>
                                                        }
                                                        else if (sub.IsPending)
                                                        {
                                                            <span class="ep-badge-pill ep-pill-pending font-monospace">&#9203; Pending Review</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="ep-badge-pill ep-pill-required font-monospace">Needs Revision</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="ep-badge-pill ep-pill-required font-monospace">Not Submitted</span>
                                                    }
                                                </div>
                                            </div>

                                            <div class="p-2 bg-light rounded-2 border text-secondary small mb-2" style="font-size: 0.78rem;">
                                                <strong class="text-dark">Task Prompt:</strong> @m.AssignmentPrompt
                                            </div>

                                            @if (hasSub && !string.IsNullOrWhiteSpace(sub.InstructorFeedback))
                                            {
                                                <div class="p-2 rounded-2 border mb-2 text-dark small" style="background: #f8fafc; font-size: 0.75rem;">
                                                    <strong class="text-primary"><i class="bi bi-chat-quote me-1"></i> Mentor Dossier Feedback:</strong> @sub.InstructorFeedback
                                                </div>
                                            }

                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top">
                                                <span class="text-secondary" style="font-size: 0.72rem;">
                                                    @(hasSub ? $"Submitted on {sub.SubmittedAt:MMM dd, yyyy HH:mm}" : "One-time submission permitted in Classroom Player")
                                                </span>
                                                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = m.ModuleNumber })" 
                                                   class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                                    @(hasSub ? "View in Classroom" : "Open Classroom to Submit") &rarr;
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <!-- Resources and Downloads Section -->
                    <section class="ep-card" aria-label="Course Resources and Downloads">
                        <div class="ep-card-header">
                            <div>
                                <h3 class="ep-card-title">Curriculum Reference Materials &amp; Cheatsheets (Protected View)</h3>
                                <div class="ep-card-sub">
                                    Official instructor lecture slides, architecture cheatsheets, and verified study guides. Offline saving and local downloading are disabled.
                                </div>
                            </div>
                            <div style="min-width: 220px;">
                                <input type="text" id="epResourceSearchInput" class="form-control form-control-sm rounded-2" placeholder="Search resources..." style="font-size: 0.78rem;">
                            </div>
                        </div>

                        <div id="epResourceListContainer">
                            @if (studyMaterials.Any())
                            {
                                foreach (var mat in studyMaterials)
                                {
                                    <div class="ep-resource-item" data-name="@mat.DisplayName.ToLower()">
                                        <div class="d-flex align-items-center gap-2 text-truncate">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" class="flex-shrink-0">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                            </svg>
                                            <div class="text-truncate">
                                                <strong class="text-dark small d-block text-truncate" title="@mat.DisplayName">@mat.DisplayName</strong>
                                                <span class="text-secondary" style="font-size: 0.72rem;">Verified Academic PDF &bull; @mat.FileSizeKb KB</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span class="badge bg-light text-secondary border px-2 py-1 font-monospace" style="font-size: 0.72rem;">
                                                <i class="bi bi-shield-lock-fill text-warning me-1"></i> Protected
                                            </span>
                                            @if (isEnrolled)
                                            {
                                                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId })" class="btn btn-sm btn-outline-primary rounded-2 px-3 py-1 font-monospace" style="font-size: 0.75rem;">
                                                    <i class="bi bi-eye-fill me-1"></i> Read in Classroom
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1 font-monospace" style="font-size: 0.72rem;">
                                                    <i class="bi bi-lock-fill me-1"></i> Enroll to View
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-4 text-center text-secondary small border rounded-3 bg-light">
                                    No supplementary files currently attached to this course.
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <!-- Right Section: Sticky Command Rail (Announcements, Copilot, Analytics, Certificate) -->
                <aside class="ep-command-rail">
                    <!-- Course Announcements Area -->
                    <div class="ep-rail-widget">
                        <div class="ep-rail-widget-title">
                            <span>Course Announcements</span>
                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-0 font-monospace" style="font-size: 0.68rem;">
                                @announcements.Count() Updates
                            </span>
                        </div>

                        <div class="ep-announcement-list">
                            @foreach (var ann in announcements)
                            {
                                <div class="ep-announcement-card">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="badge @ann.TagClass rounded-pill px-2 py-0" style="font-size: 0.65rem;">
                                            @ann.Tag
                                        </span>
                                        <span class="ep-announcement-meta">@ann.DateFormatted</span>
                                    </div>
                                    <div class="ep-announcement-title">@ann.Title</div>
                                    <div class="ep-announcement-msg">@ann.Message</div>
                                    <div class="ep-announcement-meta">
                                        <span>By @ann.AuthorName</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Contextual EduPulse AI Assistant Workspace Trigger -->
                    <div class="ep-rail-widget">
                        <div class="ep-rail-widget-title">
                            <span>Academic Copilot</span>
                            <span class="badge bg-dark text-white rounded-pill px-2 py-0 font-monospace" style="font-size: 0.65rem;">
                                Course Grounded
                            </span>
                        </div>
                        <p class="text-secondary small mb-3" style="font-size: 0.78rem; line-height: 1.45;">
                            Contextual Socratic study assistant indexed on verified slides, curriculum objectives, and lab guidelines.
                        </p>

                        <button type="button" class="ep-ai-pill-btn" onclick="openAiDrawerWithPrompt('Explain the core architectural concepts of Lesson @activeLessonNumber in @Model.Title with analogies.')">
                            <span>Ask About Lesson @activeLessonNumber</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>

                        <button type="button" class="ep-ai-pill-btn" onclick="openAiDrawerWithPrompt('What is the hardest conceptual pattern in @Model.Title and how does it work under the hood?')">
                            <span>Explain Complex Concepts</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>

                        <button type="button" class="ep-ai-pill-btn" onclick="openAiDrawerWithPrompt('Quiz me with 2 Socratic check questions on @Model.Title without revealing the answers.')">
                            <span>Socratic Knowledge Check</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>

                        <button type="button" class="ep-ai-pill-btn" onclick="openAiDrawerWithPrompt('Give me a real-world enterprise architecture project idea based on what is taught in @Model.Title.')">
                            <span>Implementation Project Advice</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>

                    <!-- Learning Analytics & Streak Motivational Card -->
                    <div class="ep-rail-widget">
                        <div class="ep-rail-widget-title">
                            <span>Learning Analytics &amp; Pace</span>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-0 font-monospace" style="font-size: 0.65rem;">
                                Active Pace
                            </span>
                        </div>

                        <div class="d-flex justify-content-between text-secondary small mb-1" style="font-size: 0.75rem;">
                            <span>Weekly Activity Target</span>
                            <strong class="text-dark">4 of 5 Days Met</strong>
                        </div>

                        <div class="ep-streak-week">
                            <div class="ep-streak-day-dot active"><span>M</span><span>&#10003;</span></div>
                            <div class="ep-streak-day-dot active"><span>T</span><span>&#10003;</span></div>
                            <div class="ep-streak-day-dot active"><span>W</span><span>&#10003;</span></div>
                            <div class="ep-streak-day-dot active"><span>T</span><span>&#10003;</span></div>
                            <div class="ep-streak-day-dot"><span>F</span><span>-</span></div>
                            <div class="ep-streak-day-dot"><span>S</span><span>-</span></div>
                            <div class="ep-streak-day-dot"><span>S</span><span>-</span></div>
                        </div>

                        <div class="p-2 rounded-2 bg-light border text-secondary small mt-3" style="font-size: 0.75rem;">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Estimated Completed Hours:</span>
                                <strong class="text-dark">@((completedModuleCount * 45) / 60) hrs</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Pacing Trajectory:</span>
                                <strong class="text-success">&#8593; On Track (High Engagement)</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Certificate Eligibility Checklist -->
                    <div class="ep-rail-widget">
                        <div class="ep-rail-widget-title">
                            <span>Certification Eligibility</span>
                            <span class="badge @(isCompleted ? "bg-success text-white" : "bg-light text-secondary border") rounded-pill px-2 py-0 font-monospace" style="font-size: 0.65rem;">
                                @(isCompleted ? "Ready" : "Pending")
                            </span>
                        </div>

                        <div class="ep-check-list mb-3">
                            <div class="ep-check-row">
                                <span class="ep-check-box done">&#10003;</span>
                                <div>
                                    <strong class="d-block text-dark">Course Enrollment</strong>
                                    <span class="text-secondary" style="font-size: 0.7rem;">Verified student profile</span>
                                </div>
                            </div>

                            <div class="ep-check-row">
                                <span class="ep-check-box @(completedModuleCount >= totalModules ? "done" : "pending")">
                                    @(completedModuleCount >= totalModules ? "&#10003;" : "")
                                </span>
                                <div>
                                    <strong class="d-block text-dark">Complete All @totalModules Lessons</strong>
                                    <span class="text-secondary" style="font-size: 0.7rem;">@completedModuleCount of @totalModules finished</span>
                                </div>
                            </div>

                            <div class="ep-check-row">
                                <span class="ep-check-box @(passedQuizzes.Count >= totalModules ? "done" : "pending")">
                                    @(passedQuizzes.Count >= totalModules ? "&#10003;" : "")
                                </span>
                                <div>
                                    <strong class="d-block text-dark">Pass Module Quizzes</strong>
                                    <span class="text-secondary" style="font-size: 0.7rem;">@passedQuizzes.Count of @totalModules (&ge; 60% mark)</span>
                                </div>
                            </div>

                            <div class="ep-check-row">
                                <span class="ep-check-box @(approvedAssignmentsCount > 0 ? "done" : "pending")">
                                    @(approvedAssignmentsCount > 0 ? "&#10003;" : "")
                                </span>
                                <div>
                                    <strong class="d-block text-dark">Practical Deliverables</strong>
                                    <span class="text-secondary" style="font-size: 0.7rem;">@approvedAssignmentsCount approved solutions</span>
                                </div>
                            </div>
                        </div>

                        @if (isCompleted)
                        {
                            <a href="@Url.Action("Certificate", "Courses", new { id = Model.CourseId })" class="ep-btn-accent w-100 justify-content-center shadow-xs" style="background: #059669; border-color: #059669;">
                                Access Verified Credential
                            </a>
                        }
                        else
                        {
                            <div class="text-secondary small text-center" style="font-size: 0.72rem;">
                                Complete remaining modules &amp; quizzes to unlock your verified credential.
                            </div>
                        }
                    </div>

                    <!-- Instructor Pedigree -->
                    <div class="ep-rail-widget">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" 
                                 style="width: 44px; height: 44px; font-size: 0.95rem;">
                                @instructorInitials
                            </div>
                            <div class="text-truncate">
                                <div class="fw-bold text-dark small text-truncate">@Model.InstructorName</div>
                                <div class="text-secondary" style="font-size: 0.725rem;">
                                    @(instructorProfile != null && !string.IsNullOrWhiteSpace(instructorProfile.Headline) ? instructorProfile.Headline : "Senior Technical Instructor")
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </main>
    }
    else
    {
        <!-- =========================================================================
             PRE-ENROLLMENT DISCOVERY & EVALUATION PAGE
             (For Prospective Learners / Unauthenticated Visitors / Instructor Preview)
             ========================================================================= -->

        <header class="ep-disc-hero">
            <div class="container-xl">
                <div class="ep-disc-grid">
                    <!-- Left Hero Content -->
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-light text-dark border px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                @Model.Category
                            </span>
                            <span class="badge bg-light text-dark border px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                Level: @Model.Level
                            </span>
                            @if (isOwner)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                                    Author Preview
                                </span>
                            }
                        </div>

                        <h1 class="ep-ws-hero-title" style="font-size: 2.25rem;">@Model.Title</h1>
                        <p class="ep-ws-hero-subtitle" style="font-size: 1.05rem;">
                            @Model.Description
                        </p>

                        <!-- Social Proof & Instructor Meta -->
                        <div class="d-flex align-items-center gap-4 flex-wrap text-secondary small py-2 mb-4 border-top border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    @instructorInitials
                                </div>
                                <div>
                                    <span class="d-block text-secondary" style="font-size: 0.7rem;">Instructor</span>
                                    <strong class="text-dark">@Model.InstructorName</strong>
                                </div>
                            </div>

                            <div>
                                <span class="d-block text-secondary" style="font-size: 0.7rem;">Curriculum Duration</span>
                                <strong class="text-dark">@Model.DurationWeeks Weeks &bull; @totalDurationMinutes Mins</strong>
                            </div>

                            <div>
                                <span class="d-block text-secondary" style="font-size: 0.7rem;">Evaluation Rating</span>
                                <strong class="text-dark">&#9733; @avgRating.ToString("0.0") (@reviewCount reviews)</strong>
                            </div>

                            <div>
                                <span class="d-block text-secondary" style="font-size: 0.7rem;">Active Cohort</span>
                                <strong class="text-dark">@Model.TotalEnrolled Learners Enrolled</strong>
                            </div>
                        </div>

                        <!-- What You Will Master -->
                        <div class="ep-card mb-4">
                            <h3 class="ep-card-title mb-2">What You Will Master</h3>
                            <p class="ep-card-sub mb-3">Core competencies, production architectural patterns, and practical execution.</p>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="text-success fw-bold">&#10003;</span>
                                        <div class="small text-secondary">
                                            <strong class="text-dark d-block">Production Architecture</strong>
                                            Build resilient, scalable solutions following enterprise separation of concerns.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="text-success fw-bold">&#10003;</span>
                                        <div class="small text-secondary">
                                            <strong class="text-dark d-block">Automated Assessments</strong>
                                            Validate conceptual mastery through module quizzes and practical code reviews.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="text-success fw-bold">&#10003;</span>
                                        <div class="small text-secondary">
                                            <strong class="text-dark d-block">Hands-on Deliverables</strong>
                                            Complete real-world repository submissions graded by experienced mentors.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="text-success fw-bold">&#10003;</span>
                                        <div class="small text-secondary">
                                            <strong class="text-dark d-block">Verified Certification</strong>
                                            Earn an official tamper-proof credential shareable on LinkedIn and portfolios.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Syllabus Preview -->
                        <div class="ep-card mb-4">
                            <div class="ep-card-header">
                                <div>
                                    <h3 class="ep-card-title">Curriculum Syllabus Overview</h3>
                                    <div class="ep-card-sub">@totalModules Structured Modules</div>
                                </div>
                            </div>

                            @foreach (var m in modules)
                            {
                                <div class="p-3 bg-light rounded-2 border mb-2 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge bg-white text-dark border font-monospace">Module @m.ModuleNumber</span>
                                        <div>
                                            <strong class="text-dark small d-block">@m.Title</strong>
                                            <span class="text-secondary" style="font-size: 0.72rem;">@m.FormattedDuration</span>
                                        </div>
                                    </div>
                                    <span class="text-secondary small font-monospace">Included</span>
                                </div>
                            }
                        </div>

                        <!-- Student Reviews -->
                        <div class="ep-card mb-4">
                            <div class="ep-card-header">
                                <div>
                                    <h3 class="ep-card-title">Verified Student Reviews</h3>
                                    <div class="ep-card-sub">&#9733; @avgRating.ToString("0.0") out of 5 &bull; Based on @reviewCount evaluations</div>
                                </div>
                            </div>

                            @if (reviews.Any())
                            {
                                foreach (var r in reviews)
                                {
                                    <div class="p-3 border-bottom">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <strong class="text-dark small">@r.StudentName</strong>
                                            <span class="text-warning small">&#9733;&#9733;&#9733;&#9733;&#9733; (@r.Rating / 5)</span>
                                        </div>
                                        <p class="text-secondary small mb-1">@r.Comment</p>
                                        <span class="text-secondary" style="font-size: 0.7rem;">@r.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-secondary small mb-0">No reviews submitted yet for this curriculum.</p>
                            }
                        </div>
                    </div>

                    <!-- Right Sticky Enrollment Card -->
                    <aside>
                        <div class="ep-sticky-enroll-card">
                            <div class="d-flex align-items-baseline justify-content-between mb-3">
                                <div>
                                    <div class="text-secondary small">Course Tuition</div>
                                    <div class="fs-2 fw-bold text-dark">
                                        @(Model.Price > 0 ? "$" + Model.Price.ToString("0.00") : "Free")
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 font-monospace" style="font-size: 0.72rem;">
                                    Lifetime Access
                                </span>
                            </div>

                            @if (ViewBag.IsDraftUnavailable == true)
                            {
                                <div class="alert alert-warning py-3 px-3 rounded-3 mb-3 text-center border-warning-subtle" style="background: #fffbeb;">
                                    <div class="fw-bold mb-1 text-dark"><i class="bi bi-cone-striped me-1 text-warning"></i> Course Under Development</div>
                                    <div class="small text-secondary mb-2">This course is currently in draft mode while curriculum is being created. It is not open for enrollment.</div>
                                </div>
                                <a href="@Url.Action("Index", "Courses")" class="ep-btn-secondary w-100 justify-content-center">
                                    Browse Active Courses
                                </a>
                            }
                            else if (isOwner)
                            {
                                if (ViewBag.IsDraftPreview == true)
                                {
                                    <div class="alert alert-warning py-2 px-3 small rounded-2 mb-3 border-warning-subtle" style="background: #fffbeb;">
                                        <strong>Draft Mode:</strong> You are previewing as the author. Students cannot enroll until you publish this course.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info py-2 px-3 small rounded-2 mb-3">
                                        You are the author of this course. You can preview lectures and manage curriculum in Instructor Studio.
                                    </div>
                                }
                                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId, lesson = 1 })" class="ep-btn-primary w-100 justify-content-center mb-2">
                                    Preview Classroom Player
                                </a>
                                <a href="@Url.Action("Modules", "Instructor", new { id = Model.CourseId })" class="ep-btn-secondary w-100 justify-content-center">
                                    Edit Course Modules
                                </a>
                            }
                            else
                            {
                                <form action="@Url.Action("Enroll", "Courses", new { id = Model.CourseId })" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ep-btn-accent w-100 justify-content-center py-3 mb-3 shadow-sm" style="font-size: 1rem;">
                                        Enroll Now &bull; Start Learning
                                    </button>
                                </form>

                                <div class="text-secondary small text-center mb-3" style="font-size: 0.75rem;">
                                    30-Day Money-Back Guarantee &bull; Instant Syllabus Access
                                </div>

