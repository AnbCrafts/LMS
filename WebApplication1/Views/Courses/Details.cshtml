<!-- Embedded Interactive Scripts for Learning Workspace -->
<script>
    function toggleModuleAccordion(header) {
        var body = header.nextElementSibling;
        var accordion = header.closest('.ep-module-accordion');
        var chevron = header.querySelector('.ep-chevron-icon');

        if (body.classList.contains('open')) {
            body.classList.remove('open');
            accordion.classList.remove('active');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
        } else {
            body.classList.add('open');
            accordion.classList.add('active');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var expandAllBtn = document.getElementById('epExpandAllBtn');
        if (expandAllBtn) {
            var expanded = false;
            expandAllBtn.addEventListener('click', function () {
                expanded = !expanded;
                var bodies = document.querySelectorAll('.ep-module-body');
                var chevrons = document.querySelectorAll('.ep-chevron-icon');
                bodies.forEach(function (b) {
                    if (expanded) b.classList.add('open');
                    else b.classList.remove('open');
                });
                chevrons.forEach(function (c) {
                    c.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
                });
                expandAllBtn.textContent = expanded ? 'Collapse All' : 'Expand All';
            });
        }

        // Live filter for resources
        var searchInput = document.getElementById('epResourceSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var query = (searchInput.value || '').trim().toLowerCase();
                var items = document.querySelectorAll('.ep-resource-item');
                items.forEach(function (item) {
                    var name = item.getAttribute('data-name') || '';
                    if (!query || name.indexOf(query) !== -1) {
                        item.style.display = 'flex';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        }
    });
</script>
