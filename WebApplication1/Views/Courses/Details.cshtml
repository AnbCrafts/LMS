@model WebApplication1.Models.Course

@{
    ViewBag.Title = Model.Title;
    bool isEnrolled = ViewBag.IsEnrolled != null && (bool)ViewBag.IsEnrolled;
    bool isOwner = ViewBag.IsOwner != null && (bool)ViewBag.IsOwner;
    var reviews = ViewBag.Reviews as IEnumerable<WebApplication1.Models.Review> ?? new List<WebApplication1.Models.Review>();

    string badgeClass = "badge-beginner";
    if (Model.Level == "Intermediate") { badgeClass = "badge-intermediate"; }
    else if (Model.Level == "Advanced") { badgeClass = "badge-advanced"; }

    string catBadgeClass = "bg-secondary";
    if (Model.Category == "Frontend") { catBadgeClass = "bg-primary"; }
    else if (Model.Category == "Backend") { catBadgeClass = "bg-success"; }
    else if (Model.Category == "Fullstack") { catBadgeClass = "bg-info text-dark"; }
    else if (Model.Category == "DevOps") { catBadgeClass = "bg-warning text-dark"; }

    double avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 5.0;
}

<!-- Back Link -->
<a href="@Url.Action("Index", "Courses")" class="lms-back-btn">
    <i class="bi bi-arrow-left"></i> Back to Courses
</a>

<div class="row g-4">
    <!-- Left Column: Course Overview, Highlights, Syllabus & Reviews -->
    <div class="col-12 col-lg-8">
        <div class="lms-detail-hero">
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                <span class="@badgeClass">@Model.Level</span>
                <span class="badge @catBadgeClass px-3 py-1 rounded-pill small fw-bold">@Model.Category</span>
                <span class="text-muted small">
                    <i class="bi bi-clock"></i> @Model.DurationWeeks Weeks Duration
                </span>
                <span class="text-warning small fw-bold">
                    <i class="bi bi-star-fill"></i> @avgRating.ToString("0.0") (@reviews.Count() reviews)
                </span>
            </div>

            <h1 class="lms-detail-heading">@Model.Title</h1>
            <p class="text-muted fs-5 mb-4">@Model.Description</p>

            <!-- Instructor Bio Banner -->
            <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                <div class="lms-instructor-avatar" style="width: 46px; height: 46px; font-size: 1.1rem; background: #e0e7ff; color: #4338ca;">
                    @(string.IsNullOrWhiteSpace(Model.InstructorName) ? "I" : Model.InstructorName.Substring(0, 1))
                </div>
                <div>
                    <div class="fw-bold text-dark">Taught by @Model.InstructorName</div>
                    <div class="text-muted small">Senior Industry Specialist & Verified Mentor</div>
                </div>
            </div>

            <!-- What you will learn Highlight Box -->
            <div class="lms-highlight-box">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-check2-circle text-primary"></i> What You Will Master
                </h5>
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="lms-checklist-item">
                            <i class="bi bi-check-circle-fill lms-check-icon"></i>
                            <span>Production-grade architecture patterns</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="lms-checklist-item">
                            <i class="bi bi-check-circle-fill lms-check-icon"></i>
                            <span>End-of-lesson mini quizzes to evaluate skills</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="lms-checklist-item">
                            <i class="bi bi-check-circle-fill lms-check-icon"></i>
                            <span>Real-world hands-on project implementations</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="lms-checklist-item">
                            <i class="bi bi-check-circle-fill lms-check-icon"></i>
                            <span>Official Certificate of Completion at 100%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course Modules Accordion Preview -->
            <h5 class="fw-bold text-dark mt-4 mb-3">Curriculum Syllabus Overview (5 Lessons)</h5>
            <div class="accordion mb-5" id="curriculumAccordion">
                <div class="accordion-item border-0 mb-2 shadow-sm rounded-3 overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#module1">
                            <i class="bi bi-journal-code text-primary me-2"></i> Lesson 1: Foundations & Architecture Setup
                        </button>
                    </h2>
                    <div id="module1" class="accordion-collapse collapse show">
                        <div class="accordion-body text-muted small">
                            Setup development environment, project structuring, state architecture, and core foundational building blocks + End-of-Lesson Mini Quiz.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 mb-2 shadow-sm rounded-3 overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#module2">
                            <i class="bi bi-gear-wide-connected text-primary me-2"></i> Lesson 2: Core Components & Hierarchies
                        </button>
                    </h2>
                    <div id="module2" class="accordion-collapse collapse">
                        <div class="accordion-body text-muted small">
                            Hands-on component hierarchies, props, data flows, clean structuring, and quiz validation.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 mb-2 shadow-sm rounded-3 overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#module3">
                            <i class="bi bi-lightning text-primary me-2"></i> Lesson 3: Advanced State & Async Data Flows
                        </button>
                    </h2>
                    <div id="module3" class="accordion-collapse collapse">
                        <div class="accordion-body text-muted small">
                            Handling asynchronous requests, global state, REST endpoints, and caching with quiz assessment.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 mb-2 shadow-sm rounded-3 overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#module4">
                            <i class="bi bi-shield-check text-primary me-2"></i> Lesson 4: Performance & Automated Testing
                        </button>
                    </h2>
                    <div id="module4" class="accordion-collapse collapse">
                        <div class="accordion-body text-muted small">
                            Profiler insights, unit testing components, and minimizing renders.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 mb-2 shadow-sm rounded-3 overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#module5">
                            <i class="bi bi-award-fill text-warning me-2"></i> Lesson 5: Capstone Project & Certificate Unlock
                        </button>
                    </h2>
                    <div id="module5" class="accordion-collapse collapse">
                        <div class="accordion-body text-muted small">
                            Building and deploying a full real-world capstone application, culminating in the 100% verified certificate.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Student Reviews & Ratings Section -->
            <div class="card border-0 shadow-sm p-4 rounded-4" style="border: 1px solid #e2e8f0 !important;">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h4 class="fw-bold text-dark m-0">Student Reviews & Ratings</h4>
                        <div class="text-muted small">Real feedback from verified learners</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="text-warning fs-4 fw-bold">
                            <i class="bi bi-star-fill"></i> @avgRating.ToString("0.0")
                        </div>
                        <span class="text-muted small">(@reviews.Count() total reviews)</span>
                    </div>
                </div>

                <!-- Add Review Form (If user is enrolled and NOT the author) -->
                @if (isEnrolled && !isOwner)
                {
                    <div class="p-3 rounded-3 bg-light border mb-4">
                        <h6 class="fw-bold text-dark mb-2">Leave a Course Review</h6>
                        @using (Html.BeginForm("AddReview", "Courses", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.CourseId" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Your Rating</label>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="rating" id="r5" value="5" checked />
                                        <label class="form-check-label text-warning small fw-bold" for="r5">
                                            &#9733;&#9733;&#9733;&#9733;&#9733; 5 Stars
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="rating" id="r4" value="4" />
                                        <label class="form-check-label text-warning small" for="r4">
                                            &#9733;&#9733;&#9733;&#9733; 4 Stars
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="rating" id="r3" value="3" />
                                        <label class="form-check-label text-warning small" for="r3">
                                            &#9733;&#9733;&#9733; 3 Stars
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Your Feedback / Review Comments</label>
                                <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience with the curriculum, exercises, and instructor..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill px-4 btn-sm fw-bold">
                                <i class="bi bi-chat-heart-fill me-1"></i> Submit Review
                            </button>
                        }
                    </div>
                }

                <!-- Reviews Feed List -->
                @if (reviews != null && reviews.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rev in reviews)
                        {
                            string initials = "S";
                            string displayName = !string.IsNullOrWhiteSpace(rev.ReviewerName) ? rev.ReviewerName : rev.StudentName;
                            if (!string.IsNullOrWhiteSpace(displayName))
                            {
                                var parts = displayName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                initials = parts.Length >= 2 
                                    ? $"{parts[0][0]}{parts[1][0]}" 
                                    : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                            }

                            <div class="p-3 rounded-3 border bg-white shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="lms-user-avatar" style="width: 34px; height: 34px; font-size: 0.8rem; background: #e0e7ff; color: #4338ca;">
                                            @initials
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">@displayName</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@rev.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </div>
                                    </div>
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= rev.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                <p class="text-muted small mb-0">@rev.Comment</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-square-dots fs-3 d-block mb-1"></i>
                        <span>No reviews yet. Be the first enrolled student to review this course!</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Sticky Enrollment & Checkout Box -->
    <div class="col-12 col-lg-4">
        <div class="lms-sticky-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge @catBadgeClass px-3 py-2 rounded-pill fw-bold">
                    @Model.Category
                </span>
                <span class="text-success fw-bold small">
                    <i class="bi bi-shield-check"></i> Verified Course
                </span>
            </div>

            <!-- Price Display -->
            <div class="lms-sticky-price">
                @(Model.Price > 0 ? "$" + Model.Price.ToString("0.00") : "Free")
            </div>
            <div class="text-muted small mb-3">
                <i class="bi bi-credit-card-2-front"></i> One-time simulated payment & instant access
            </div>

            <div class="mb-4">
                <div class="lms-spec-row">
                    <span class="lms-spec-label"><i class="bi bi-bar-chart"></i> Level</span>
                    <span class="lms-spec-val">@Model.Level</span>
                </div>
                <div class="lms-spec-row">
                    <span class="lms-spec-label"><i class="bi bi-hourglass-split"></i> Duration</span>
                    <span class="lms-spec-val">@Model.DurationWeeks Weeks</span>
                </div>
                <div class="lms-spec-row">
                    <span class="lms-spec-label"><i class="bi bi-question-circle"></i> Lesson Quizzes</span>
                    <span class="lms-spec-val text-primary">Included</span>
                </div>
                <div class="lms-spec-row">
                    <span class="lms-spec-label"><i class="bi bi-patch-check"></i> Certificate</span>
                    <span class="lms-spec-val text-success">At 100% Completion</span>
                </div>
                <div class="lms-spec-row">
                    <span class="lms-spec-label"><i class="bi bi-receipt"></i> Invoice Receipt</span>
                    <span class="lms-spec-val">PDF Printable</span>
                </div>
            </div>

            @if (isOwner)
            {
                <div class="alert alert-primary rounded-3 border-0 d-flex align-items-center gap-2 mb-3" style="background: #e0e7ff; color: #3730a3;">
                    <i class="bi bi-person-workspace fs-3"></i>
                    <div>
                        <strong class="d-block">Your Course (Author Mode)</strong>
                        <span class="small">You uploaded and manage this curriculum.</span>
                    </div>
                </div>

                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId })" class="lms-cta-btn w-100 justify-content-center py-3 mb-2">
                    <i class="bi bi-play-circle-fill"></i> Preview Classroom Player
                </a>
                <a href="@Url.Action("ManageQuiz", "Instructor", new { id = Model.CourseId })" class="btn btn-outline-info w-100 rounded-pill py-2 mb-2 fw-semibold">
                    <i class="bi bi-patch-question-fill"></i> Manage Lesson Quizzes
                </a>
                <a href="@Url.Action("Edit", "Instructor", new { id = Model.CourseId })" class="btn btn-outline-primary w-100 rounded-pill py-2 mb-2 fw-semibold">
                    <i class="bi bi-pencil-square"></i> Edit Course Content
                </a>
                <a href="@Url.Action("Index", "Instructor")" class="btn btn-outline-secondary w-100 rounded-pill py-2 small">
                    <i class="bi bi-speedometer2"></i> Back to Studio
                </a>
            }
            else if (!isEnrolled)
            {
                <a href="@Url.Action("Checkout", "Payment", new { id = Model.CourseId })" class="lms-cta-btn w-100 justify-content-center py-3 fs-6 mb-2">
                    <i class="bi bi-bag-check-fill"></i> Enroll & Checkout Now
                </a>
                <div class="text-center text-muted" style="font-size: 0.75rem;">
                    Instant enrollment with generated PDF invoice receipt.
                </div>
            }
            else
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div><strong>You're Enrolled!</strong> Continue your learning path.</div>
                </div>
                <a href="@Url.Action("Learn", "Courses", new { id = Model.CourseId })" class="lms-cta-btn w-100 justify-content-center py-3 mb-2">
                    <i class="bi bi-play-circle-fill"></i> Go to Classroom
                </a>
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary w-100 rounded-pill py-2 small">
                    <i class="bi bi-speedometer2"></i> Open Dashboard
                </a>
            }
        </div>
    </div>
</div>
