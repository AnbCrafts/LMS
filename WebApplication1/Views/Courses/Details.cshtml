@model WebApplication1.Models.Course

@{
    bool isEnrolled = ViewBag.IsEnrolled != null && (bool)ViewBag.IsEnrolled;
    bool isOwner = ViewBag.IsOwner != null && (bool)ViewBag.IsOwner;
    ViewBag.Title = Model.Title + (isEnrolled && !isOwner ? " - Learning Workspace" : " - Course Overview");

    var enrollment = ViewBag.Enrollment as WebApplication1.Models.EnrollmentStatusResult;
    var reviews = ViewBag.Reviews as IEnumerable<WebApplication1.Models.Review> ?? new List<WebApplication1.Models.Review>();
    var modules = ViewBag.Modules as IEnumerable<WebApplication1.Models.CourseModule> ?? new List<WebApplication1.Models.CourseModule>();
    var studyMaterials = ViewBag.StudyMaterials as IEnumerable<WebApplication1.Models.StudyMaterialItem> ?? new List<WebApplication1.Models.StudyMaterialItem>();
    var relatedCourses = ViewBag.RelatedCourses as IEnumerable<WebApplication1.Models.Course> ?? new List<WebApplication1.Models.Course>();
    var instructorProfile = ViewBag.InstructorProfile as WebApplication1.Models.InstructorProfile;
    var gradeSummary = ViewBag.GradeSummary as WebApplication1.Models.CourseGradeSummary;
    var quizAttempts = ViewBag.StudentQuizAttempts as IEnumerable<WebApplication1.Models.StudentQuizAttempt> ?? new List<WebApplication1.Models.StudentQuizAttempt>();
    var submissions = ViewBag.StudentSubmissions as IEnumerable<WebApplication1.Models.StudentSubmission> ?? new List<WebApplication1.Models.StudentSubmission>();
    var allQuestions = ViewBag.AllQuizQuestions as IEnumerable<WebApplication1.Models.QuizQuestion> ?? new List<WebApplication1.Models.QuizQuestion>();
    var announcements = ViewBag.Announcements as IEnumerable<WebApplication1.Models.CourseAnnouncementItem> ?? new List<WebApplication1.Models.CourseAnnouncementItem>();

    int progressPct = enrollment != null ? enrollment.ProgressPercentage : 0;
    bool isCompleted = enrollment != null && progressPct >= 100;
    int totalModules = modules.Count();
    int totalDurationMinutes = modules.Sum(m => m.DurationMinutes);

    // Dynamic Learning Calculations
    int completedModuleCount = totalModules > 0 ? (isCompleted ? totalModules : Math.Min(totalModules, (int)Math.Floor((double)progressPct / (100.0 / totalModules)))) : 0;
    int activeLessonNumber = isCompleted ? 1 : Math.Min(totalModules, completedModuleCount + 1);
    var activeModule = modules.FirstOrDefault(m => m.ModuleNumber == activeLessonNumber) ?? modules.FirstOrDefault();
    int remainingMinutes = modules.Where(m => m.ModuleNumber >= activeLessonNumber).Sum(m => m.DurationMinutes);
    string remainingFormatted = isCompleted ? "Curriculum Finished" : (remainingMinutes > 60 ? $"{(remainingMinutes / 60)}h {(remainingMinutes % 60)}m remaining" : $"{remainingMinutes} mins remaining");

    var passedQuizzes = quizAttempts.Where(q => q.IsPassed).ToList();
    int submittedAssignmentsCount = submissions.Count();
    int approvedAssignmentsCount = submissions.Count(s => s.IsApproved);
    int pendingAssignmentsCount = submissions.Count(s => s.IsPending);

    double avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 4.9;
    int reviewCount = reviews.Count();

    // Instructor monogram initials
    string instructorInitials = "IN";
    if (!string.IsNullOrWhiteSpace(Model.InstructorName))
    {
        var parts = Model.InstructorName.Split(new[] { ' ', '.' }, StringSplitOptions.RemoveEmptyEntries);
        instructorInitials = parts.Length >= 2 
            ? $"{parts[0][0]}{parts[1][0]}" 
            : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
    }
}

<!-- Unified Resilient Stylesheet for EduPulse Course Experience -->
<style>
    /* ==========================================================================
       EduPulse Learning Workspace & Discovery Architecture
       Strictly adhering to zero AI tropes, zero promotional banners for enrolled users.
       ========================================================================== */

