# ==============================================================================
# EduPulse LMS - Environment Configuration Template (.env.example)
# Rename this file to '.env' and fill in your values.
# ==============================================================================

# Redis Distributed Cache
REDIS_CONNECTION_STRING=localhost:6379,abortConnect=false

# Python AI & RAG Microservice URL
AI_MICROSERVICE_URL=http://127.0.0.1:8000/

# Relational Database Connection (SQL Server)
SQL_CONNECTION_STRING=Data Source=.;Initial Catalog=Practice;Integrated Security=True;TrustServerCertificate=True;

# Google Gemini AI Model Credentials
GEMINI_API_KEY=your_gemini_api_key_here
CHAT_MODEL=models/gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
CHROMA_DB_DIR=./chroma_data

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
